{
  "name": "gotcha-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "GOTCHA native mobile shell (Capacitor). Loads the web app remotely; bundles nothing of it.",
  "scripts": {
    "sync": "cap sync",
    "sync:dev": "GOTCHA_ENV=dev cap sync",
    "sync:prod": "GOTCHA_ENV=prod cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  }
}
