*.tsbuildinfo
next-env.d.ts

# Environment
.env
.env.local
.env.*.local

# Test output
coverage
playwright-report
test-results

# Sentry
.sentryclirc

# Local agent tooling state
.omc/

# The design export. The source of truth for every screen, but it is a large
# generated artefact from the Claude Design project rather than app code, and
# it is re-exported whole each time. Kept out of the history; kept on disk so
# it survives between sessions.
design/
