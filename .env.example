
# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/whatsapp_cc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_cc

# Services
NODE_ENV=development

# ─── Authentication (Authentik) ─────────────────────────────
# GOTCHA does not issue or verify its own tokens. Authentik is the sole
# identity provider; services verify its tokens against the JWKS below.
#
# Local dev: `docker compose up -d authentik-server authentik-worker` then
# `node scripts/authentik/bootstrap.mjs` prints these values.
# Production: point at https://auth.gotcha.co.il.

# Backend token verification (every service).
#
# NOTE the deliberate split between these two - they are NOT the same host:
#   OIDC_ISSUER   must EXACTLY match the `iss` claim inside the token, which is
#                 whatever public URL the browser used to log in. It is compared
#                 as a string; it is never fetched.
#   OIDC_JWKS_URI must be reachable FROM INSIDE the container, so it uses Docker
#                 service DNS. Pointing it at localhost:9000 makes a service
#                 resolve localhost to ITSELF, the fetch is refused, and every
#                 valid token gets rejected as "Invalid or expired token".
#
# The split does NOT disappear in production - it stays, for the same reason:
#   OIDC_ISSUER=https://auth.gotcha.co.il/application/o/gotcha/        (public)
#   OIDC_JWKS_URI=http://authentik-server:9000/application/o/gotcha/jwks/ (internal)
# JWKS is fetched, never compared, so internal DNS is strictly better there: it
# needs no egress, survives a Cloudflare incident, and skips a hairpin out to
# the internet and back on every key rotation. Only the ISSUER must be public.
OIDC_ISSUER=http://localhost:9000/application/o/gotcha/
OIDC_JWKS_URI=http://authentik-server:9000/application/o/gotcha/jwks/

# Browser-side OIDC (must be the PUBLIC url, not internal service DNS)
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:9000/application/o/gotcha/
NEXT_PUBLIC_OIDC_CLIENT_ID=gotcha-app
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Signing secret for third-party OAuth `state` (CSRF protection on CRM /
# calendar / channel OAuth round-trips). NOT user authentication - that is
# Authentik's. Required in production; dev generates a random per-process value.
OAUTH_STATE_SECRET=generate-with-openssl-rand-hex-32

# Authentik admin API - used ONLY by the auth service to provision invited
# identities. Treat as a high-value secret: it can create identities.
AUTHENTIK_URL=http://authentik-server:9000
AUTHENTIK_API_TOKEN=

# Authentik's own deployment config
AUTHENTIK_SECRET_KEY=generate-with-openssl-rand-hex-32
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@gotcha.co.il
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASS=authentik
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PORT=9000

# ─── PRODUCTION values (reference - do NOT use this file in prod) ──────────
# docker-compose.prod.yml hard-fails at boot on any of these being unset, by
# design: a missing auth secret must stop a deploy, never silently weaken it.
#
#   OIDC_ISSUER=https://auth.gotcha.co.il/application/o/gotcha/
#   OIDC_JWKS_URI=http://authentik-server:9000/application/o/gotcha/jwks/
#   NEXT_PUBLIC_OIDC_ISSUER=https://auth.gotcha.co.il/application/o/gotcha/
#   NEXT_PUBLIC_OIDC_REDIRECT_URI=https://app.gotcha.co.il/auth/callback
#   AUTHENTIK_SECRET_KEY=<openssl rand -hex 32>
#   AUTHENTIK_PG_PASS=<openssl rand -hex 32>       # NOT "authentik"
#   AUTHENTIK_API_TOKEN=<dedicated non-bootstrap token created in the UI>
#   OAUTH_STATE_SECRET=<openssl rand -hex 32>
#   AUTHENTIK_COOKIE_DOMAIN=gotcha.co.il
#
# NEXT_PUBLIC_* are FROZEN into the static bundle at gateway build time
# (scripts/docker-publish.sh), not read at runtime. Changing the issuer or the
# redirect URI means rebuilding and pushing a new gateway image - setting them
# on the host does nothing.
#
# The redirect URI must ALSO be registered in Authentik's provider allow-list
# (scripts/authentik/bootstrap.mjs takes AUTHENTIK_REDIRECT_URIS); it is the
# open-redirect gate, so an unregistered URI is rejected at login.
#
# JWT_SECRET / JWT_EXPIRES_IN / REFRESH_TOKEN_DAYS are GONE. GOTCHA cannot mint
# tokens any more. Delete them from every deployment environment - a leftover
# JWT_SECRET is dead config that implies a signing path that no longer exists.
AUTH_PORT=4001
CONVERSATION_PORT=4002
WEBHOOK_PORT=4003
ANALYTICS_PORT=4004
CHATBOT_PORT=4005
AI_PORT=4006
VOICE_COPILOT_PORT=4007

# Internal Service-to-Service Authentication
# CONVERSATION_SERVICE_URL: base URL the AI service uses when dispatching
#   action-planner tools (create_broadcast, resolve_identity, merge_contacts,
#   schedule_broadcast, preview_broadcast) to the conversation service.
# INTERNAL_SERVICE_TOKEN: Bearer token the AI action-executor sends when no
#   end-user JWT is available (e.g. cron-initiated flows). Must be accepted
#   by the conversation service's authenticate middleware.
# INTERNAL_SERVICE_KEY: shared secret used by incoming-worker → AI service
#   calls (X-Internal-Key header; checked in services/ai/src/routes/ai-assist.ts).
# IMPORTANT: authenticate() accepts EITHER of these as the Bearer secret, but a
#   receiver only knows the value(s) in ITS OWN env. Keep BOTH set to the SAME
#   value so every sender/receiver pair matches - a mismatch surfaces as a
#   misleading "Invalid or expired token" 401 (our auth gate, not a JWT issue).
CONVERSATION_SERVICE_URL=http://conversation:4002
INTERNAL_SERVICE_TOKEN=chatcenter-internal-2026
INTERNAL_SERVICE_KEY=chatcenter-internal-2026

# Meta Platform - Channel Connection (OAuth + Embedded Signup)
META_APP_ID=your-facebook-app-id
META_APP_SECRET=your-meta-app-secret
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id
OAUTH_REDIRECT_URI=https://yourdomain.com/api/channels/oauth/callback
CHANNEL_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# ─── BFF app-session infrastructure (docs/security/bff-session-migration-map.md) ───
# ADDITIVE + INERT until the cookie feature flags below are turned on. With all
# flags unset, authentication behaves exactly as today (browser Bearer tokens).
#
# Dedicated session-token encryption key (NEVER reuse CHANNEL_ENCRYPTION_KEY).
# Must be 64 hex chars (32 bytes): openssl rand -hex 32. Production boot fails if
# it is missing/malformed/weak once a cookie flag is enabled.
SESSION_ENCRYPTION_KEY=generate-a-DIFFERENT-key-with-openssl-rand-hex-32
SESSION_ENCRYPTION_KEY_ID=k1
# Optional decrypt-only old keys for rotation: "oldId:hex,olderId:hex"
# SESSION_DECRYPTION_KEYS=
# Exact application origin (no wildcard). Production boot fails if absent/invalid.
APP_ORIGIN=https://dev.gotcha.co.il
# Additional exact allowed origins (CSRF Origin allow-list), comma-separated.
AUTH_ALLOWED_ORIGINS=https://dev.gotcha.co.il,http://localhost:3000
# Cookie contract is keyed on SECURE (HTTPS), not NODE_ENV: every HTTPS
# deployment - production AND dev.gotcha.co.il - uses the host-only
# __Host-gotcha_session (Secure/HttpOnly/Lax/Path=/, no Domain). Secure is the
# DEFAULT; set SESSION_COOKIE_SECURE=false ONLY for localhost HTTP dev, which
# then uses the distinct non-__Host- gotcha_session_dev cookie. Production can
# never opt out. The login callback is a BACKEND route: <APP_ORIGIN>/api/auth/
# callback (register it in Authentik's redirect allow-list).
# SESSION_COOKIE_NAME=
# SESSION_COOKIE_SECURE=false      # localhost HTTP only
# OIDC_SERVER_REDIRECT_URI=        # override the derived <APP_ORIGIN>/api/auth/callback
# Remember-me durations (seconds). Defaults: 12h / 30d.
# SESSION_IDLE_TTL_SECONDS=43200
# SESSION_REMEMBER_TTL_SECONDS=2592000
# Rollout flags (all default OFF/legacy => zero behavior change):
# SESSION_COOKIE_CREATE=false
# SESSION_COOKIE_ACCEPT=false
# LEGACY_BEARER_ACCEPT=true
# BROWSER_TOKEN_ISSUE=true
# COOKIE_ONLY_ENFORCE=false

WHATSAPP_API_URL=https://graph.facebook.com/v21.0
FACEBOOK_API_URL=https://graph.facebook.com/v21.0

# Instagram API with Instagram Login (direct IG Business connect - no Facebook Page)
# Meta App Dashboard → "Instagram API setup with Instagram login" (distinct from META_APP_*)
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_OAUTH_REDIRECT_URI=https://yourdomain.com/api/channels/oauth/callback
INSTAGRAM_API_URL=https://graph.instagram.com

# WhatsApp Webhook (verify token for webhook subscription, app secret for signature verification)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# Inbound webhook signature secrets. Verification is MANDATORY and fail-closed:
# without these set, the matching inbound channel drops all traffic (in prod).
#   EMAIL_WEBHOOK_SECRET          HMAC-SHA256 shared secret with the inbound-email provider
#   GMAIL_PUBSUB_TOKEN            secret appended to the Pub/Sub push URL as ?token=...
#   OUTLOOK_WEBHOOK_CLIENT_STATE  Graph subscription clientState echoed on every notification
EMAIL_WEBHOOK_SECRET=
GMAIL_PUBSUB_TOKEN=
OUTLOOK_WEBHOOK_CLIENT_STATE=

# Messenger (legacy - credentials now stored in ChannelAccount via self-service)
MESSENGER_PAGE_ID=your-messenger-page-id
MESSENGER_ACCESS_TOKEN=your-messenger-page-access-token

# Gateway
GATEWAY_PORT=80

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_META_APP_ID=your-facebook-app-id
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id

# Redis (for Socket.IO adapter)
REDIS_URL=redis://redis:6379

# Internal Service URLs (Docker service names)
AI_SERVICE_URL=http://ai:4006

# Qdrant Vector DB
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me-in-production
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# AI Co-Pilot (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# Knowledge Base Integrations
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
CONFLUENCE_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Zoho CRM OAuth (Server-based Application flow)
# Create the client at https://api-console.zoho.com/ → pick "Server-based Applications".
# ZOHO_ACCOUNTS_URL is region-specific: https://accounts.zoho.com (US default),
# .eu, .in, .com.au, .jp. The matching API domain (e.g. www.zohoapis.com) is
# returned per user at token-exchange time and stored on TenantIntegration.config.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# SMTP Email (Gmail: smtp.gmail.com, port 587, use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="ChatCenter <your-email@gmail.com>"

# System Admin
SYSTEM_ADMIN_SETUP_SECRET=change-me-in-production

# Telegram Notifications (Lead CRM)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public / Webhook URLs (used for OAuth callbacks + webhook subscriptions)
PUBLIC_URL=http://localhost:4000
WEBHOOK_URL=http://localhost:4003

# File Uploads
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=http://localhost:4000/uploads

# WhatsApp Direct (legacy fallback - credentials now stored per tenant in ChannelAccount)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Microsoft / Outlook OAuth (for Outlook email channel)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=
OUTLOOK_WEBHOOK_URL=

# Gmail OAuth + Push Notifications (separate from Google Drive KB OAuth above)
GOOGLE_OAUTH_REDIRECT_URI=
GMAIL_PUBSUB_TOPIC=

# Slack OAuth (for Slack channel connector)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_OAUTH_REDIRECT_URI=

# AI Onboarding
ONBOARDING_CHAT_MODEL=gpt-4o-mini

# Voice Co-Pilot (Twilio Media Streams + STT)
# TWILIO_*: credentials for Media Streams webhook signature verification + outbound
#   calls. Leave blank in dev; required in prod when wiring real Twilio numbers.
# STT_PROVIDER: "stub" (deterministic synthetic transcripts, used in dev/tests) or
#   "google" (live Google Speech-to-Text).
# STT_STUB_SEED: seed for the stub provider's pseudo-random transcripts.
# SESSION_TTL_SECONDS: Redis TTL for in-flight voice sessions.
# RECONNECT_GRACE_MS: how long to hold a session open after a socket drop before
#   reaping, so Twilio can reconnect within the grace window.
# REAPER_*: background sweep that closes stale sessions whose last media frame is
#   older than REAPER_STALE_THRESHOLD_MS.
# MAX_CONCURRENT_SESSIONS: hard cap to protect STT quota + memory.
# DISPATCHER_BATCH_*: coalesces transcript deltas before calling the AI service
#   (batch window or batch max items, whichever trips first).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API Key + Secret for AccessToken minting (Twilio Console → API keys & tokens → Create API Key, type Standard)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App SID (Twilio Console → Voice → TwiML Apps → Create). Voice Request URL: PUBLIC_BASE_URL/api/voice-copilot/twiml/outbound (POST)
TWILIO_TWIML_APP_SID=
# E.164 phone number purchased in Twilio (caller ID for outbound calls)
TWILIO_CALLER_ID=
# Public base URL reachable by Twilio over HTTPS (used in TwiML <Stream url="..."/>)
PUBLIC_BASE_URL=https://your-public-domain.example.com
# STT_PROVIDER: stub | google | deepgram - "deepgram" enables live transcription on calls
STT_PROVIDER=stub
STT_STUB_SEED=42
# Deepgram API key (required when STT_PROVIDER=deepgram)
DEEPGRAM_API_KEY=
LOG_LEVEL=info
SESSION_TTL_SECONDS=900
RECONNECT_GRACE_MS=10000
REAPER_INTERVAL_MS=60000
REAPER_STALE_THRESHOLD_MS=120000
MAX_CONCURRENT_SESSIONS=50
DISPATCHER_BATCH_WINDOW_MS=100
DISPATCHER_BATCH_MAX=5

# Public marketing pricing page (/pricing + landing section).
# MUST stay false in production while prices are provisional.
PUBLIC_PRICING_ENABLED=false

# ─── iCount (billing service only) ────────────────────────────────────────────
# Authentication is API-TOKEN ONLY. Username/password auth is not supported and
# there is no fallback: if ICOUNT_API_TOKEN is absent the provider refuses to
# call the API, and in live mode the service refuses to start.
#
# Create the token in iCount: System -> Settings -> Automation -> API Tokens.
# It is sent as `Authorization: Bearer <token>` and never appears in a URL,
# a request body, a log, or any NEXT_PUBLIC_* variable.
#
# NEVER commit a real token or Page ID.
ICOUNT_MODE=mock
ICOUNT_API_TOKEN=
ICOUNT_API_BASE_URL=https://api.icount.co.il/api/v3.php

# The "Credit card token" (טוקן אשראי) PayPage id. CONFIGURATION, not a
# credential - it selects which hosted page a customer is sent to and grants
# no API access on its own. Server-side only; the checkout URL is generated
# by the backend.
ICOUNT_PAYMENT_PAGE_ID=

# Shared secret for verifying iCount callbacks.
ICOUNT_WEBHOOK_SECRET=

# Encryption for reusable provider CARD TOKENS. A stored card token is a bearer
# instrument, so it gets its OWN key - never CHANNEL_ENCRYPTION_KEY, never a
# session or auth key. There is no fallback: a missing key fails closed at the
# point a token would be stored or used.
# Generate with: openssl rand -hex 32.  NEVER commit a real key.
BILLING_PAYMENT_TOKEN_ENCRYPTION_KEY=
# Decrypt-only keys retained for rotation: "v0:hex,vprev:hex"
BILLING_PAYMENT_TOKEN_DECRYPTION_KEYS=

# Live charging stays OFF. Charging real cards requires BOTH NODE_ENV=production
# and this explicit acknowledgement.
ICOUNT_ALLOW_LIVE=false

# Footer social profiles. Full https URLs. Leave a value empty and that icon is
# not rendered at all, so an environment without an account gets a clean footer.
# WhatsApp expects a wa.me link (or any https URL), not a bare phone number.
SOCIAL_INSTAGRAM_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_WHATSAPP_URL=

# Where a customer returns after the provider's hosted payment page.
# REQUIRED for checkout: without it the success and failure URLs are omitted
# from the payment session, and the customer lands wherever iCount defaults to
# rather than back on their confirmation page.
APP_PUBLIC_URL=https://app.example.com

# off | observe | soft | hard. Only `hard` actually refuses service to an
# unpaid or suspended organization. Undeclared means "off", which fails OPEN -
# their bots keep answering customers and nobody is told.
BILLING_ENFORCEMENT_MODE=enforce

# ─────────────────────────────────────────────────────────────────────────────
# Bank of Israel representative rate
#
# Plan prices are in USD; every charge is in ILS. The conversion uses the
# official Bank of Israel representative rate, fetched automatically - it is not
# something an administrator approves each day.
#
# Two-person approval still applies to a manual override, a configured markup,
# and an emergency fallback used beyond the freshness window. Those are
# decisions; the daily official rate is not.
# ─────────────────────────────────────────────────────────────────────────────
BOI_FX_ENABLED=false
# Beyond this age the stored rate stops being usable and charging fails closed
# rather than converting at a number nobody can defend. 120h covers a weekend
# plus consecutive holidays, when no rate is published at all.
BOI_FX_MAX_STALENESS_HOURS=120
BOI_FX_BASE_URL=https://boi.org.il/PublicApi

# ─────────────────────────────────────────────────────────────────────────────
# Payment capability switches
#
# Separate from ICOUNT_MODE. Mode decides whether the provider can be reached at
# all; these decide whether each capability is part of the product yet. Cards
# can be collectable before they are chargeable.
# ─────────────────────────────────────────────────────────────────────────────
ICOUNT_CHECKOUT_ENABLED=false
ICOUNT_TOKENIZATION_ENABLED=false
ICOUNT_STORED_CARD_CHARGE_ENABLED=false

# May a customer open their own checkout? Off means every checkout is opened by
# a human through Sysadmin paid provisioning, which is the current position.
SELF_SERVE_CHECKOUT_ENABLED=false

# Hours a failed renewal keeps working before paid use stops, so an expired card
# is not punished as harshly as never paying.
BILLING_PAST_DUE_GRACE_HOURS=72
# Only meaningful with BILLING_ENFORCEMENT_MODE=off in production: an explicit,
# written-down acknowledgement that the deployment is running unenforced.
BILLING_ALLOW_UNENFORCED=

# Hosts a paying customer may be sent back through. Empty disables the check.
# Set this in production: it is what stops a mistyped APP_PUBLIC_URL from
# handing a payment provider a domain that is not ours.
APP_PUBLIC_URL_ALLOWED_HOSTS=app.gotcha.co.il

# Authenticates the gateway -> billing hop for forwarded provider
# notifications. NOT a provider secret. iCount cannot sign a callback, and the
# IPN endpoint is deliberately built so that it does not need one: the payload
# decides nothing, it only selects which of our own records to re-verify.
INTERNAL_BILLING_WEBHOOK_FORWARD_SECRET=
