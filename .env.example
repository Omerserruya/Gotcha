
# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/whatsapp_cc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_cc

# Services
NODE_ENV=development
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRES_IN=24h
AUTH_PORT=4001
CONVERSATION_PORT=4002
WEBHOOK_PORT=4003
ANALYTICS_PORT=4004
CHATBOT_PORT=4005
AI_PORT=4006

# Meta Platform - Channel Connection (OAuth + Embedded Signup)
META_APP_ID=your-facebook-app-id
META_APP_SECRET=your-meta-app-secret
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id
OAUTH_REDIRECT_URI=https://yourdomain.com/api/channels/oauth/callback
CHANNEL_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
FACEBOOK_API_URL=https://graph.facebook.com/v21.0

# WhatsApp Webhook (verify token for webhook subscription, app secret for signature verification)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# Messenger (legacy - credentials now stored in ChannelAccount via self-service)
MESSENGER_PAGE_ID=your-messenger-page-id
MESSENGER_ACCESS_TOKEN=your-messenger-page-access-token

# Gateway
GATEWAY_PORT=80

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_META_APP_ID=your-facebook-app-id
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id

# Redis (for Socket.IO adapter)
REDIS_URL=redis://redis:6379

# Internal Service URLs (Docker service names)
AI_SERVICE_URL=http://ai:4006

# Qdrant Vector DB
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me-in-production
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# AI Co-Pilot (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# Knowledge Base Integrations
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
CONFLUENCE_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# SMTP Email (Gmail: smtp.gmail.com, port 587, use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="ChatCenter <your-email@gmail.com>"

# System Admin
SYSTEM_ADMIN_SETUP_SECRET=change-me-in-production

# Telegram Notifications (Lead CRM)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
