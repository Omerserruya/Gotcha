
# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/whatsapp_cc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_cc

# Services
NODE_ENV=development
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_DAYS=30
AUTH_PORT=4001
CONVERSATION_PORT=4002
WEBHOOK_PORT=4003
ANALYTICS_PORT=4004
CHATBOT_PORT=4005
AI_PORT=4006
VOICE_COPILOT_PORT=4007

# Internal Service-to-Service Authentication
# CONVERSATION_SERVICE_URL: base URL the AI service uses when dispatching
#   action-planner tools (create_broadcast, resolve_identity, merge_contacts,
#   schedule_broadcast, preview_broadcast) to the conversation service.
# INTERNAL_SERVICE_TOKEN: Bearer token the AI action-executor sends when no
#   end-user JWT is available (e.g. cron-initiated flows). Must be accepted
#   by the conversation service's authenticate middleware.
# INTERNAL_SERVICE_KEY: shared secret used by incoming-worker → AI service
#   calls (X-Internal-Key header; checked in services/ai/src/routes/ai-assist.ts).
# IMPORTANT: authenticate() accepts EITHER of these as the Bearer secret, but a
#   receiver only knows the value(s) in ITS OWN env. Keep BOTH set to the SAME
#   value so every sender/receiver pair matches - a mismatch surfaces as a
#   misleading "Invalid or expired token" 401 (our auth gate, not a JWT issue).
CONVERSATION_SERVICE_URL=http://conversation:4002
INTERNAL_SERVICE_TOKEN=chatcenter-internal-2026
INTERNAL_SERVICE_KEY=chatcenter-internal-2026

# Meta Platform - Channel Connection (OAuth + Embedded Signup)
META_APP_ID=your-facebook-app-id
META_APP_SECRET=your-meta-app-secret
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id
OAUTH_REDIRECT_URI=https://yourdomain.com/api/channels/oauth/callback
CHANNEL_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
FACEBOOK_API_URL=https://graph.facebook.com/v21.0

# Instagram API with Instagram Login (direct IG Business connect - no Facebook Page)
# Meta App Dashboard → "Instagram API setup with Instagram login" (distinct from META_APP_*)
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
INSTAGRAM_OAUTH_REDIRECT_URI=https://yourdomain.com/api/channels/oauth/callback
INSTAGRAM_API_URL=https://graph.instagram.com

# WhatsApp Webhook (verify token for webhook subscription, app secret for signature verification)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# Messenger (legacy - credentials now stored in ChannelAccount via self-service)
MESSENGER_PAGE_ID=your-messenger-page-id
MESSENGER_ACCESS_TOKEN=your-messenger-page-access-token

# Gateway
GATEWAY_PORT=80

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_META_APP_ID=your-facebook-app-id
NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=your-embedded-signup-config-id

# Redis (for Socket.IO adapter)
REDIS_URL=redis://redis:6379

# Internal Service URLs (Docker service names)
AI_SERVICE_URL=http://ai:4006

# Qdrant Vector DB
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me-in-production
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# AI Co-Pilot (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# Knowledge Base Integrations
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
CONFLUENCE_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Zoho CRM OAuth (Server-based Application flow)
# Create the client at https://api-console.zoho.com/ → pick "Server-based Applications".
# ZOHO_ACCOUNTS_URL is region-specific: https://accounts.zoho.com (US default),
# .eu, .in, .com.au, .jp. The matching API domain (e.g. www.zohoapis.com) is
# returned per user at token-exchange time and stored on TenantIntegration.config.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# SMTP Email (Gmail: smtp.gmail.com, port 587, use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="ChatCenter <your-email@gmail.com>"

# System Admin
SYSTEM_ADMIN_SETUP_SECRET=change-me-in-production

# Telegram Notifications (Lead CRM)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public / Webhook URLs (used for OAuth callbacks + webhook subscriptions)
PUBLIC_URL=http://localhost:4000
WEBHOOK_URL=http://localhost:4003

# File Uploads
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=http://localhost:4000/uploads

# WhatsApp Direct (legacy fallback - credentials now stored per tenant in ChannelAccount)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Microsoft / Outlook OAuth (for Outlook email channel)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_OAUTH_REDIRECT_URI=
OUTLOOK_WEBHOOK_URL=

# Gmail OAuth + Push Notifications (separate from Google Drive KB OAuth above)
GOOGLE_OAUTH_REDIRECT_URI=
GMAIL_PUBSUB_TOPIC=

# Slack OAuth (for Slack channel connector)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_OAUTH_REDIRECT_URI=

# AI Onboarding
ONBOARDING_CHAT_MODEL=gpt-4o-mini

# Voice Co-Pilot (Twilio Media Streams + STT)
# TWILIO_*: credentials for Media Streams webhook signature verification + outbound
#   calls. Leave blank in dev; required in prod when wiring real Twilio numbers.
# STT_PROVIDER: "stub" (deterministic synthetic transcripts, used in dev/tests) or
#   "google" (live Google Speech-to-Text).
# STT_STUB_SEED: seed for the stub provider's pseudo-random transcripts.
# SESSION_TTL_SECONDS: Redis TTL for in-flight voice sessions.
# RECONNECT_GRACE_MS: how long to hold a session open after a socket drop before
#   reaping, so Twilio can reconnect within the grace window.
# REAPER_*: background sweep that closes stale sessions whose last media frame is
#   older than REAPER_STALE_THRESHOLD_MS.
# MAX_CONCURRENT_SESSIONS: hard cap to protect STT quota + memory.
# DISPATCHER_BATCH_*: coalesces transcript deltas before calling the AI service
#   (batch window or batch max items, whichever trips first).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# API Key + Secret for AccessToken minting (Twilio Console → API keys & tokens → Create API Key, type Standard)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TwiML App SID (Twilio Console → Voice → TwiML Apps → Create). Voice Request URL: PUBLIC_BASE_URL/api/voice-copilot/twiml/outbound (POST)
TWILIO_TWIML_APP_SID=
# E.164 phone number purchased in Twilio (caller ID for outbound calls)
TWILIO_CALLER_ID=
# Public base URL reachable by Twilio over HTTPS (used in TwiML <Stream url="..."/>)
PUBLIC_BASE_URL=https://your-public-domain.example.com
# STT_PROVIDER: stub | google | deepgram - "deepgram" enables live transcription on calls
STT_PROVIDER=stub
STT_STUB_SEED=42
# Deepgram API key (required when STT_PROVIDER=deepgram)
DEEPGRAM_API_KEY=
LOG_LEVEL=info
SESSION_TTL_SECONDS=900
RECONNECT_GRACE_MS=10000
REAPER_INTERVAL_MS=60000
REAPER_STALE_THRESHOLD_MS=120000
MAX_CONCURRENT_SESSIONS=50
DISPATCHER_BATCH_WINDOW_MS=100
DISPATCHER_BATCH_MAX=5
