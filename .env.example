# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/whatsapp_cc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_cc

# Services
NODE_ENV=development
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRES_IN=24h
AUTH_PORT=4001
CONVERSATION_PORT=4002
WEBHOOK_PORT=4003
ANALYTICS_PORT=4004
CHATBOT_PORT=4005
AI_PORT=4006

# Meta Platform (shared app secret for WhatsApp + Messenger)
META_APP_SECRET=your-meta-app-secret
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
FACEBOOK_API_URL=https://graph.facebook.com/v19.0

# WhatsApp Cloud API (legacy - credentials now stored in ChannelAccount)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# Messenger (credentials stored in ChannelAccount via admin UI)
MESSENGER_PAGE_ID=your-messenger-page-id
MESSENGER_ACCESS_TOKEN=your-messenger-page-access-token

# Gateway
GATEWAY_PORT=80

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Redis (for Socket.IO adapter)
REDIS_URL=redis://redis:6379

# AI Co-Pilot (OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
