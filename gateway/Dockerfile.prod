# Production gateway = API reverse-proxy + static frontend in one nginx image.
#
# Build context MUST be the repo root so this Dockerfile can COPY from
# frontend/ AND gateway/.
#
# IMPORTANT: this Dockerfile assumes `frontend/out/` already exists. Generate
# it on the HOST before building:
#
#   cd frontend && NEXT_TELEMETRY_DISABLED=1 NEXT_OUTPUT=export \
#     NEXT_PUBLIC_API_URL=… NEXT_PUBLIC_WS_URL=… \
#     NEXT_PUBLIC_META_APP_ID=… NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=… \
#     npm run build
#
# Then from repo root:
#
#   docker buildx build -f gateway/Dockerfile.prod -t <image> .
#
# Why host-built /out instead of an in-container Stage 1: cross-arch buildx
# (amd64 host → linux/arm64 target) emulates the Node builder under QEMU, and
# QEMU networking can't reach fonts.gstatic.com - `next/font/google` hangs and
# times out after ~30 min. Static files are arch-independent, so building on
# the host and copying into an arm64 nginx:alpine works fine.
#
# Runtime: envsubst rewrites the *_PORT variables in the config template at
# container start (same trick as the dev gateway in docker-compose.yml), then
# nginx runs in the foreground.

FROM nginx:alpine

# Pre-built Next.js static export (run `npm run build` on the host first).
COPY frontend/out /usr/share/nginx/html

# Proxy config template. Rendered at container start by the entrypoint
# script (envsubst over the variables listed in CMD, same as the dev gateway).
COPY gateway/nginx.prod.conf.template /etc/nginx/nginx.conf.template

# The list below is an ALLOWLIST: envsubst leaves anything not named here as
# literal text. That is the desirable behaviour - it stops `$host`,
# `$remote_addr` and every other nginx runtime variable from being eaten at
# render time - but it means a variable the template uses and this list omits
# survives verbatim into nginx.conf, and nginx accepts it without complaint.
#
# `$PUBLIC_PRICING_ENABLED` was missing. `map $host $public_pricing_enabled`
# therefore evaluated to the literal string "${PUBLIC_PRICING_ENABLED}", which
# is never "true", so /pricing 302'd to /early-access in production no matter
# what the environment said. It failed SAFE - prices stayed hidden, which is
# the flag's default posture - so nothing looked broken; the switch was simply
# welded off and could not be turned on. The dev gateway's command already
# included it, which is why this only ever bit production.
#
# Keep this list in step with the template. `production-urls.test.ts` asserts
# the two agree, so an omission fails CI rather than shipping.
#
# FRONTEND_PORT is deliberately absent: prod has no frontend upstream, it
# serves the static export baked in above.
CMD ["sh", "-c", "envsubst '$AUTH_PORT $CONVERSATION_PORT $WEBHOOK_PORT $ANALYTICS_PORT $CHATBOT_PORT $AI_PORT $VOICE_COPILOT_PORT $NOTIFICATIONS_PORT $BILLING_PORT $AUTHENTIK_PORT $PUBLIC_PRICING_ENABLED' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && nginx -g 'daemon off;'"]
