        # ─── Static frontend (Next.js export, baked into this image) ──
        root /usr/share/nginx/html;
        index index.html;

        # Long-cache hashed assets - Next.js output has content hashes in every
        # filename under /_next/static, so these are safe to cache aggressively.
        location /_next/static/ {
            expires 1y;
            access_log off;
            add_header Cache-Control "public, immutable";
            # Security headers repeated: this location declares add_header,
            # which cancels server-level inheritance, so ALL six must be re-emitted.
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; object-src 'none'; frame-src 'self' https://*.gotcha.co.il; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:" always;
        }

        # Next.js static-export dynamic [id] routes are emitted ONLY as a "_"
        # placeholder dir (no per-id HTML), because the [id] pages have no
        # generateStaticParams. Falling back to /index.html (as the generic
        # block below does) serves the root shell, so the page never mounts and
        # client-nav RSC (.txt) fetches receive HTML instead of an RSC payload -
        # which is exactly why deep-linking / refreshing /ai-studio/agents/<id>,
        # /agents/new, /system/tenants/<id>, etc. rendered nothing.
        #
        # Map /<base>/<id>/ and its /<id>/index.txt RSC to that "_" placeholder.
        # Scoped to the known dynamic bases (alternation) so it can't touch /api,
        # /_next, or real static pages - those still resolve via $uri first.
        # Keep the .txt block first; both try $uri before the placeholder so the
        # list pages (e.g. /system/tenants/index.txt) keep serving their own file.
        location ~ ^/(departments|integrations|voice|contacts|system/tenants|ai-studio/flows|ai-studio/marketplace|ai-studio/agents|settings/voice-channels|settings/funnels|settings/business-systems|system/plans)/[^/]+/index\.txt$ {
            try_files $uri /$1/_/index.txt /index.html;
        }
        location ~ ^/(departments|integrations|voice|contacts|system/tenants|ai-studio/flows|ai-studio/marketplace|ai-studio/agents|settings/voice-channels|settings/funnels|settings/business-systems|system/plans)/[^/]+/?$ {
            try_files $uri $uri/index.html /$1/_/index.html /index.html;
        }

        # ...and the SUB-PAGES of a dynamic id, which the two rules above do not
        # reach: `[^/]+` cannot cross a slash, so /settings/voice-channels/<id>/routing
        # matched neither and fell through to /index.html - the root shell. The
        # export emits these as /<base>/_/<sub>/index.html, and today that is
        #   settings/voice-channels/_/routing   (inbound + outbound call routing)
        #   departments/_/copilot
        #   voice/_/replay
        # all three of which were unreachable in production while building
        # perfectly. A merchant reported it as "the option is gone from the UI",
        # which is precisely what a page that never mounts looks like.
        location ~ ^/(departments|integrations|voice|contacts|system/tenants|ai-studio/flows|ai-studio/marketplace|ai-studio/agents|settings/voice-channels|settings/funnels|settings/business-systems|system/plans)/[^/]+/([^/]+)/index\.txt$ {
            try_files $uri /$1/_/$2/index.txt /index.html;
        }
        location ~ ^/(departments|integrations|voice|contacts|system/tenants|ai-studio/flows|ai-studio/marketplace|ai-studio/agents|settings/voice-channels|settings/funnels|settings/business-systems|system/plans)/[^/]+/([^/]+)/?$ {
            try_files $uri $uri/index.html /$1/_/$2/index.html /index.html;
        }

        # Next.js export with trailingSlash:true: /foo resolves to /foo/index.html.
        # Unknown URLs fall back to /index.html so the SPA client router can mount
        # the matching route at runtime.
        # ─── Public pricing page (flag-gated, no auth) ────
        # Placed before the static try_files fallback so a disabled flag wins.
        # Both /pricing and /pricing/ are gated: the static export emits the
        # trailing-slash form.
        location = /pricing {
            absolute_redirect off;
            if ($public_pricing_enabled != "true") { return 302 /early-access; }
            try_files $uri $uri/index.html $uri.html /index.html;
        }

        location = /pricing/ {
            absolute_redirect off;
            if ($public_pricing_enabled != "true") { return 302 /early-access; }
            try_files $uri $uri/index.html $uri.html /index.html;
        }

        location / {
            try_files $uri $uri/index.html $uri.html /index.html;
        }
    }

    # ── Marketing: gotcha.co.il → public pages only ───────────
    #
    # Same container, same static export, different contract. There is only one
    # Next.js bundle and it cannot be built twice, so the split is enforced here
    # by path rather than by shipping a second site.
    #
    # This host serves the landing page, pricing, early access and the Trust
    # Center. Every application route redirects to app.gotcha.co.il instead of
    # rendering, which stops the app from being reachable under two hostnames
    # and stops search engines indexing a duplicate of every page.
    #
    # 301 and not 302: the marketing host is permanently not where the app
    # lives, and $request_uri preserves the path and query so a deep link keeps
    # working across the move.
    # www is not a second marketing host, it is a redirect to the canonical one.
    # Serving both would fork the origin the bundle compares against: JS on
    # www.gotcha.co.il would not match NEXT_PUBLIC_MARKETING_URL and would send
    # a visitor to /login from what is visibly the marketing site.
    server {
        listen 80;
        server_name www.gotcha.co.il;
        return 301 https://gotcha.co.il$request_uri;
    }

    server {
        listen 80;
        server_name gotcha.co.il;

        client_max_body_size 1m;
        root /usr/share/nginx/html;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; object-src 'none'; frame-src 'self' https://*.gotcha.co.il; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:" always;

        location /health {
            return 200 '{"status":"ok","service":"gateway","vhost":"marketing"}';
            add_header Content-Type application/json;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
        }

        # Build assets and images. Without these the marketing pages render
        # nothing at all - the redirect below would swallow every chunk.
        location ^~ /_next/ {
            try_files $uri =404;
        }
        location ^~ /icons/ {
            try_files $uri =404;
        }
        location ^~ /platforms/ {
            try_files $uri =404;
        }
        location ^~ /get_gifs/ {
            try_files $uri =404;
        }
        location ~* \.(png|jpg|jpeg|gif|svg|ico|webp|woff2?|txt|xml|webmanifest)$ {
            try_files $uri =404;
        }

        # The public API the marketing pages actually call. Proxied here so the
        # apex works even if the baked NEXT_PUBLIC_API_URL is ever made relative;
        # today the bundle calls app.gotcha.co.il directly and the CORS map above
        # is what makes that succeed.
        location /api/public/pricing {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://billing_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/waitlist {
            limit_req zone=api burst=10 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # The chat widget the landing page embeds. It builds its URLs from
        # window.location.origin, so on this host it requests
        # gotcha.co.il/widget/... and gotcha.co.il/api/embedded-chat/... - and
        # the catch-all redirect below turned both into a CROSS-ORIGIN 301 that
        # the browser then refused. Serving them here keeps the widget
        # same-origin, so no CORS is involved at all.
        location /widget/ {
            try_files $uri =404;
        }

        location /api/embedded-chat {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # The public surface. Kept as an explicit allowlist rather than a list of
        # app routes to exclude: a new application route added later is then
        # private by default here, instead of silently appearing on the
        # marketing domain because nobody remembered to deny it.
        location = / {
            try_files /index.html =404;
        }

        location ~ ^/(early-access|legal|privacy-policy|terms|en|he)(/|$) {
            try_files $uri $uri/index.html $uri.html /index.html;
        }

        # Pricing honours the same kill switch as the app host, so a disabled
        # flag cannot be worked around by asking the other hostname.
        location ~ ^/pricing(/|$) {
            absolute_redirect off;
            if ($public_pricing_enabled != "true") { return 302 /early-access; }
            try_files $uri $uri/index.html $uri.html /index.html;
        }

        # Everything else is the application: send it to the application host.
        location / {
            return 301 https://app.gotcha.co.il$request_uri;
        }
    }

    # ── Voice: voice.gotcha.co.il → voice-copilot ─────────────
    #
    # A separate hostname, and a deliberately SMALL one. Twilio is the only
    # client, so this vhost exposes exactly the four surfaces Twilio touches
    # and nothing else - no frontend, no app API, no OAuth, no marketing
    # fallback. A host that answers only what it must is a host that cannot
    # leak what it should not.
    #
    # Note on topology: the Cloudflare Tunnel may route voice.gotcha.co.il
    # straight to voice-copilot:4007 and skip this container entirely (see
    # DEPLOY.md Step 7), which is the lower-latency arrangement for a media
    # stream. This block exists so the hostname ALSO works through the
    # gateway - during a tunnel change, or if the direct route is withdrawn -
    # rather than depending on one ingress being configured correctly forever.
    #
    # The equivalent paths remain on the app vhost above as compatibility
    # routes for numbers that were configured before the split. New Twilio
    # URLs are generated from VOICE_PUBLIC_URL and land here.
    server {
        listen 80;
        server_name voice.gotcha.co.il;

        # TwiML posts are small; recordings are fetched, never uploaded here.
        client_max_body_size 1m;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        # Nothing on this host is ever rendered in a browser frame.
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;

        # Liveness for the tunnel and for uptime checks.
        location = /health {
            proxy_pass http://voice_copilot_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            access_log off;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        }

        # ─── Twilio Media Streams (WebSocket) ───────────────────
        # The reason this hostname exists. Long-lived, bidirectional, and
        # latency-sensitive: the read/send timeouts are a day because the
        # socket lives as long as the call, and nginx must not close it.
        location /twilio/media-stream {
            proxy_pass http://voice_copilot_service;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $public_proto;
            proxy_set_header X-Twilio-Signature $http_x_twilio_signature;
            proxy_buffering off;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
        }

        # ─── Inbound calls: voice / status / recording / forward ─
        # Twilio validates its signature over the EXACT URL it called, so the
        # public Host and scheme have to survive the hop unaltered.
        location /api/voice/incoming {
            proxy_pass http://voice_copilot_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $public_proto;
            proxy_set_header X-Twilio-Signature $http_x_twilio_signature;
            proxy_request_buffering off;
            # A webhook must never be answered from cache.
            proxy_no_cache 1;
            proxy_cache_bypass 1;
            add_header Cache-Control "no-store" always;
        }

        # ─── TwiML + callback endpoints (outbound, conference) ──
        location /api/voice-copilot {
            proxy_pass http://voice_copilot_service;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $public_proto;
            proxy_set_header X-Twilio-Signature $http_x_twilio_signature;
            proxy_request_buffering off;
            proxy_no_cache 1;
            proxy_cache_bypass 1;
            add_header Cache-Control "no-store" always;
        }

        # Anything else on this hostname is not part of the voice contract.
        # 404, never a redirect to the app or the marketing site: a redirect
        # would turn a mis-typed Twilio URL into a 200 and hide the mistake.
        location / {
            return 404;
        }
    }

    # ── Identity Provider: auth.gotcha.co.il → Authentik ──
    # Authentik owns every credential, session, and MFA secret. GOTCHA never
    # sees a password; it only verifies the tokens signed here.
    #
    # This host must stay reachable independently of the app: if it is down,
    # nobody can log in, and no existing token can be refreshed.
    server {
        listen 80;
        server_name auth.gotcha.co.il;

        # Authentik serves its own static assets and accepts branding/icon
        # uploads through the admin UI.
        client_max_body_size 50m;

        # ── Security headers (H-5) ── Authentik manages its own CSP and
        # framing policy; only the universally-safe baseline is added here.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # The GOTCHA theme sheet: fetched by Authentik's JS and injected into
        # every shadow root. It carries no cache-buster (Authentik builds the
        # URL), and the CDN once pinned a stale copy for hours - users saw the
        # stock Authentik look until the edge cache expired. Force revalidation
        # so a theme change is live on the next page load.
        location = /static/dist/custom.css {
            proxy_pass http://authentik_server;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Forwarded-Proto $public_proto;
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            add_header Cache-Control "no-cache, must-revalidate" always;
        }

        location / {
            limit_req zone=authentik burst=40 nodelay;

            proxy_pass http://authentik_server;
            proxy_http_version 1.1;

            # Authentik builds absolute URLs (and the OIDC `iss` claim) from
            # these. Host must be the PUBLIC hostname and the proto must be
            # the PUBLIC scheme, or issued tokens will not match OIDC_ISSUER.
            proxy_set_header Host              $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $public_proto;
            proxy_set_header X-Forwarded-Host  $host;

            # Allow the GOTCHA app to EMBED Authentik flows (MFA / password /
            # passkey setup) in an in-app modal so identity management feels
            # native. Authentik sends X-Frame-Options: DENY, which blocks all
            # framing; strip it and instead scope framing to gotcha.co.il via a
            # CSP frame-ancestors allowlist (still blocks external clickjacking).
            # add_header here cancels server-scope inheritance, so the baseline
            # headers are repeated.
            proxy_hide_header X-Frame-Options;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Content-Security-Policy "frame-ancestors 'self' https://*.gotcha.co.il" always;

            # Inject the GOTCHA enhancements into every Authentik page (it has
            # no custom-JS hook): a preboot "curtain" (inline style + script)
            # that hides FLOW pages behind a white overlay + spinner until the
            # GOTCHA theme has painted - the theme (custom.css) is injected
            # into shadow roots by Authentik's JS AFTER boot, so without the
            # curtain the stock Authentik UI flashes first - and the enhance
            # script (password eye, OTP boxes, password checklist), which also
            # lifts the curtain the moment the theme lands. The curtain is
            # fail-open: only /if/flow/* pages are covered (never the admin /
            # user portals) and the inline snippet self-lifts after 6s even if
            # every external asset fails. No single quotes in the payload -
            # the sub_filter value is single-quoted.
            # Disable upstream compression so sub_filter can rewrite the body.
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter_types text/html;
            sub_filter '</head>' '<style>html.gotcha-preboot body{visibility:hidden!important}html.gotcha-preboot::before{content:"";position:fixed;inset:0;background:#fff;z-index:9999}html.gotcha-preboot::after{content:"";position:fixed;top:50%;left:50%;width:28px;height:28px;margin:-14px 0 0 -14px;border:3px solid rgba(124,92,252,.25);border-top-color:#7c5cfc;border-radius:50%;animation:gotchaspin .8s linear infinite;z-index:10000}@keyframes gotchaspin{to{transform:rotate(360deg)}}</style><script>(function(){if(location.pathname.indexOf("/if/flow/")===0){var h=document.documentElement;h.classList.add("gotcha-preboot");setTimeout(function(){h.classList.remove("gotcha-preboot")},6000)}})()</script><script src="/static/dist/assets/custom/authentik-enhance.js?v=12" defer></script></head>';

            # The admin interface and outpost channels use WebSockets.
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Authentik's flow executor streams; don't buffer it.
            proxy_buffering off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }
    }

    # ── Help Center: help.gotcha.co.il → the exported /help pages ──
    # The public knowledge base is part of the same static export; this vhost
    # maps the subdomain root onto /help. TLS terminates upstream of this
    # container exactly like the main host.
    server {
        listen 80;
        server_name help.gotcha.co.il;

        # Every try_files below is relative to THIS. Without it nginx falls back
        # to its compile-time default root (/etc/nginx/html), which does not
        # exist in this image - so every path resolved against nothing:
        # `location = /` hit its explicit =404, and everything else 500'd on a
        # try_files fallback that could not be found either.
        #
        # The app vhost declares its own root and there is none at http scope,
        # so this block inherited nothing. help.gotcha.co.il never served a page
        # in production.
        root /usr/share/nginx/html;

        # ── Security headers (H-5) ──────────────────────────────
        # Emitted at server scope; repeated inside any location that declares
        # its own add_header (nginx add_header inheritance stops there).
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
        # CSP: blast-radius cap for XSS. unsafe-inline/eval are required by the
        # Next.js static export today; tightening to nonces is a follow-up.
        # frame-ancestors 'self' (embedded chat is a script widget, not an
        # iframe of this origin, so it is unaffected).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; object-src 'none'; frame-src 'self' https://*.gotcha.co.il; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:" always;

        # Next.js assets + shared statics resolve as-is from the export.
        location ~ ^/(_next|favicon\.ico|logo[^/]*\.png|apple-touch-icon\.png|icons/|images/) {
            try_files $uri =404;
        }

        # In-page links already carry the /help prefix.
        location /help {
            try_files $uri $uri/index.html $uri.html /help/index.html;
        }

        # The bare root serves the help index directly.
        location = / {
            try_files /help/index.html =404;
        }

        # Unprefixed paths land on the help section.
        location / {
            try_files /help$uri /help$uri/index.html /help$uri.html /help/index.html;
        }
    }
}
