            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # AI Employee runtime, tenant-scoped (SSE - see /api/agent above).
        location ~ ^/t/([^/]+)/api/agent(.*)$ {
            proxy_pass http://ai_service/api/agent$2$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 600s;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # AI Employee builder, tenant-scoped (SSE + long readiness POST).
        location ~ ^/t/([^/]+)/api/ai-agents/builder(.*)$ {
            proxy_pass http://ai_service/api/ai-agents/builder$2$is_args$args;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 600s;
            client_max_body_size 12m;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/ai-agents(.*)$ {
            proxy_pass http://ai_service/api/ai-agents$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/router-rules(.*)$ {
            proxy_pass http://ai_service/api/router-rules$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/flow-canvas(.*)$ {
            proxy_pass http://ai_service/api/flow-canvas$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/templates(.*)$ {
            proxy_pass http://conversation_service/api/templates$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/broadcasts(.*)$ {
            proxy_pass http://conversation_service/api/broadcasts$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/audiences(.*)$ {
            proxy_pass http://conversation_service/api/audiences$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/scheduled-messages(.*)$ {
            proxy_pass http://conversation_service/api/scheduled-messages$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/contacts(.*)$ {
            proxy_pass http://conversation_service/api/contacts$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # F1 identity resolution (conversation service)
        location ~ ^/t/([^/]+)/api/identity(.*)$ {
            proxy_pass http://conversation_service/api/identity$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # F2/F3/F4 action planner + executor (ai service)
        location ~ ^/t/([^/]+)/api/action-planner(.*)$ {
            proxy_pass http://ai_service/api/action-planner$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # F4 bot-approval surface (conversation service, tenant-scoped)
        location ~ ^/t/([^/]+)/api/approvals(.*)$ {
            proxy_pass http://conversation_service/api/approvals$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        # ─── Voice Copilot WebSocket (Twilio Media Streams) ───
        location /twilio/media-stream {
            proxy_pass http://voice_copilot_service;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Twilio-Signature $http_x_twilio_signature;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
        }

        # ─── Voice Channels - BYO / Twilio Connect onboarding (conversation) ─
        location /api/voice-channels {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Voice Sessions - agent claim / transcript / context (conversation) ─
        location /api/voice-sessions {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Voice Inbound - single Twilio webhook entrypoint (voice-copilot) ─
        # Twilio posts `voice`, `status`, `recording` to this prefix; channel
        # resolution happens server-side via the `To` form field.
        location /api/voice/incoming {
            proxy_pass http://voice_copilot_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Twilio-Signature $http_x_twilio_signature;
            client_max_body_size 1m;
        }

        # ─── Voice Copilot REST (live, twilio-test when mounted here) ───
        location /api/voice-copilot {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://voice_copilot_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Static frontend (Next.js export, baked into this image) ──
        root /usr/share/nginx/html;
        index index.html;

        # Long-cache hashed assets - Next.js output has content hashes in every
        # filename under /_next/static, so these are safe to cache aggressively.
        location /_next/static/ {
            expires 1y;
            access_log off;
            add_header Cache-Control "public, immutable";
            # Security headers repeated: this location declares add_header,
            # which cancels server-level inheritance, so ALL six must be re-emitted.
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; object-src 'none'; frame-src 'self' https://*.gotcha.co.il; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:" always;
        }

        # Next.js static-export dynamic [id] routes are emitted ONLY as a "_"
        # placeholder dir (no per-id HTML), because the [id] pages have no
        # generateStaticParams. Falling back to /index.html (as the generic
        # block below does) serves the root shell, so the page never mounts and
        # client-nav RSC (.txt) fetches receive HTML instead of an RSC payload -
        # which is exactly why deep-linking / refreshing /ai-studio/agents/<id>,
        # /agents/new, /system/tenants/<id>, etc. rendered nothing.
        #
        # Map /<base>/<id>/ and its /<id>/index.txt RSC to that "_" placeholder.
        # Scoped to the known dynamic bases (alternation) so it can't touch /api,
        # /_next, or real static pages - those still resolve via $uri first.
        # Keep the .txt block first; both try $uri before the placeholder so the
        # list pages (e.g. /system/tenants/index.txt) keep serving their own file.
        location ~ ^/(departments|integrations|voice|contacts|system/tenants|ai-studio/flows|ai-studio/marketplace|ai-studio/agents|settings/voice-channels|settings/funnels)/[^/]+/index\.txt$ {
            try_files $uri /$1/_/index.txt /index.html;
        }
        location ~ ^/(departments|integrations|voice|contacts|system/tenants|ai-studio/flows|ai-studio/marketplace|ai-studio/agents|settings/voice-channels|settings/funnels)/[^/]+/?$ {
            try_files $uri $uri/index.html /$1/_/index.html /index.html;
        }

        # Next.js export with trailingSlash:true: /foo resolves to /foo/index.html.
        # Unknown URLs fall back to /index.html so the SPA client router can mount
        # the matching route at runtime.
        # ─── Public pricing page (flag-gated, no auth) ────
        # Placed before the static try_files fallback so a disabled flag wins.
        # Both /pricing and /pricing/ are gated: the static export emits the
        # trailing-slash form.
        location = /pricing {
            absolute_redirect off;
            if ($public_pricing_enabled != "true") { return 302 /early-access; }
            try_files $uri $uri/index.html $uri.html /index.html;
        }

        location = /pricing/ {
            absolute_redirect off;
            if ($public_pricing_enabled != "true") { return 302 /early-access; }
            try_files $uri $uri/index.html $uri.html /index.html;
        }

        location / {
            try_files $uri $uri/index.html $uri.html /index.html;
        }
    }

    # ── Identity Provider: auth.gotcha.co.il → Authentik ──
    # Authentik owns every credential, session, and MFA secret. GOTCHA never
    # sees a password; it only verifies the tokens signed here.
    #
    # This host must stay reachable independently of the app: if it is down,
    # nobody can log in, and no existing token can be refreshed.
    server {
        listen 80;
        server_name auth.gotcha.co.il;

        # Authentik serves its own static assets and accepts branding/icon
        # uploads through the admin UI.
        client_max_body_size 50m;

        # ── Security headers (H-5) ── Authentik manages its own CSP and
        # framing policy; only the universally-safe baseline is added here.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # The GOTCHA theme sheet: fetched by Authentik's JS and injected into
        # every shadow root. It carries no cache-buster (Authentik builds the
        # URL), and the CDN once pinned a stale copy for hours - users saw the
        # stock Authentik look until the edge cache expired. Force revalidation
        # so a theme change is live on the next page load.
        location = /static/dist/custom.css {
            proxy_pass http://authentik_server;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Forwarded-Proto $public_proto;
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            add_header Cache-Control "no-cache, must-revalidate" always;
        }

        location / {
            limit_req zone=authentik burst=40 nodelay;

            proxy_pass http://authentik_server;
            proxy_http_version 1.1;

            # Authentik builds absolute URLs (and the OIDC `iss` claim) from
            # these. Host must be the PUBLIC hostname and the proto must be
            # the PUBLIC scheme, or issued tokens will not match OIDC_ISSUER.
            proxy_set_header Host              $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $public_proto;
            proxy_set_header X-Forwarded-Host  $host;

            # Allow the GOTCHA app to EMBED Authentik flows (MFA / password /
            # passkey setup) in an in-app modal so identity management feels
            # native. Authentik sends X-Frame-Options: DENY, which blocks all
            # framing; strip it and instead scope framing to gotcha.co.il via a
            # CSP frame-ancestors allowlist (still blocks external clickjacking).
            # add_header here cancels server-scope inheritance, so the baseline
            # headers are repeated.
            proxy_hide_header X-Frame-Options;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Content-Security-Policy "frame-ancestors 'self' https://*.gotcha.co.il" always;

            # Inject the GOTCHA enhancements into every Authentik page (it has
            # no custom-JS hook): a preboot "curtain" (inline style + script)
            # that hides FLOW pages behind a white overlay + spinner until the
            # GOTCHA theme has painted - the theme (custom.css) is injected
            # into shadow roots by Authentik's JS AFTER boot, so without the
            # curtain the stock Authentik UI flashes first - and the enhance
            # script (password eye, OTP boxes, password checklist), which also
            # lifts the curtain the moment the theme lands. The curtain is
            # fail-open: only /if/flow/* pages are covered (never the admin /
            # user portals) and the inline snippet self-lifts after 6s even if
            # every external asset fails. No single quotes in the payload -
            # the sub_filter value is single-quoted.
            # Disable upstream compression so sub_filter can rewrite the body.
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter_types text/html;
            sub_filter '</head>' '<style>html.gotcha-preboot body{visibility:hidden!important}html.gotcha-preboot::before{content:"";position:fixed;inset:0;background:#fff;z-index:9999}html.gotcha-preboot::after{content:"";position:fixed;top:50%;left:50%;width:28px;height:28px;margin:-14px 0 0 -14px;border:3px solid rgba(124,92,252,.25);border-top-color:#7c5cfc;border-radius:50%;animation:gotchaspin .8s linear infinite;z-index:10000}@keyframes gotchaspin{to{transform:rotate(360deg)}}</style><script>(function(){if(location.pathname.indexOf("/if/flow/")===0){var h=document.documentElement;h.classList.add("gotcha-preboot");setTimeout(function(){h.classList.remove("gotcha-preboot")},6000)}})()</script><script src="/static/dist/assets/custom/authentik-enhance.js?v=12" defer></script></head>';

            # The admin interface and outpost channels use WebSockets.
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Authentik's flow executor streams; don't buffer it.
            proxy_buffering off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }
    }

    # ── Help Center: help.gotcha.co.il → the exported /help pages ──
    # The public knowledge base is part of the same static export; this vhost
    # maps the subdomain root onto /help. TLS terminates upstream of this
    # container exactly like the main host.
    server {
        listen 80;
        server_name help.gotcha.co.il;

        # ── Security headers (H-5) ──────────────────────────────
        # Emitted at server scope; repeated inside any location that declares
        # its own add_header (nginx add_header inheritance stops there).
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
        # CSP: blast-radius cap for XSS. unsafe-inline/eval are required by the
        # Next.js static export today; tightening to nonces is a follow-up.
        # frame-ancestors 'self' (embedded chat is a script widget, not an
        # iframe of this origin, so it is unaffected).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; object-src 'none'; frame-src 'self' https://*.gotcha.co.il; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:" always;

        # Next.js assets + shared statics resolve as-is from the export.
        location ~ ^/(_next|favicon\.ico|logo[^/]*\.png|apple-touch-icon\.png|icons/|images/) {
            try_files $uri =404;
        }

        # In-page links already carry the /help prefix.
        location /help {
            try_files $uri $uri/index.html $uri.html /help/index.html;
        }

        # The bare root serves the help index directly.
        location = / {
            try_files /help/index.html =404;
        }

        # Unprefixed paths land on the help section.
        location / {
            try_files /help$uri /help$uri/index.html /help$uri.html /help/index.html;
        }
    }
}
