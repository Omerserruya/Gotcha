        location /widget/ {
            # Served from the static export baked into THIS image - there is
            # no `frontend` container in production. Proxying to one made nginx
            # refuse to start outright ("host not found in upstream frontend"),
            # which took the whole gateway down, not just the widget.
            try_files $uri =404;

            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;

            # The filename carries no content hash, so a long TTL would pin
            # a broken widget in every shopper's cache until it expired.
            # Short TTL plus revalidation until the assets are versioned.
            # Content-hashed filenames: new bytes are a new URL, so this
            # can be cached for a year without ever going stale.
            add_header Cache-Control "public, max-age=31536000, immutable" always;

            # Security headers repeated: this location declares add_header,
            # which cancels server-level inheritance, so ALL six must be re-emitted.
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
