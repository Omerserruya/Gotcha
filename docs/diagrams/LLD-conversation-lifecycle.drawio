<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-02-24T00:00:00.000Z" agent="ChatCenter" etag="lld-lifecycle" version="24.0.0" type="device">
  <diagram id="lld-lifecycle" name="LLD - Conversation Lifecycle &amp; Assignment">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="LLD - Conversation Lifecycle &amp; Assignment State Machine" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== STATE MACHINE ==================== -->

        <!-- New Conversation Created -->
        <mxCell id="start" value="Customer sends&#xa;first message" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="80" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- OPEN state -->
        <mxCell id="open" value="OPEN&#xa;&#xa;Conversation visible&#xa;in agent queue" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="510" y="200" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a-start" value="Incoming Worker&#xa;creates conversation&#xa;status=OPEN" style="endArrow=block;endFill=1;strokeColor=#333;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="start" target="open">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- WAITING state -->
        <mxCell id="waiting" value="WAITING&#xa;&#xa;In department queue&#xa;No agent assigned" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="160" y="420" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- CLOSED state -->
        <mxCell id="closed" value="CLOSED&#xa;&#xa;closedAt recorded&#xa;AI summary generated" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="510" y="700" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- ==================== TRANSITIONS ==================== -->

        <!-- OPEN -> Agent Claims -->
        <mxCell id="claimed-box" value="Agent Claimed&#xa;&#xa;assignedAgentId = agent&#xa;isHandedOver = true&#xa;System msg: agent_claimed&#xa;Auto-greeting sent" style="rounded=1;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="810" y="200" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a-claim" value="POST /:id/claim&#xa;(CLAIM mode)" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontStyle=1;" edge="1" parent="1" source="open" target="claimed-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Chatbot routes to department -->
        <mxCell id="a-bot-dept" value="Chatbot dept_route node&#xa;(ROUND_ROBIN: auto-assign&#xa; or no agent: WAITING)" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="open" target="waiting">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Chatbot handover -->
        <mxCell id="a-bot-ho" value="Chatbot handover node&#xa;isHandedOver=true&#xa;status=WAITING" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=2;fontSize=9;dashed=1;" edge="1" parent="1" source="open" target="waiting">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="370" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- WAITING -> Agent Claims -->
        <mxCell id="a-wait-claim" value="POST /:id/claim" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontStyle=1;" edge="1" parent="1" source="waiting" target="claimed-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="920" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Agent assigned -> active conversation -->
        <mxCell id="active-box" value="Active Conversation&#xa;&#xa;Agent and customer&#xa;exchanging messages&#xa;&#xa;Messages flow:&#xa;Frontend -> Conv Service -> Queue -> Outgoing Worker -> Meta&#xa;Meta -> Webhook -> Queue -> Incoming Worker -> Socket.IO" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#4A90D9;fontSize=10;align=left;spacingLeft=10;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="770" y="400" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="a-active" value="Conversation&#xa;in progress" style="endArrow=block;endFill=1;strokeColor=#4A90D9;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="claimed-box" target="active-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Reassign to another agent -->
        <mxCell id="reassign-box" value="Reassigned&#xa;&#xa;assignedAgentId = newAgent&#xa;System msg: agent_transferred&#xa;Auto-greeting from new agent" style="rounded=1;whiteSpace=wrap;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="400" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a-reassign" value="POST /:id/reassign&#xa;{agentId}" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=9;" edge="1" parent="1" source="active-box" target="reassign-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-reassign-back" value="" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="reassign-box" target="active-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1210" y="530" />
              <mxPoint x="920" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Transfer to department -->
        <mxCell id="transfer-box" value="Department Transfer&#xa;&#xa;departmentId = newDept&#xa;Round-Robin: auto-assign agent&#xa;System msg: department_transferred&#xa;Auto-greeting (if assigned)" style="rounded=1;whiteSpace=wrap;fillColor=#fff3e0;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="440" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a-transfer" value="POST /:id/reassign&#xa;{departmentId}" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=9;" edge="1" parent="1" source="active-box" target="transfer-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a-transfer-active" value="Agent auto-assigned" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=9;" edge="1" parent="1" source="transfer-box" target="active-box">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a-transfer-wait" value="No agent&#xa;available" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=1.5;fontSize=9;dashed=1;" edge="1" parent="1" source="transfer-box" target="waiting">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Release -->
        <mxCell id="a-release" value="POST /:id/release&#xa;&#xa;assignedAgentId=null&#xa;status=OPEN" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=9;fontStyle=1;" edge="1" parent="1" source="active-box" target="open">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1100" y="180" />
              <mxPoint x="610" y="180" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Close -->
        <mxCell id="a-close" value="POST /:id/close&#xa;&#xa;status=CLOSED&#xa;closedAt=now()&#xa;async: AI summary" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=1;" edge="1" parent="1" source="active-box" target="closed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Auto-close (idle) -->
        <mxCell id="a-autoclose" value="Idle Worker&#xa;auto-close&#xa;(timeout)" style="endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=9;dashed=1;" edge="1" parent="1" source="waiting" target="closed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="740" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== IDLE AUTOMATION ==================== -->
        <mxCell id="idle-box" value="" style="rounded=1;whiteSpace=wrap;dashed=1;fillColor=#fafafa;strokeColor=#666;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="350" height="170" as="geometry" />
        </mxCell>
        <mxCell id="idle-title" value="Idle Automation (every 5 min)" style="text;fontSize=12;fontStyle=1;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="100" y="605" width="250" height="25" as="geometry" />
        </mxCell>
        <mxCell id="idle-1" value="1. Find idle conversations:&#xa;   - Status: OPEN/WAITING&#xa;   - Last msg: OUTBOUND (agent waiting)&#xa;   - Elapsed > threshold" style="text;fontSize=10;align=left;fontFamily=Courier New;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="635" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="idle-2" value="2. If elapsed >= reminderDelay:&#xa;   Send reminder msg to customer&#xa;3. If elapsed >= autoCloseDelay:&#xa;   Send close msg, set CLOSED&#xa;   System msg: auto_closed" style="text;fontSize=10;align=left;fontFamily=Courier New;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="320" height="65" as="geometry" />
        </mxCell>

        <!-- ==================== AI SUMMARY ==================== -->
        <mxCell id="ai-box" value="" style="rounded=1;whiteSpace=wrap;dashed=1;fillColor=#fafafa;strokeColor=#666;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="680" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ai-title" value="Async: AI Summary Generation" style="text;fontSize=12;fontStyle=1;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="810" y="685" width="250" height="25" as="geometry" />
        </mxCell>
        <mxCell id="ai-flow" value="1. Close returns to client immediately&#xa;2. GET /api/ai-assist/{id}/summary&#xa;3. AI Service: fetch all msgs, summarize&#xa;4. Save to conversation.aiSummary&#xa;5. Non-blocking (errors logged)" style="text;fontSize=9;align=left;fontFamily=Courier New;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="780" y="715" width="290" height="75" as="geometry" />
        </mxCell>
        <mxCell id="a-ai" value="async" style="endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;dashed=1;fontSize=9;" edge="1" parent="1" source="closed" target="ai-box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== ROUND ROBIN DETAIL ==================== -->
        <mxCell id="rr-box" value="" style="rounded=1;whiteSpace=wrap;dashed=1;fillColor=#fafafa;strokeColor=#666;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="rr-title" value="Round-Robin Assignment Logic" style="text;fontSize=12;fontStyle=1;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="100" y="205" width="250" height="25" as="geometry" />
        </mxCell>
        <mxCell id="rr-flow" value="1. Get department members (isActive=true)&#xa;2. Count active (non-CLOSED) convos per agent&#xa;3. Sort by count ascending&#xa;4. Assign to agent with fewest convos&#xa;5. If no agents available: status=WAITING&#xa;6. Create system msg + auto-greeting" style="text;fontSize=10;align=left;fontFamily=Courier New;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="235" width="330" height="95" as="geometry" />
        </mxCell>

        <!-- ==================== LEGEND ==================== -->
        <mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#ccc;" vertex="1" parent="1">
          <mxGeometry x="50" y="850" width="550" height="80" as="geometry" />
        </mxCell>
        <mxCell id="leg-t" value="Legend:" style="text;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="855" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="60" y="885" width="25" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg1t" value="OPEN state" style="text;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="90" y="883" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="180" y="885" width="25" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg2t" value="WAITING state" style="text;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="210" y="883" width="90" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="310" y="885" width="25" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg3t" value="CLOSED state" style="text;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="883" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="" style="rounded=1;fillColor=#bbdefb;strokeColor=#4A90D9;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="430" y="885" width="25" height="15" as="geometry" />
        </mxCell>
        <mxCell id="leg4t" value="Active (agent + customer)" style="text;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="883" width="140" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg-note" value="Solid arrows = user/API actions  |  Dashed arrows = automated/async actions" style="text;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="910" width="430" height="15" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
