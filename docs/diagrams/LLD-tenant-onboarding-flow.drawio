<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-02-24T00:00:00.000Z" agent="ChatCenter" etag="lld-onboarding" version="24.0.0" type="device">
  <diagram id="lld-onboarding" name="LLD - Tenant Onboarding Flow">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="LLD - Tenant Lifecycle &amp; Onboarding Flow" style="text;html=1;fontSize=22;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- ==================== SWIMLANES ==================== -->

        <!-- System Admin -->
        <mxCell id="lane1" value="" style="rounded=1;whiteSpace=wrap;dashed=1;dashPattern=8 8;fillColor=#fce4ec;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="350" height="1480" as="geometry" />
        </mxCell>
        <mxCell id="lane1-label" value="System Admin" style="text;html=1;fontSize=15;fontStyle=1;align=center;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="130" y="85" width="150" height="30" as="geometry" />
        </mxCell>

        <!-- Auth Service / Backend -->
        <mxCell id="lane2" value="" style="rounded=1;whiteSpace=wrap;dashed=1;dashPattern=8 8;fillColor=#e8f5e9;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="380" height="1480" as="geometry" />
        </mxCell>
        <mxCell id="lane2-label" value="Auth Service (Backend)" style="text;html=1;fontSize=15;fontStyle=1;align=center;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="490" y="85" width="200" height="30" as="geometry" />
        </mxCell>

        <!-- Tenant Admin -->
        <mxCell id="lane3" value="" style="rounded=1;whiteSpace=wrap;dashed=1;dashPattern=8 8;fillColor=#e3f2fd;strokeColor=#4A90D9;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="350" height="1480" as="geometry" />
        </mxCell>
        <mxCell id="lane3-label" value="Tenant Admin (Onboarding)" style="text;html=1;fontSize=15;fontStyle=1;align=center;fontColor=#4A90D9;" vertex="1" parent="1">
          <mxGeometry x="870" y="85" width="210" height="30" as="geometry" />
        </mxCell>

        <!-- Data -->
        <mxCell id="lane4" value="" style="rounded=1;whiteSpace=wrap;dashed=1;dashPattern=8 8;fillColor=#f3e5f5;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1170" y="80" width="200" height="1480" as="geometry" />
        </mxCell>
        <mxCell id="lane4-label" value="Database" style="text;html=1;fontSize=15;fontStyle=1;align=center;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1220" y="85" width="100" height="30" as="geometry" />
        </mxCell>

        <!-- ==================== FLOW ==================== -->

        <!-- START -->
        <mxCell id="start" value="START" style="ellipse;whiteSpace=wrap;fillColor=#333;fontColor=#fff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="130" width="80" height="40" as="geometry" />
        </mxCell>

        <!-- Step 1: System admin creates tenant -->
        <mxCell id="s1" value="System Admin fills&#xa;Create Tenant form:&#xa;name, slug, adminEmail,&#xa;adminPassword, adminName" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="75" y="200" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a0" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="start" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 2: POST /api/system/tenants -->
        <mxCell id="s2" value="POST /api/system/tenants" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="215" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DB operations -->
        <mxCell id="db1" value="CREATE Tenant&#xa;status=PENDING_ADMIN_SETUP&#xa;&#xa;CREATE User (ADMIN)&#xa;password=bcrypt(pw)&#xa;&#xa;CREATE TenantOnboarding&#xa;step=BUSINESS_PROFILE" style="shape=cylinder3;size=10;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="1190" y="190" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a1b" value="" style="endArrow=block;endFill=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="s2" target="db1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3: Send magic link email -->
        <mxCell id="s3" value="NotificationService:&#xa;1. Generate 32-byte token&#xa;2. Store MagicLink (48h expiry)&#xa;3. Send email via SMTP&#xa;4. Log notification" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="340" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="async (non-blocking)" style="endArrow=block;endFill=1;strokeColor=#333;fontSize=9;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Email sent -->
        <mxCell id="email1" value="Onboarding email&#xa;with magic link:&#xa;/setup/verify?token=xxx" style="shape=note;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;size=14;" vertex="1" parent="1">
          <mxGeometry x="860" y="350" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="SMTP email" style="endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=2;fontSize=9;" edge="1" parent="1" source="s3" target="email1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 4: Admin clicks link -->
        <mxCell id="s4" value="Admin clicks magic link&#xa;in email" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#4A90D9;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="440" width="180" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="email1" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 5: Verify magic link -->
        <mxCell id="s5" value="POST /api/auth/verify-magic-link&#xa;&#xa;Validate: not used, not expired&#xa;Mark as used&#xa;Transition: PENDING_ADMIN_SETUP&#xa;  -> PENDING_ONBOARDING&#xa;Sign JWT, return token" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="460" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="db2" value="UPDATE Tenant&#xa;status=&#xa;PENDING_ONBOARDING&#xa;&#xa;UPDATE MagicLink&#xa;usedAt=now()" style="shape=cylinder3;size=10;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1195" y="470" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a5b" value="" style="endArrow=block;endFill=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="s5" target="db2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 6: Redirect to setup -->
        <mxCell id="s6" value="Redirect to /setup&#xa;(onboarding wizard)" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#4A90D9;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="865" y="595" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="JWT stored, redirect" style="endArrow=block;endFill=1;strokeColor=#333;fontSize=9;" edge="1" parent="1" source="s5" target="s6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== ONBOARDING WIZARD ==================== -->

        <!-- Step 7: Business Profile -->
        <mxCell id="s7" value="Step 1: Business Profile&#xa;&#xa;organizationName, industry,&#xa;businessDescription,&#xa;businessPriority, aiMode,&#xa;estimatedDailyConversations" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#4A90D9;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="835" y="670" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s6" target="s7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend save profile -->
        <mxCell id="s7b" value="POST /api/onboarding/&#xa;business-profile&#xa;&#xa;Upsert BusinessProfile&#xa;Step -> DEPARTMENTS" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="455" y="680" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a7b" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s7" target="s7b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="db3" value="UPSERT&#xa;BusinessProfile&#xa;UPDATE step=&#xa;DEPARTMENTS" style="shape=cylinder3;size=10;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1200" y="690" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a7c" value="" style="endArrow=block;endFill=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="s7b" target="db3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 8: Departments -->
        <mxCell id="s8" value="Step 2: Configure Departments&#xa;&#xa;name, description, aiMode,&#xa;queueMode, slaTarget,&#xa;escalationPolicy,&#xa;autoGreeting, autoClose" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#4A90D9;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="835" y="810" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s7" target="s8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="s8b" value="POST /api/onboarding/&#xa;departments&#xa;&#xa;Create departments (tx)&#xa;Step -> COMPLETED" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="455" y="820" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a8b" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s8" target="s8b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="db4" value="CREATE&#xa;Departments&#xa;(transaction)" style="shape=cylinder3;size=10;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1205" y="830" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a8c" value="" style="endArrow=block;endFill=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="s8b" target="db4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 9: AI Chat (optional) -->
        <mxCell id="s9" value="Step 3: AI Chat (Optional)&#xa;&#xa;Fine-tune AI behavior via&#xa;LLM conversation&#xa;(4 questions: tone, escalation,&#xa;topics, restrictions)&#xa;&#xa;Can skip" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#4A90D9;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="835" y="950" width="210" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s8" target="s9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="s9b" value="POST /api/onboarding/ai-chat&#xa;&#xa;OpenAI GPT-4o-mini&#xa;(or fallback Q&amp;A)&#xa;Structured JSON responses&#xa;readyToGenerate after 3 turns" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="955" width="230" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a9b" value="multiple&#xa;rounds" style="endArrow=block;endFill=1;strokeColor=#333;fontSize=9;" edge="1" parent="1" source="s9" target="s9b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 10: Generate configs -->
        <mxCell id="s10" value="Step 4: Generate Configs&#xa;&#xa;Click &quot;Generate AI Configs&quot;" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#4A90D9;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="845" y="1100" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a10" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s9" target="s10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="s10b" value="POST /api/onboarding/&#xa;generate-configs&#xa;&#xa;AgentConfigGenerator:&#xa;For each department generate:&#xa;- Identity block&#xa;- Goals block&#xa;- Tone block&#xa;- Behavioral block&#xa;- Mode constraints&#xa;- Tools config&#xa;- Full system prompt" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="440" y="1080" width="240" height="155" as="geometry" />
        </mxCell>
        <mxCell id="a10b" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s10" target="s10b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="db5" value="UPSERT AgentConfig&#xa;UPSERT&#xa;DeptCopilotConfig&#xa;(per department)" style="shape=cylinder3;size=10;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1195" y="1110" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a10c" value="" style="endArrow=block;endFill=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="s10b" target="db5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 11: Complete -->
        <mxCell id="s11" value="Step 5: Complete Onboarding&#xa;&#xa;Click &quot;Activate&quot;" style="rounded=1;whiteSpace=wrap;fillColor=#bbdefb;strokeColor=#4A90D9;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="845" y="1270" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s10" target="s11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="s11b" value="POST /api/onboarding/complete&#xa;&#xa;Validates:&#xa;- Profile exists&#xa;- Departments exist&#xa;- SLA targets set&#xa;- Admin user active&#xa;&#xa;Actions:&#xa;- Generate configs (if needed)&#xa;- Create CopilotConfig&#xa;- Tenant status -> ACTIVE&#xa;- Onboarding step -> COMPLETED&#xa;- Send activation email&#xa;- Publish tenant:activated" style="rounded=0;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="430" y="1260" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="a11b" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s11" target="s11b">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="db6" value="UPDATE Tenant&#xa;status=ACTIVE&#xa;&#xa;UPDATE Onboarding&#xa;step=COMPLETED&#xa;completedAt=now()&#xa;&#xa;CREATE CopilotConfig" style="shape=cylinder3;size=10;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1190" y="1280" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="a11c" value="" style="endArrow=block;endFill=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="s11b" target="db6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Redirect to dashboard -->
        <mxCell id="s12" value="Redirect to&#xa;/conversations&#xa;&#xa;TENANT IS ACTIVE!" style="rounded=1;whiteSpace=wrap;fillColor=#c8e6c9;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="855" y="1380" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="" style="endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="s11" target="s12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- END -->
        <mxCell id="end" value="END" style="ellipse;whiteSpace=wrap;fillColor=#333;fontColor=#fff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="1480" width="60" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a13" value="" style="endArrow=block;endFill=1;strokeColor=#333;" edge="1" parent="1" source="s12" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== STATUS LEGEND ==================== -->
        <mxCell id="legend" value="" style="rounded=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#ccc;" vertex="1" parent="1">
          <mxGeometry x="40" y="1460" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="legend-t" value="Tenant Status Transitions" style="text;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="1465" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="PENDING_ADMIN_SETUP -> (magic link / login) -> PENDING_ONBOARDING" style="text;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="1490" width="320" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="PENDING_ONBOARDING -> (complete onboarding) -> ACTIVE" style="text;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="1508" width="320" height="15" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="ACTIVE -> (system admin suspends) -> SUSPENDED" style="text;fontSize=9;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="1526" width="320" height="15" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
