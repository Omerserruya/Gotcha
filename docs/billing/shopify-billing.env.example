# ─────────────────────────────────────────────────────────────────────────────
# Shopify billing — configuration example.
#
# NO SECRETS IN THIS FILE. Values that are credentials are shown as empty with
# a note; fill them from the Partner Dashboard (see
# shopify-partner-dashboard-setup.md) into your own environment file, never
# into the repository.
#
# Every variable is declared in BOTH docker-compose.yml and
# docker-compose.prod.yml with these same defaults, enforced by
# services/billing/src/__tests__/env-wiring.test.ts.
#
# The defaults below ARE the current production behaviour: Shopify billing off,
# nothing charged, nothing granted.
# ─────────────────────────────────────────────────────────────────────────────

# ── Master switch ────────────────────────────────────────────────────────────
# While false, the Shopify billing source refuses every operation, the policy
# resolver answers UNRESOLVED, and usage is recorded but never dispatched.
SHOPIFY_BILLING_ENABLED=false

# "app_pricing" = Shopify hosts plan selection (no webhooks; verification via
#                 the Partner API; needs an org-level token).
# "manual"      = the GraphQL Billing API (needs the shop's Admin token, so
#                 billing delegates the call to services/ai).
# Unset means disabled. A typo also means disabled - there is no default way to
# charge people.
SHOPIFY_BILLING_MODE=

# ── Environment ──────────────────────────────────────────────────────────────
# mock = no network at all, can charge nothing. The suite runs here.
# test = real Shopify against DEVELOPMENT stores, where Shopify prices at $0.
# live = real money, and additionally requires SHOPIFY_ALLOW_LIVE_BILLING.
SHOPIFY_BILLING_ENV=mock
SHOPIFY_ALLOW_LIVE_BILLING=false

# ── Commercial policy ────────────────────────────────────────────────────────
# full | connector_addon | grandfathered_only
# Unset => the resolver answers UNRESOLVED and the merchant lands on a
# non-charging billing-pending screen. That is the correct answer until Shopify
# tells us which arrangement is permitted.
SHOPIFY_BILLING_POLICY_MODE=

# Whether ONE workspace may be billed by Shopify and by GOTCHA at the same time.
# ⚠️ Shopify has NOT confirmed that split billing is permitted for GOTCHA.
# connector_addon refuses while this is false, deliberately: wrong in this
# direction shows a pending screen, wrong the other way bills a merchant twice.
SHOPIFY_ALLOW_SPLIT_BILLING=false

# Whether an existing customer may keep external billing after connecting
# Shopify. Off by default. Grandfathering ALSO requires evidence - an active
# external subscription in our own database. A customer's claim is not evidence.
SHOPIFY_ALLOW_GRANDFATHERED=false

# ── Grandfathering, the confirmed model ────────────────────────────────────
#
# The App Store publication moment, ISO 8601. This is the line eligibility is
# measured against: a workspace whose GOTCHA subscription started being PAID
# before it keeps GOTCHA billing and is never charged by Shopify.
#
# Measured against the first PAYMENT, never the account creation date - an
# account opened in January that first paid in November is a new customer
# commercially.
#
# UNSET MEANS NOBODY IS ELIGIBLE. Never everybody. A missing publication date
# must not hand free access to the entire customer base on an omission.
SHOPIFY_APP_PUBLICATION_CUTOFF=

# Whether a Shopify development store may be grandfathered automatically.
# A dev store has no commercial history, so a grant there is a testing
# artefact that would then be indistinguishable from a real one.
SHOPIFY_GRANDFATHER_DEV_STORES=false

# ── Test-store allowlist ───────────────────────────────────────────────────
#
# Which stores may enter the App Pricing flow while SHOPIFY_BILLING_ENV=test.
# Comma or whitespace separated; a bare handle or a full myshopify domain.
#
# Testing runs against the PRODUCTION Partner app on the production host,
# beside real merchants. Without this list, flipping the env to `test` would
# put every connected store into plan selection at once.
#
# EMPTY ALLOWS NOBODY. A forgotten variable must mean "the test does not
# start", never "every merchant is enrolled". `live` ignores this entirely,
# so a stale list cannot exclude paying merchants later.
#
# SHOPIFY_BILLING_TEST_SHOPS=my-dev-store,another-dev-store.myshopify.com
SHOPIFY_BILLING_TEST_SHOPS=

# ── Metered usage ────────────────────────────────────────────────────────────
# Enable last, once subscriptions are proven.
SHOPIFY_USAGE_BILLING_ENABLED=false

# ── Handles (configuration, never prices) ────────────────────────────────────
# The app handle in the plan-selection URL:
#   https://admin.shopify.com/store/<store>/charges/<handle>/pricing_plans
SHOPIFY_APP_HANDLE=

# JSON: our product key -> Shopify plan handle.
# Prices live ONLY in the Partner Dashboard; a copy here would eventually
# disagree with what the merchant was actually shown.
SHOPIFY_BILLING_PLAN_HANDLES={"shopify_connector":"connector-monthly"}

# The FULL plan catalog. Supersedes the flat map above when both are set.
#
# Carries identifiers and OUR commercial metadata only. There is deliberately
# no price, currency or trial field: Shopify owns all three, and a copy here
# would eventually disagree with what the merchant was shown and charged.
#
# `restrictedToShops` is how a private plan and a store-specific arrangement
# are expressed - it is an OFFER filter, never an authorization.
#
# Unset means NO plan is sellable, which is the fail-closed state.
#
# SHOPIFY_BILLING_PLAN_CATALOG=[{"key":"SHOPIFY_CONNECTOR","productKey":"shopify_connector","handle":"connector-monthly","visibility":"public","enabled":true,"interval":"monthly","rank":1,"entitlements":["shopify_catalog_sync","shopify_order_read","shopify_order_actions","shopify_storefront_widget"],"restrictedToShops":[]}]
SHOPIFY_BILLING_PLAN_CATALOG=

# JSON: our metric -> Shopify usage meter handle. CASE-SENSITIVE at Shopify.
# An unmapped metric is skipped as no_meter_handle_configured, never guessed.
SHOPIFY_USAGE_METER_HANDLES={"ai_answer":"ai-answers"}

# ── Partner API (app_pricing only) ───────────────────────────────────────────
# App Pricing sends NO subscription webhooks since 2026-04-28, so this query is
# the only way to learn that a merchant paid. All three are required together.
SHOPIFY_PARTNER_API_TOKEN=          # SECRET - from Partner API clients
SHOPIFY_PARTNER_ORGANIZATION_ID=
SHOPIFY_PARTNER_APP_ID=
SHOPIFY_PARTNER_API_BASE_URL=       # optional override
SHOPIFY_PARTNER_API_VERSION=        # optional override, defaults to 2026-07

# ── App Events (metered usage only) ──────────────────────────────────────────
# OAuth2 client_credentials for https://api.shopify.com/app/unstable/events
SHOPIFY_APP_EVENTS_CLIENT_ID=       # SECRET
SHOPIFY_APP_EVENTS_CLIENT_SECRET=   # SECRET
SHOPIFY_APP_EVENTS_BASE_URL=        # optional override

# ── Cross-service (manual mode only) ─────────────────────────────────────────
# services/ai owns the merchant's Admin token and performs the Shopify call on
# billing's behalf. Billing never holds a copy of that token.
AI_SERVICE_URL=http://ai:4006
INTERNAL_SERVICE_TOKEN=             # SECRET - shared internal service key

# ── Release identity ─────────────────────────────────────────────────────────
# Recorded on every BillingPolicyDecision so a decision can be attributed to a
# build. Same pair Sentry resolves a release from.
SENTRY_RELEASE=
BUILD_SHA=dev
