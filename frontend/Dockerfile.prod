# Production build: Next.js → static export → nginx
# Image is ~70MB vs ~886MB for the standalone (dev) build.
#
# To use:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml build frontend
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d frontend
#
# Hydration audit MUST be kept clean — static export pre-renders all "use client"
# components with build-time defaults; any browser-API read in a useState initializer
# crashes hydration and unmounts the tree (incl. VoiceCallProvider → dropped calls).
# See I18nContext.tsx, ConversationList.tsx, CueLanesCard.tsx for the safe pattern.

FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_OUTPUT=export

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_META_APP_ID
ARG NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_META_APP_ID=$NEXT_PUBLIC_META_APP_ID
ENV NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=$NEXT_PUBLIC_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID

RUN npm run build

# ───────────────────────────────────────────────────────────────
FROM nginx:alpine AS runner

COPY --from=builder /app/out /usr/share/nginx/html
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# nginx:alpine already has a sensible default CMD; keep it.
