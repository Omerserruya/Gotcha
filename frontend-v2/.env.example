# ---------------------------------------------------------------------------
# GOTCHA frontend configuration
#
# Copy to `.env.local` for local development. Every environment (local,
# development, staging, production) is configured entirely through these
# variables - no application code changes when the backend moves.
#
# Rule: secrets NEVER go in a NEXT_PUBLIC_* variable. Those are inlined into
# the browser bundle and are world-readable.
# ---------------------------------------------------------------------------

# --- Environment identity -------------------------------------------------
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local

# --- Platform API (server-side only) --------------------------------------
# The browser never calls this directly: the platform API's CORS policy only
# admits its own origin, so all browser traffic is proxied by this app's BFF.
API_BASE_URL=https://dev.gotcha.co.il
API_TIMEOUT_MS=20000

# --- Authentik OIDC -------------------------------------------------------
# GOTCHA implements no authentication of its own; Authentik issues the tokens
# and the platform API verifies them against Authentik's JWKS.
#
# The dev issuer below was read from Authentik's own discovery document at
#   https://auth.gotcha.co.il/application/o/gotcha/.well-known/openid-configuration
# It advertises: authorization_code + refresh_token grants, PKCE S256, the
# offline_access scope, and an end-session endpoint (so RP-initiated logout
# works). It does NOT advertise `none` as a token endpoint auth method, which
# means the provider expects a CONFIDENTIAL client - register this app as one
# and set OIDC_CLIENT_SECRET. The secret is read server-side only and is never
# exposed to the browser.
#
# Register this redirect URI with Authentik: ${APP_ORIGIN}/api/auth/callback
OIDC_ISSUER=https://auth.gotcha.co.il/application/o/gotcha/
OIDC_CLIENT_ID=
# Required: this provider does not accept a public (PKCE-only) client.
OIDC_CLIENT_SECRET=
OIDC_SCOPES="openid profile email offline_access"
APP_ORIGIN=http://localhost:3000

# --- Session cookie -------------------------------------------------------
# Encrypts the HttpOnly session cookie. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=
SESSION_COOKIE_NAME=gotcha_session
SESSION_MAX_AGE_SECONDS=2592000

# --- Realtime -------------------------------------------------------------
# Socket.IO gateway origin. Public by nature.
NEXT_PUBLIC_REALTIME_URL=https://dev.gotcha.co.il

# --- Observability --------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
NEXT_PUBLIC_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Uploads source maps at build time. Never commit this.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

LOG_LEVEL=debug

# --- Platform-owned session (preferred) -----------------------------------
# When this app is served from a host that shares the platform's cookie
# domain, the browser sends the platform's session cookie here too. Set these
# and the BFF forwards that cookie upstream instead of holding a token of its
# own — no token ever reaches the frontend, and revoking a session takes
# effect immediately rather than whenever a local cookie expires.
#
# Requires serving the app from a *.gotcha.co.il host. For local development:
#   1. add to /etc/hosts:   127.0.0.1  local.gotcha.co.il
#   2. APP_ORIGIN=http://local.gotcha.co.il:3000
#
# Leave both unset to run on this app's own session instead (src/auth).
#
# ⚠ Since 2026-10-21 this app IS the root: the gateway gives
# `/api/auth/login` to this app, not the platform. Pointing this at
# `<host>/api/auth/login` skips our sign-in panel for our own handler; leave
# it unset unless a platform login lives somewhere else.
PLATFORM_SESSION_COOKIE=
PLATFORM_LOGIN_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Where the sign-in panel hands over, when sign-in is served from its own host
# ─────────────────────────────────────────────────────────────────────────────
# Unset — the default, and the whole product today — the panel navigates to
# `/api/auth/login` on its own host, which is correct while the panel and the
# product share one.
#
# Set it when this build serves ONLY the sign-in surface from a separate auth
# origin. Without it the password is accepted, the identity provider session is
# created, and the browser then asks the AUTH host for a route only the PRODUCT
# host serves — a 404 at the end of a successful sign-in, which reads as the
# panel being broken.
#
# It is the WHOLE URL, including the product's mount point (none since the
# product moved to the root, 2026-10-21): nothing can compose it here.
#
# PRODUCT_LOGIN_URL=https://dev.gotcha.co.il/api/auth/login

# ─────────────────────────────────────────────────────────────────────────────
# Where the flow executor answers, when the panel is on the provider's origin
# ─────────────────────────────────────────────────────────────────────────────
# Unset — the default — the browser calls `/auth-api/…` (under the app's
# base path, if any), the gateway
# location that proxies to `authentik_server/api/v3/`. That proxy exists only
# because the panel is served from the PRODUCT's origin and Authentik is not.
#
# On the identity provider's own origin the page and the API are already
# same-origin, so set it to `/api/v3` and the hop disappears.
#
# NEXT_PUBLIC_* is inlined at BUILD time: setting this on a running container
# does nothing. The two builds differ by their build arguments, not by source.
#
# NEXT_PUBLIC_FLOW_EXECUTOR_BASE=/api/v3

# ─────────────────────────────────────────────────────────────────────────────
# Where the gate sends an unauthenticated visitor, when sign-in is not here
# ─────────────────────────────────────────────────────────────────────────────
# Unset — the default — the gate redirects to `/sign-in` on this same host.
#
# Set it on the PRODUCT deployment once sign-in is served from its own origin.
# It is the symmetric twin of PRODUCT_LOGIN_URL: each build is told where the
# other one is, and neither is a boolean. The product points at the sign-in
# origin; the sign-in origin points at the product.
#
# Different from PLATFORM_LOGIN_URL, which means "do not use our panel at all"
# and still wins over this. This one means "our panel, on another host".
#
# Give the UNPREFIXED, UNLOCALISED path: the other origin answers 307 to
# /en/sign-in itself, from the browser's own Accept-Language. Naming a locale
# here would override a preference we have no business overriding, on the first
# page somebody sees.
#
# SIGN_IN_URL=https://auth-dev.gotcha.co.il/sign-in
