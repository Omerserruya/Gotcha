{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-plugin-logical-css"],
  "rules": {
    "logical-css/require-logical-properties": [
      true,
      {
        "ignore": ["overflow-y", "overflow-x"],
        "severity": "error"
      }
    ],
    "logical-css/require-logical-keywords": true,

    "selector-class-pattern": "^[a-z][a-zA-Z0-9]*$",
    "custom-property-pattern": "^[a-z][a-zA-Z0-9]*(-[a-z0-9]+)*$",
    "no-descending-specificity": null,
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["layer"] }],
    "custom-property-empty-line-before": null,
    "comment-empty-line-before": null,
    "declaration-block-no-redundant-longhand-properties": null
  },
  "ignoreFiles": ["**/node_modules/**", ".next/**"]
}
