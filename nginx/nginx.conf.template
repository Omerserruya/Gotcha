worker_processes auto;

events {
    worker_connections 1024;
}

http {
    upstream auth_service {
        server auth:${AUTH_PORT};
    }

    upstream conversation_service {
        server conversation:${CONVERSATION_PORT};
    }

    upstream webhook_service {
        server webhook:${WEBHOOK_PORT};
    }

    upstream analytics_service {
        server analytics:${ANALYTICS_PORT};
    }

    upstream chatbot_service {
        server chatbot:${CHATBOT_PORT};
    }

    upstream ai_service {
        server ai:${AI_PORT};
    }

    upstream frontend {
        server frontend:${FRONTEND_PORT};
    }

    # Rate limiting zone
    limit_req_zone $binary_remote_addr zone=api:10m rate=100r/s;

    server {
        listen 80;
        server_name _;

        # Increase body size for webhooks
        client_max_body_size 10m;

        # Health check for the gateway itself
        location /health {
            return 200 '{"status":"ok","service":"gateway"}';
            add_header Content-Type application/json;
        }

        # ─── Auth Service ─────────────────────────────────
        location /api/auth {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/agents {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/departments {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Onboarding Service ──────────────────────────
        location /api/onboarding {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Waitlist (public, no auth) ───────────────────
        location /api/waitlist {
            limit_req zone=api burst=10 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── System Admin Service ─────────────────────────
        location /api/system {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Channel Connection Service ─────────────────────
        location /api/channels {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Uploads (served by Conversation Service) ────
        location /api/uploads {
            client_max_body_size 20m;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Templates, Broadcasts, Scheduled Messages, Contacts (Conversation Service) ──
        location /api/templates {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/broadcasts {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/scheduled-messages {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/contacts {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Conversation Service ─────────────────────────
        location /api/conversations {
            limit_req zone=api burst=50 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Socket.IO - WebSocket upgrade for real-time
        location /socket.io/ {
            proxy_pass http://conversation_service;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400;
        }

        # ─── Webhook Service ─────────────────────────────
        location /api/webhook {
            proxy_pass http://webhook_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Hub-Signature-256 $http_x_hub_signature_256;
        }

        # ─── Analytics Service ────────────────────────────
        location /api/analytics {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://analytics_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Chatbot Service ─────────────────────────────
        location /api/chatbot-flows {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://chatbot_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # F1 identity (conversation service)
        location /api/identity {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # F2/F3/F4 action planner (ai service)
        location /api/action-planner {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── AI Service ──────────────────────────────────
        location /api/ai-assist {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/knowledge-bases {
            limit_req zone=api burst=20 nodelay;
            client_max_body_size 12m;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/knowledge {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Tools Service (AI) ─────────────────────────
        location /api/tools {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/system-chat {
            limit_req zone=api burst=20 nodelay;
            client_max_body_size 12m;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/integrations {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/ai-agents {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/router-rules {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/flow-canvas {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/usage {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/agent-scores {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Embedded Chat (public, CORS enabled) ────────
        location /api/embedded-chat {
            # CORS for widget on external sites
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;

            if ($request_method = OPTIONS) {
                return 204;
            }

            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Tenant-scoped routing ───────────────────────
        location ~ ^/t/([^/]+)/api/auth(.*)$ {
            proxy_pass http://auth_service/api/auth$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/conversations(.*)$ {
            proxy_pass http://conversation_service/api/conversations$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/webhook(.*)$ {
            proxy_pass http://webhook_service/api/webhook$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/analytics(.*)$ {
            proxy_pass http://analytics_service/api/analytics$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/chatbot-flows(.*)$ {
            proxy_pass http://chatbot_service/api/chatbot-flows$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/ai-assist(.*)$ {
            proxy_pass http://ai_service/api/ai-assist$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/knowledge-bases(.*)$ {
            proxy_pass http://ai_service/api/knowledge-bases$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/knowledge(.*)$ {
            proxy_pass http://ai_service/api/knowledge$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/agents(.*)$ {
            proxy_pass http://auth_service/api/agents$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/departments(.*)$ {
            proxy_pass http://auth_service/api/departments$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/channels(.*)$ {
            proxy_pass http://auth_service/api/channels$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/tools(.*)$ {
            proxy_pass http://ai_service/api/tools$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location ~ ^/t/([^/]+)/api/onboarding(.*)$ {
            proxy_pass http://auth_service/api/onboarding$2$is_args$args;
            proxy_set_header X-Tenant-ID $1;
