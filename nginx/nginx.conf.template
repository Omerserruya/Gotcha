        # F4 bot-approval surface (conversation service)
        location /api/approvals {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # F2/F3/F4 action planner (ai service)
        location /api/action-planner {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── AI Service ──────────────────────────────────
        location /api/ai-assist {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/knowledge-bases {
            limit_req zone=api burst=20 nodelay;
            client_max_body_size 12m;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
