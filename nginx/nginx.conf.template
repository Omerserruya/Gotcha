worker_processes auto;

events {
    worker_connections 1024;
}

http {
    upstream auth_service {
        server auth:${AUTH_PORT};
    }

    upstream conversation_service {
        server conversation:${CONVERSATION_PORT};
    }

    upstream webhook_service {
        server webhook:${WEBHOOK_PORT};
    }

    upstream analytics_service {
        server analytics:${ANALYTICS_PORT};
    }

    upstream chatbot_service {
        server chatbot:${CHATBOT_PORT};
    }

    upstream ai_service {
        server ai:${AI_PORT};
    }

    upstream voice_copilot_service {
        server voice-copilot:${VOICE_COPILOT_PORT};
    }

    upstream notifications_service {
        server notifications:${NOTIFICATIONS_PORT};
    }

    upstream billing_service {
        server billing:${BILLING_PORT};
    }

    upstream frontend {
        server frontend:${FRONTEND_PORT};
    }

    # The redesigned app, running beside the one above and sharing nothing with
    # it. Reached at /v2.
    #
    # ★ THE PORT IS HARDCODED, AND THAT IS NOT LAZINESS.
    #
    # This file is rendered by `envsubst` with an EXPLICIT variable whitelist
    # (see the gateway's command in docker-compose.yml). A variable that is not
    # on that list is passed through LITERALLY - measured, not assumed:
    #
    #   printf 'server x:$SOME_UNLISTED_VAR;' | envsubst '<the whitelist>'
    #   -> server x:$SOME_UNLISTED_VAR;      (passed through verbatim)
    #
    # The example deliberately names no real variable: written with one that IS
    # on the whitelist, this comment got substituted in the rendered file and
    # illustrated the opposite of its point.
    #
    # nginx rejects that as an invalid port and REFUSES TO START, which takes
    # every route in this file down, not just /v2. The app's Dockerfile pins
    # `ENV PORT=3000` and `EXPOSE 3000`, so there was never a knob here.
    upstream frontend_v2 {
        server frontend-v2:3000;
    }

    # The sign-in screen's own build, root-mounted. See `frontend-auth` in
    # docker-compose.yml for why it is a second image rather than a proxy.
    upstream frontend_auth {
        server frontend-auth:3000;
    }

    # API documentation UI. DEV ONLY - gateway/nginx.prod.conf.template has no
    # equivalent upstream or location, so /api/docs simply does not exist in
    # production. That is a structural absence, not a runtime flag that could be
    # flipped by accident.
    upstream swagger_ui {
        server swagger-ui:8080;
    }

    # Authentik - the identity provider, fronted at auth-dev.gotcha.co.il by
    # the vhost at the bottom of this file. Mirrors the prod topology so dev
    # exercises the same issuer/proxy path rather than a localhost shortcut.
    # See docs/security/authentik-architecture.md.
    upstream authentik_server {
        server authentik-server:${AUTHENTIK_PORT};
    }

    # Real public scheme - see the note in gateway/nginx.prod.conf.template.
    # TLS terminates upstream of this container, so $scheme is "http" here;
    # Authentik must be told the public scheme or it signs tokens whose `iss`
    # never matches OIDC_ISSUER.
    map $http_x_forwarded_proto $public_proto {
        default $scheme;
        "~.+"   $http_x_forwarded_proto;
    }

    # Public pricing kill switch. Server-controlled, so the gate does not depend
    # on the browser running any JavaScript: nginx refuses /pricing and the
    # billing service 404s /api/public/pricing from the same flag. Defaults to
    # "false" when the variable is unset, because provisional prices must never
    # become publicly reachable by omission.
    map $host $public_pricing_enabled {
        default "${PUBLIC_PRICING_ENABLED}";
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Rate limiting zone
    limit_req_zone $binary_remote_addr zone=api:10m rate=100r/s;
    # ★ 429, NOT NGINX'S DEFAULT 503. Without this every rate-limited route in
    # the product answers "Service Unavailable" for "you sent too many requests",
    # and the two are investigated in completely different places.
    #
    # It cost a real diagnosis: a capture run saw three 503s on
    # /api/billing/credit-summary, the billing service had logged nothing about
    # them - because it never received the requests - and the absence of any 429
    # in the run was read as evidence that the rate limiter was NOT involved. It
    # was the rate limiter. This nginx could not emit a 429 to be found.
    #
    # The client already classifies correctly and was being lied to:
    # redesign/src/api/client/api-error.ts maps 429 -> 'rate_limited' and
    # 502/503/504 -> 'integration'. So a throttled request was reported as an
    # upstream failure. With this line, `integration` means an upstream problem
    # again, and a throttle is findable by grepping for the status it deserves.
    limit_req_status 429;


    # Authentik gets its own zone so app traffic can never throttle a login.
    limit_req_zone $binary_remote_addr zone=authentik:10m rate=20r/s;

    # ★★ EVERY VHOST, NOT ONE - THIS BIT US TWICE IN ONE DAY.
    #
    # nginx's default `proxy_buffer_size` is one page (4k), and that is the
    # buffer an upstream's RESPONSE HEADER BLOCK must fit in. Two upstreams
    # here exceed it:
    #
    #   the product callback   4,369 bytes of headers, 2,783 of them Set-Cookie
    #                          (gotcha_session alone is 2,711)
    #   authentik 2025.6+      larger headers than 2024.x; the admin interface
    #                          502s through the gateway while answering 200
    #                          directly on :9000
    #
    # ⚠ The failure is `upstream sent too big header` and a 502 - the service
    #   is fine and only the proxy fails, which is why it reads as an outage
    #   with no error in the application's own logs.
    #
    # ★ It was first raised on the /v2 location alone. That fixed the callback
    #   and left authentik on the default, so an upgrade took the admin
    #   interface down hours later. Set at http level it covers every vhost,
    #   including ones nobody has added yet.
    proxy_buffer_size 16k;
    proxy_buffers     8 16k;
    proxy_busy_buffers_size 32k;

    server {
        listen 80;
        server_name _;

        # Increase body size for webhooks
        client_max_body_size 10m;

        # ── Security headers (H-5) ──────────────────────────────
        # Emitted at server scope; repeated inside any location that declares
        # its own add_header (nginx add_header inheritance stops there).
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
        # CSP: blast-radius cap for XSS. unsafe-inline/eval are required by the
        # Next.js static export today; tightening to nonces is a follow-up.
        # frame-ancestors 'self' (embedded chat is a script widget, not an
        # iframe of this origin, so it is unaffected).
        #
        # connect.facebook.net / www.facebook.com are allowed ONLY here, on the
        # app vhost, because WhatsApp Embedded Signup runs Meta's official
        # JavaScript SDK on /settings/channels/whatsapp. Meta publishes no way
        # to launch that flow without their SDK, so blocking it blocks the
        # feature outright. Deliberately NOT added to the /widget/,
        # /api/embedded-chat or help policies: those serve untrusted storefronts
        # and public pages and have no reason to reach Facebook.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; object-src 'none'; frame-src 'self' https://*.gotcha.co.il https://www.facebook.com https://web.facebook.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:" always;

        # Health check for the gateway itself
        location /health {
            return 200 '{"status":"ok","service":"gateway"}';
            add_header Content-Type application/json;
            # Security headers repeated: this location declares add_header,
            # which cancels server-level inheritance, so ALL six must be re-emitted.
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; object-src 'none'; frame-src 'self' https://*.gotcha.co.il; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:" always;
        }

        # ─── Auth Service ─────────────────────────────────
        location /api/auth {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Customer checkout status. Billing service, read-only.
        #     Authorization is a continuation token, a session with membership,
        #     or platform admin - never the opaque reference alone. X-Internal-Key
        #     is stripped so a caller cannot forge internal-service auth.
        location /api/checkout {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://billing_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/billing {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://billing_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Platform (Sysadmin) pricing administration + actual-cost
        #     analytics. Billing service, SYSTEM_ADMIN-gated in-app.
        #     Deliberately specific prefixes rather than a blanket /api/admin,
        #     so this does not claim a namespace another service may want.
        location /api/admin/pricing {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://billing_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── The exchange rate money is charged at. Sysadmin only, in-app.
        #     Separate prefix because this decides what every Israeli customer's
        #     card is debited, and it should be visible as its own surface in
        #     the routing table rather than folded into pricing.
        location /api/admin/billing {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://billing_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/admin/analytics {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://billing_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Coupons: sysadmin-issued discounts. One prefix for the whole
        # surface - see the prod template for why.
        location /api/admin/coupons {
            proxy_pass http://billing_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/admin/evaluation {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://billing_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/agents {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/permissions {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # The Security screen's audit log. This file is an explicit per-path
        # allowlist, so a route with no location here is a 404 AT THE GATEWAY
        # however healthy the service is - see the /api/docs note above and the
        # /api/business-policies one below, both of which are the same trap.
        # Verifying such a route inside its container proves only that the
        # container works.
        location /api/audit-logs {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── GDPR: contact DSRs (conversation svc) - more specific prefix,
        #     matched before /api/gdpr below. ────────────────
        # ─── Account (self-service profile / sessions / security) ──
        location /api/account {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Workspace security policy (MFA enforcement) - auth svc ──
        location /api/tenant/security {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Workspace-wide business policy caps (conversation service). Bounds the
        # compensation / refund / coupon tools the Integrations & Tools workspace
        # displays. There was NEVER a location for this, so ActionPoliciesPanel
        # has always 404'd - the panel rendered and silently had no data.
        # Policy-evaluation audit, read-only. Same service and gate family as
        # /api/business-policies above; separate path because it is a record of
        # decisions rather than the policies themselves.
        location /api/policy-decisions {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/business-policies {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/gdpr/contacts {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── GDPR: user/tenant DSRs, consent, retention (auth svc) ──
        # NOTE: /api/gdpr-internal is deliberately NOT routed here - it is an
        # in-mesh-only endpoint gated by the internal key.
        location /api/gdpr {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/departments {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Day-one setup state (auth) ──────────────────
        #
        # Separate from /api/onboarding, which describes a wizard's progress.
        # This is the workspace's readiness state machine.
        location /api/setup {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Onboarding Service ──────────────────────────
        location /api/onboarding {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Public Onboarding (no-auth invite endpoints) ─
        # Routes used by the /join page: GET /invite/:token and POST
        # /invite/accept. Auth header is intentionally NOT required -
        # invites are validated by the signed-random token instead.
        # ─── Public pricing page (flag-gated, no auth) ────
        # Disabled: send visitors to early access rather than a dead end, and
        # never reveal that a pricing route exists.
        location = /pricing {
            absolute_redirect off;
            if ($public_pricing_enabled != "true") { return 302 /early-access; }
            proxy_pass http://frontend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Static export emits /pricing/ (trailingSlash) - gate both forms.
        location = /pricing/ {
            absolute_redirect off;
            if ($public_pricing_enabled != "true") { return 302 /early-access; }
            proxy_pass http://frontend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Public pricing catalog (billing, no auth, cacheable) ──
        location /api/public/pricing {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://billing_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/public/onboarding {
            limit_req zone=api burst=10 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Waitlist (public, no auth) ───────────────────
        location /api/waitlist {
            limit_req zone=api burst=10 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── System Admin Service ─────────────────────────
        location /api/system {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Channel Connection Service ─────────────────────
        location /api/channels {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://auth_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Uploads (served by Conversation Service) ────
        location /api/uploads {
            client_max_body_size 20m;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Templates, Broadcasts, Scheduled Messages, Contacts (Conversation Service) ──
        location /api/templates {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/broadcasts {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/audiences {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/tenant-settings {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/scheduled-messages {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
