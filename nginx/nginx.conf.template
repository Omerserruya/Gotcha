            # true}) for the dashboard, so every embedded-chat response also
            # carried Access-Control-Allow-Origin: https://app.gotcha.co.il.
            # Added to the wildcard below that made TWO of the header, and a
            # browser refuses a response whose Access-Control-Allow-Origin
            # "contains multiple values" - so the widget was blocked on every
            # site that embedded it, ours included, while curl saw a healthy
            # 200. The credentials flag goes too: it is invalid beside "*",
            # and this surface carries no cookie and no token anyway.
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            add_header Access-Control-Allow-Origin * always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            # Security headers repeated: this location declares add_header,
            # which cancels server-level inheritance, so ALL six must be re-emitted.
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; object-src 'none'; frame-src 'self' https://*.gotcha.co.il; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:" always;

            if ($request_method = OPTIONS) {
                return 204;
            }

            limit_req zone=api burst=20 nodelay;
            proxy_pass http://ai_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }


        # ─── Storefront widget assets (public, cross-origin BY DESIGN) ───
        #
        # Loaded by <script> from arbitrary merchant storefronts, so this
        # is the one place a wildcard CORS origin is correct: public
        # JavaScript, no tenant data, no credentials, no cookie. Without
        # it the browser refuses the script and the widget never runs -
        # which from the server side looks exactly like "the merchant
        # never enabled the embed".
        #
        # Deliberately NO Access-Control-Allow-Credentials (invalid with a
        # wildcard) and NO Vary: Origin (the response does not vary by
        # origin, and it would fragment every cache for nothing).
        #
        # Two cache tiers, because one of them already went wrong:
        #
        #   the ENTRY POINT must revalidate on every page load, or a fixed
        #   URL pins whatever bytes a browser saw first - that is exactly
        #   how a fixed ?v= kept serving a broken close button for hours.
        #
        #   the HASHED bundle is immutable by construction: new content is
        #   a new filename, so it can be cached for a year safely.
        location = /widget/gotcha-shopify-bootstrap.js {
            proxy_pass http://frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_hide_header Access-Control-Allow-Origin;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;

            # `no-cache` still allows a cached copy - it requires it to be
            # revalidated first, so an unchanged file costs a 304.
            proxy_hide_header Cache-Control;
            add_header Cache-Control "public, no-cache, must-revalidate" always;

            # Security headers repeated: this location declares add_header,
            # which cancels server-level inheritance, so ALL six must be re-emitted.
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; object-src 'none'; frame-src 'self' https://*.gotcha.co.il; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:" always;
        }

        location /widget/ {
            proxy_pass http://frontend;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_hide_header Access-Control-Allow-Origin;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;

            # The filename carries no content hash, so a long TTL would pin
            # a broken widget in every shopper's cache until it expired.
            # Short TTL plus revalidation until the assets are versioned.
            # Content-hashed filenames: new bytes are a new URL, so this
            # can be cached for a year without ever going stale.
            proxy_hide_header Cache-Control;
            add_header Cache-Control "public, max-age=31536000, immutable" always;

            # Security headers repeated: this location declares add_header,
            # which cancels server-level inheritance, so ALL six must be re-emitted.
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header X-Frame-Options "SAMEORIGIN" always;
            add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; object-src 'none'; frame-src 'self' https://*.gotcha.co.il; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:" always;
        }

        # ─── Shopify Live Chat (public storefront surface) ───
