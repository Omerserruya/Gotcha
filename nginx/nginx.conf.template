        location /twilio/media-stream {
            proxy_pass http://voice_copilot_service;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Twilio-Signature $http_x_twilio_signature;
            proxy_read_timeout 86400;
            proxy_send_timeout 86400;
        }

        # ─── Voice Channels - BYO / Twilio Connect onboarding (conversation) ─
        location /api/voice-channels {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Voice Sessions - agent claim / transcript / context (conversation) ─
        location /api/voice-sessions {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://conversation_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Voice Inbound - single Twilio webhook entrypoint (voice-copilot) ─
        # Twilio posts `voice`, `status`, `recording` to this prefix; channel
        # resolution happens server-side via the `To` form field.
        location /api/voice/incoming {
            proxy_pass http://voice_copilot_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Twilio-Signature $http_x_twilio_signature;
            client_max_body_size 1m;
        }

        # ─── Voice Copilot REST (live, twilio-test when mounted here) ───
        location /api/voice-copilot {
            limit_req zone=api burst=20 nodelay;
            proxy_pass http://voice_copilot_service;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── API documentation (DEV ONLY) ────────────────
        #
        # Two things live here:
        #   /api/docs/openapi.yaml  the generated spec as a raw file, so
        #                           Postman, Insomnia or an IDE plugin can
        #                           fetch it over HTTP
        #   /api/docs/              Swagger UI, which fetches that same URL
        #
        # The exact-match location is declared first and, being `=`, wins over
        # the prefix proxy below regardless of order - otherwise the UI would
        # proxy the spec request to itself and 404.
        location = /api/docs/openapi.yaml {
            alias /usr/share/nginx/api-docs/openapi.yaml;
            default_type application/yaml;
            add_header Access-Control-Allow-Origin "*" always;
            add_header Cache-Control "no-store" always;
        }

        location = /api/docs {
            return 301 /api/docs/;
        }

        # proxy_pass with a trailing slash strips the /api/docs/ prefix, so the
        # container sees "/" and serves from its own root. That is why BASE_URL
        # is not set on the container: it must stay root-relative to work on the
        # published port too.
        location /api/docs/ {
            proxy_pass http://swagger_ui/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── The redesigned app, mounted beside the existing one ──────────
        #
        # Nothing existing moves. Every /api/... prefix above is longer and more
        # specific than this one, and the legacy catch-all below still takes
        # everything else, so this adds a namespace rather than redirecting one.
        #
        # ★ `^~`, NOT A BARE PREFIX. In nginx a REGEX location beats a prefix
        # location. A bare `/v2` would be safe here only because every regex in
        # this block happens to be anchored at `^/t/` and the one matching
        # `_next` lives in the help server block - true today, not true by
        # construction. `^~` stops regex evaluation once this prefix wins, so the
        # next unanchored regex somebody adds cannot quietly take /v2 paths.
        #
        # ★★ AND NO TRAILING SLASH ON proxy_pass. `http://frontend_v2;` forwards
        # the URI unchanged, which is what the app needs: it was BUILT with
        # basePath=/v2 and serves its own routes under that prefix, including
        # /v2/_next/... for its bundle. Writing `http://frontend_v2/` would strip
        # /v2 and hand the app paths it does not serve - a 404 that reads as a
        # broken container.
        #
        # The app owns its own locale negotiation: /v2/sign-in with
        # Accept-Language: he answers 307 -> /v2/he/sign-in. A rewrite here would
        # have pinned one language for a bilingual product, which is why there is
        # no rewrite here.
        # ════════════════════════════════════════════════════════════════════
        # ★★ THE FLOW EXECUTOR, FIRST-PARTY - SO THE PASSWORD NEVER ENTERS NODE
        # ════════════════════════════════════════════════════════════════════
        # /v2 serves its own sign-in panel and drives Authentik's flow executor
        # directly. The password therefore travels:
        #
        #     browser -> THIS PROXY -> authentik_server
        #
        # and **not** through the Next.js application. That is the whole
        # security argument for building our own login, and it only holds while
        # this stays an nginx location: a Next route handler or a server action
        # here would put our own process in the credential path.
        #
        # It adds no new exposure, because this same gateway already fronts
        # `auth-dev.gotcha.co.il` further down this file - every password typed
        # on the IdP's own page already crosses this proxy today.
        #
        # ★ SAME-ORIGIN RATHER THAN CORS, DELIBERATELY. A preflight from
        #   https://dev.gotcha.co.il to the executor returns 200 with NO
        #   `Access-Control-Allow-Origin` at all, so a cross-origin fetch is
        #   blocked. The fix for that would be loosening CORS on the identity
        #   provider to accept credentialed cross-site calls - exactly the wrong
        #   direction. Proxied under our own origin, no CORS is involved.
        #
        # ★ `Host` IS THE IdP'S OWN NAME, NOT $host. Authentik is a Django app
        #   and checks Origin/Referer against its trusted origins; handing it a
        #   host it does not expect is how this fails. The session cookie is
        #   unaffected either way because `AUTHENTIK_COOKIE_DOMAIN=gotcha.co.il`
        #   is now set, so one cookie is valid on both names - which is the
        #   change that made this whole approach possible.
        #
        # ★ NOTHING REWRITES COOKIES. `Set-Cookie` and `Cookie` pass untouched
        #   in both directions. A proxy that drops `Set-Cookie` breaks the CSRF
        #   token and the failure looks EXACTLY like a wrong password, which
        #   sends whoever debugs it to the wrong layer entirely.
        #
        # Longest-prefix wins among `^~` locations, so this takes precedence
        # over `^~ /v2` below regardless of the order they appear in.
        location ^~ /v2/auth-api/ {
            proxy_pass http://authentik_server/api/v3/;
            # ★★ THE EXECUTOR REDIRECTS TO ITS OWN ROOT, AND THAT IS NOT OURS.
            #
            # Posting a stage answers `302 Location: /api/v3/flows/executor/...`
            # - an ABSOLUTE path, which the browser resolves against OUR origin
            # and which therefore lands on the Next app instead of this proxy.
            # Measured: the follow-up returned Next's 404 HTML page, which the
            # panel would have read as a broken stage rather than a routing
            # mistake.
            #
            # Same defect class as our own sign-in button earlier today: an
            # absolute path written by something that assumes it is mounted at
            # the root. There it was ours to fix in the href; here it is the
            # IdP's assumption and the rewrite belongs at the proxy.
            proxy_redirect /api/v3/ /v2/auth-api/;
            proxy_http_version 1.1;
            proxy_set_header Host auth-dev.gotcha.co.il;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host $host;
            # Same budget as the IdP's own location further down this file.
            limit_req zone=authentik burst=40 nodelay;
        }

        location ^~ /v2 {
            proxy_pass http://frontend_v2;
            proxy_http_version 1.1;
            # Socket.IO does not arrive here - the browser connects to
            # /socket.io/ at the root, which is the platform's own service and
            # already routed above. This upgrade is for Next's own streaming.
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ─── Frontend (catch-all) ────────────────────────
        location / {
            proxy_pass http://frontend;
            # WebSocket upgrade so Next.js dev HMR (/_next/webpack-hmr) works.
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # ── Identity Provider: auth-dev.gotcha.co.il → Authentik ──
    # Same shape as the prod vhost (gateway/nginx.prod.conf.template) so a
    # working dev login proves the prod path, not a different one.
    #
    # `localhost` is also accepted so the compose port publish
    # (AUTHENTIK_PORT:9000) keeps working for local bootstrap scripts that
    # predate this vhost.
    server {
        listen 80;
        server_name auth-dev.gotcha.co.il;

        # ════════════════════════════════════════════════════════════════════
        # ★★ THE SIGN-IN SCREEN - AND THIS BLOCK IS A SECURITY CONTROL
        # ════════════════════════════════════════════════════════════════════
        # `frontend_auth` is the WHOLE application, root-mounted. It serves
        # /inbox, /en/home, /en/settings/billing and every other product route
        # exactly as the product does. **Nothing in the image keeps them off
        # this origin. This allowlist is the only thing that does.**
        #
        # So this is not routing, and it is not reviewed as routing: adding a
        # prefix here exposes a product surface on the origin that exists to
        # contain only a password field. The whole point of the separate origin
        # is that an XSS anywhere in the product cannot reach this page; a
        # product route served here puts the product back.
        #
        # ★ ONLY THESE PREFIXES. Everything else falls through to `location /`
        #   below, which is Authentik - so an unlisted product route gets the
        #   IdP's 404, not ours, and never a redirect back to the product.
        #
        # ⚠ A REDIRECT WOULD ALSO SATISFY "not 200". The test asserts the
        #   status AND that nothing 3xx's across to dev.gotcha.co.il, because a
        #   guard that merely fails to serve is one config line from leaking.
        # ★★ AND THE LOCALE-PREFIXED FORM, WHICH THE FIRST ALLOWLIST MISSED.
        #
        # `/sign-in` answers 307 to `/en/sign-in` - next-intl negotiating, not
        # us. That target does NOT start with `/sign-in`, so it fell through to
        # Authentik and the whole screen 404'd behind a redirect that looked
        # fine. **The allowlist was correct about the path it was given and
        # wrong about the one the app actually serves.**
        #
        # ⚠ A REGEX HERE, AND THE BOUNDARY IS THE POINT. `(/|$)` is what stops
        #   this matching `/en/sign-inbox`, and naming the locales explicitly is
        #   what stops it becoming `/en/` - which would put the entire product
        #   on this origin and silently undo the isolation this vhost exists
        #   for. Anything looser than this is the leak.
        #
        # Regex locations are evaluated before the `location /` prefix below,
        # so this wins over the Authentik catch-all without `^~`.
        #
        # ★★ A LIST, NOT A NAME. This alternation is the THIRD refusal of the
        #   recovery screen, one per layer, and each was invisible behind the
        #   next: the flow contract refused the stage, the app's own
        #   PUBLIC_PATH_PATTERN refused the route, and this refused the path.
        #   Fixing either of the first two changed nothing a visitor could see.
        #
        # ⚠ So when a screen is added to the sign-in surface it must be added
        #   HERE TOO. The app enumerates its (auth) route directory and fails
        #   its own test if a screen exists that its list does not permit;
        #   nginx cannot read that directory, so this line is the copy that
        #   drifts. Measured before this change: app=200, edge=404.
        location ~ ^/(en|he)/(sign-in|recover)(/|$) {
            proxy_pass http://frontend_auth;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Internal-Key    "";
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # The un-prefixed forms, which the app answers with a 307 into the
        # negotiated locale. Both surfaces need one.
        location ^~ /sign-in {
            proxy_pass http://frontend_auth;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Internal-Key    "";
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location ^~ /recover {
            proxy_pass http://frontend_auth;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Internal-Key    "";
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # The bundle. Content-hashed names, and the sign-in page references only
        # its own chunks - measured: no route manifest lists the product's
        # pages, so this exposes assets rather than a map of the application.
        location ^~ /_next/ {
            proxy_pass http://frontend_auth;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Internal-Key    "";
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        client_max_body_size 50m;

        # ── Security headers (H-5) ── Authentik manages its own CSP and
        # framing policy; only the universally-safe baseline is added here.
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # The GOTCHA theme sheet: fetched by Authentik's JS and injected into
        # every shadow root. It carries no cache-buster (Authentik builds the
        # URL), and the CDN once pinned a stale copy for hours - users saw the
        # stock Authentik look until the edge cache expired. Force revalidation
        # so a theme change is live on the next page load.
        # ★★ THE TAB ICON. Omer asked why the auth tab has none.
        #
        # The app serves them - `app/icon.svg` and `app/apple-icon.png` answer
        # 200 when asked directly - and the page declares both in <head>. They
        # 404 at the edge because THIS allowlist does not name them, so they
        # fall through to `location /` and Authentik answers instead.
        #
        # ★ Same shape as when this list allowed `/sign-in` against an app that
        #   replies `307 /en/sign-in`: **an allowlist is correct about what it
        #   lists and silent about what it does not.** That silence is the point
        #   of the list on a credential origin, and it is also its failure mode.
        #
        # ⚠ A BROWSER PROBE CANNOT FIND THIS. A page-load capture reported 33
        #   requests and 0 failures, because the favicon is fetched by the
        #   browser's chrome, not by the document - headless skips it entirely.
        #   Only a direct request, or a person looking at the tab, can see it.
        #
        # Exact matches: Next appends a cache-busting query (`?icon.<hash>.svg`)
        # which `location =` ignores, and neither name can shadow anything else.
        location = /icon.svg {
            proxy_pass http://frontend_auth;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $public_proto;
        }

        location = /apple-icon.png {
            proxy_pass http://frontend_auth;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $public_proto;
        }

        location = /static/dist/custom.css {
            proxy_pass http://authentik_server;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Forwarded-Proto $public_proto;
            proxy_hide_header Cache-Control;
            proxy_hide_header Expires;
            add_header Cache-Control "no-cache, must-revalidate" always;
        }

        # ★★ THE ROOT OF THIS ORIGIN IS OUR SIGN-IN SCREEN, NOT THE IdP's.
        #
        # `location /` below hands everything unmatched to Authentik, which is
        # correct for `/if/flow/`, `/application/o/authorize/` and `/api/v3/` -
        # the OIDC hops need it. But it also meant that typing the bare host
        # `auth-dev.gotcha.co.il` returned **Authentik's own purple login page**,
        # on the origin whose entire purpose is to serve the screen we designed.
        #
        # ★ Measured in a clean browser, one door at a time:
        #     /v2, /v2/en/inbox, /en/sign-in  ->  our panel
        #     /  and  /v2/api/auth/login      ->  Authentik's /if/flow/ UI
        #
        # ⚠ `= /` AND NOT A PREFIX. An exact-match location beats the `/` prefix
        #   for the root alone and touches nothing else - a prefix here would
        #   swallow `/if/flow/` and `/application/o/authorize/` and break every
        #   sign-in, since those are the hops the flow itself redirects through.
        #
        # ★ 302 rather than 301: this is a routing decision we may revisit, and
        #   a permanent redirect would be cached in browsers that saw it once,
        #   outliving the config that produced it.
        #
        # ⚠⚠ ABSOLUTE, AND BUILT FROM `$public_proto` - NOT `return 302 /sign-in`.
        #   A relative target makes nginx synthesise the absolute URL from
        #   `$scheme`, and **TLS terminates upstream of this container, so
        #   `$scheme` is "http" here** - the map at the top of this file exists
        #   to say so. The first version of this block sent
        #   `302 -> http://auth-dev.gotcha.co.il/sign-in`: a plaintext hop, on
        #   the one origin that exists to carry passwords. It looked correct in
        #   a browser, because the port-80 vhost bounces it back to https.
        location = / {
            return 302 $public_proto://$host/sign-in;
        }

        location / {
            limit_req zone=authentik burst=40 nodelay;

            proxy_pass http://authentik_server;
            proxy_http_version 1.1;

            # Host + proto drive Authentik's absolute URLs and the OIDC `iss`
            # claim. Get these wrong and every issued token 401s.
            proxy_set_header Host              $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $public_proto;
            proxy_set_header X-Forwarded-Host  $host;

            # Allow the GOTCHA app to EMBED Authentik flows (MFA / password /
            # passkey setup) in an in-app modal so identity management feels
            # native. Authentik sends X-Frame-Options: DENY, which blocks all
            # framing; strip it and instead scope framing to gotcha.co.il via a
            # CSP frame-ancestors allowlist (still blocks external clickjacking).
            # add_header here cancels server-scope inheritance, so the baseline
            # headers are repeated.
            proxy_hide_header X-Frame-Options;
            add_header X-Content-Type-Options "nosniff" always;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            add_header Content-Security-Policy "frame-ancestors 'self' https://*.gotcha.co.il" always;

            # Inject the GOTCHA enhancements into every Authentik page (it has
            # no custom-JS hook): a preboot "curtain" (inline style + script)
            # that hides FLOW pages behind a white overlay + spinner until the
            # GOTCHA theme has painted - the theme (custom.css) is injected
            # into shadow roots by Authentik's JS AFTER boot, so without the
            # curtain the stock Authentik UI flashes first - and the enhance
            # script (password eye, OTP boxes, password checklist), which also
            # lifts the curtain the moment the theme lands. The curtain is
            # fail-open: only /if/flow/* pages are covered (never the admin /
            # user portals) and the inline snippet self-lifts after 6s even if
            # every external asset fails. No single quotes in the payload -
            # the sub_filter value is single-quoted.
            # Disable upstream compression so sub_filter can rewrite the body.
            proxy_set_header Accept-Encoding "";
            sub_filter_once on;
            sub_filter_types text/html;
            sub_filter '</head>' '<style>html.gotcha-preboot body{visibility:hidden!important}html.gotcha-preboot::before{content:"";position:fixed;inset:0;background:#fff;z-index:9999}html.gotcha-preboot::after{content:"";position:fixed;top:50%;left:50%;width:28px;height:28px;margin:-14px 0 0 -14px;border:3px solid rgba(124,92,252,.25);border-top-color:#7c5cfc;border-radius:50%;animation:gotchaspin .8s linear infinite;z-index:10000}@keyframes gotchaspin{to{transform:rotate(360deg)}}</style><script>(function(){if(location.pathname.indexOf("/if/flow/")===0){var h=document.documentElement;h.classList.add("gotcha-preboot");setTimeout(function(){h.classList.remove("gotcha-preboot")},6000)}})()</script><script src="/static/dist/assets/custom/authentik-enhance.js?v=12" defer></script></head>';

            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            proxy_buffering off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }
    }

    # ── Help Center: help.gotcha.co.il → the frontend's /help section ──
    # The public knowledge base rides the main Next.js app (no extra service);
    # this vhost maps the subdomain root onto /help while passing Next.js
    # assets straight through.
    server {
        listen 80;
        server_name help.gotcha.co.il help.dev.gotcha.co.il;

        # ── Security headers (H-5) ──────────────────────────────
        # Emitted at server scope; repeated inside any location that declares
        # its own add_header (nginx add_header inheritance stops there).
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Permissions-Policy "camera=(), geolocation=(), payment=()" always;
        # CSP: blast-radius cap for XSS. unsafe-inline/eval are required by the
        # Next.js static export today; tightening to nonces is a follow-up.
        # frame-ancestors 'self' (embedded chat is a script widget, not an
        # iframe of this origin, so it is unaffected).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; object-src 'none'; frame-src 'self' https://*.gotcha.co.il; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:" always;

        # Next.js internals + shared static assets - no rewrite (regex wins
        # over the prefix locations below).
        location ~ ^/(_next|favicon\.ico|logo[^/]*\.png|apple-touch-icon\.png|icons/|images/) {
            proxy_pass http://frontend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # In-page links already carry the /help prefix - pass through as-is.
        location /help {
            proxy_pass http://frontend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # The bare root maps to /help exactly (no trailing slash, so Next
        # serves it directly instead of 308-redirecting /help/ → /help).
        location = / {
            rewrite ^ /help break;
            proxy_pass http://frontend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Everything else lands on the help section.
        location / {
            rewrite ^/(.*)$ /help/$1 break;
            proxy_pass http://frontend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Internal-Key "";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
