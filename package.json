{
  "name": "chatcenter",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "db:generate": "npm run db:generate -w @chatcenter/shared",
    "db:migrate": "npm run db:migrate -w @chatcenter/shared",
    "db:seed": "npm run db:seed -w @chatcenter/shared",
    "db:reset": "npm run db:reset -w @chatcenter/shared",
    "dev": "docker compose up -d db redis && npm run dev --workspaces --if-present",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "nodemailer": "^8.0.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.11"
  }
}
