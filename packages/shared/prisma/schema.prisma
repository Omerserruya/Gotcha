generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Channel Types ───────────────────────────────────────────

enum ChannelType {
  WHATSAPP
  MESSENGER
  INSTAGRAM
  EMAIL
  GMAIL
  OUTLOOK
  SLACK
  VOICE
  WEBCHAT
}

enum ChannelConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum BotFlowMode {
  UNIFIED
  PER_CHANNEL
}

enum ChannelResponseMode {
  HUMAN_WITH_COPILOT
  AI_AUTO_REPLY
}

// ─── Tenant Status & AI Mode ────────────────────────────────

enum TenantStatus {
  PENDING_ADMIN_SETUP
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
}

enum BotType {
  CHATBOT_FLOW
  AUTONOMOUS_AI
}

enum BusinessPriority {
  MAXIMIZE_SALES
  FAST_RESPONSE
  PREMIUM_EXPERIENCE
  REDUCE_WORKLOAD
}

enum OnboardingStep {
  BUSINESS_PROFILE
  DEPARTMENTS
  AI_CONFIG
  COMPLETED
}

// ─── Multi-Tenant ────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(PENDING_ADMIN_SETUP)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // ISO-3166-1 alpha-2 country code used to normalize bare phone numbers
  // (e.g. "0501234567" without a leading "+") into E.164 before they're
  // stored as a broadcast recipient externalId or sent through the
  // outbound pipeline. Default "IL" matches the launch market.
  defaultCountryCode String @default("IL") @map("default_country_code")

  // System language - applies to the dashboard UI, AI-generated content
  // (customer briefs, conversation summaries, voice-copilot insights,
  // post-call QA), and CRM-side LLM writes. Per-agent overrides live on
  // `User.locale` so an agent can pick their own UI/AI language without
  // affecting the rest of the org. ISO-639-1; today: "en" | "he".
  defaultLocale String @default("en") @map("default_locale")

  // Multi-factor authentication policy (set by a TENANT ADMIN in
  // Workspace -> Security). Both default OFF so every existing/new tenant is
  // unchanged until an admin opts in. Enforcement is hierarchical and lives in
  // GOTCHA (not Authentik's shared login flow): SYSTEM_ADMIN always requires
  // MFA regardless of these flags; ADMINs require it when either flag is on;
  // AGENTs require it only when mfaRequiredForAllUsers is on. See
  // `mfaRequirementFor` in @chatcenter/shared and the account /mfa-gate route.
  mfaRequiredForAdmins   Boolean @default(false) @map("mfa_required_for_admins")
  mfaRequiredForAllUsers Boolean @default(false) @map("mfa_required_for_all_users")

  // Feature flags (set by SYSTEM_ADMIN)
  botEnabled           Boolean  @default(false) @map("bot_enabled")
  botType              BotType? @map("bot_type")
  firstTakeCareEnabled Boolean  @default(false) @map("first_take_care_enabled")

  // Live Call CoPilot - Phase 1 feature flags (all default off; existing
  // tenants behave byte-identical to today until SYSTEM_ADMIN flips these).
  //   voiceCopilotEnabled  - master kill switch for every new Phase-1 path
  //   voiceInboxUiEnabled  - renders LiveCallsSection + banner + active-call bar
  //   voiceIncomingEnabled - accepts inbound webhooks for tenant's BYO channels
  voiceCopilotEnabled  Boolean @default(false) @map("voice_copilot_enabled")
  voiceInboxUiEnabled  Boolean @default(false) @map("voice_inbox_ui_enabled")
  voiceIncomingEnabled Boolean @default(false) @map("voice_incoming_enabled")

  // Routing fallback ladder - used when no RouterRule matches an inbound.
  // Resolution order: defaultAgentId → defaultRoutineId → defaultDepartmentId → unassigned.
  defaultAgentId      String? @map("default_agent_id")
  defaultRoutineId    String? @map("default_routine_id")
  defaultDepartmentId String? @map("default_department_id")

  // Human-handoff behaviour. null = never resume bot after a human unclaims.
  // Integer N = resume AUTO mode after N idle minutes since last human touch.
  autoResumeAfterUnclaimMinutes Int? @map("auto_resume_after_unclaim_minutes")

  users                   User[]
  conversations           Conversation[]
  messages                Message[]
  chatbotFlows            ChatbotFlow[]
  channelAccounts         ChannelAccount[]
  channelConfig           TenantChannelConfig?
  departments             Department[]
  departmentMembers       DepartmentMember[]
  businessProfile         BusinessProfile?
  businessDiscovery       BusinessDiscovery?
  scheduledNudges         ScheduledNudge[]
  recommendations         Recommendation[]
  onboarding              TenantOnboarding?
  knowledgeBases          KnowledgeBase[]
  aiAgents                AIAgent[]
  routerRules             RouterRule[]
  contacts                Contact[]
  messageTemplates        MessageTemplate[]
  broadcasts              Broadcast[]
  scheduledMessages       ScheduledMessage[]
  flowCanvas              FlowCanvas?
  notificationPreferences NotificationPreference[]
  inAppNotifications      InAppNotification[]
  voiceCallSessions       VoiceCallSession[]
  callAnalyses            CallAnalysis[]
  callPlaybooks           CallPlaybook[]
  missingFieldDefinitions MissingFieldDefinition[]
  toolExecutionRequests   ToolExecutionRequest[]
  communicationChannels   CommunicationChannel[]
  agentPresences          AgentPresence[]
  tenantFeatures          TenantFeature[]
  tenantRoles             TenantRole[]
  invites                 TenantInvite[]
  webhookTriggers         WebhookTrigger[]
  // Billing & AI Units. The MONEY side (subscription/profile/invoices) binds to
  // a BillableEntity, NOT directly to a tenant - see BillableEntityTenant. The
  // WALLET + ENTITLEMENT side stays tenant-scoped (a tenant consumes capability
  // and AI Units). In V1 these are 1:1; the abstraction lets them diverge later.
  billableEntityLink      BillableEntityTenant?
  aiUnitLots              AiUnitLot[]
  aiUnitLedger            AiUnitLedgerEntry[]
  aiBalance               TenantAiBalance?
  tenantEntitlements      TenantEntitlement[]
  // GDPR data-lifecycle machinery.
  consentRecords          ConsentRecord[]
  retentionPolicies       DataRetentionPolicy[]
  dataSubjectRequests     DataSubjectRequest[]
  approvalRecipients      ApprovalRecipient[]

  @@index([status])
  @@map("tenants")
}

// ─── GDPR: Consent Records (Art. 6/7) ──────────────────────────
// Proof-of-consent ledger. Append-only: a withdrawal is a NEW row with
// granted=false, never a mutation of the prior grant, so the full consent
// history is auditable. `subjectType`+`subjectId` identify who consented
// (a Contact, a User, or a raw identifier like an email/phone captured
// before a Contact row exists). `purpose` is the processing purpose
// (e.g. "marketing_whatsapp", "cookies_functional", "data_processing").
model ConsentRecord {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  subjectType String   @map("subject_type") // "contact" | "user" | "identifier"
  subjectId   String   @map("subject_id") // Contact.id | User.id | raw email/phone
  purpose     String // "marketing_whatsapp" | "cookies_functional" | "data_processing" | ...
  granted     Boolean // true = consent given, false = withdrawn
  source      String? // "onboarding" | "widget" | "import" | "api" | ...
  evidence    Json? // { ip, userAgent, capturedText, channel, ... } - proof of consent
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, purpose])
  @@map("consent_records")
}

// ─── GDPR: Data Retention Policies (Art. 5(1)(e)) ──────────────
// Per-tenant retention windows. A purge job reads the ACTIVE policy for a
// given data category and hard-deletes rows older than `retentionDays`.
// One row per (tenantId, category); NULL/absent = no limit (grows unbounded,
// which is the pre-GDPR default we are closing).
model DataRetentionPolicy {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  category      String // "messages" | "usage_logs" | "audit_logs" | "billing_webhook_events" | "reasoner_shadow_evals" | ...
  retentionDays Int       @map("retention_days") // rows older than now()-retentionDays are purged
  enabled       Boolean   @default(true)
  lastPurgeAt   DateTime? @map("last_purge_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category])
  @@index([tenantId])
  @@map("data_retention_policies")
}

// ─── GDPR: Data Subject Requests (Art. 15/17/20/30) ────────────
// Tracks every access/portability/erasure request and its execution, so
// the platform can prove (Art. 30 record of processing) that a DSR was
// received and fulfilled, and within what window.
model DataSubjectRequest {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  requestType String    @map("request_type") // "export" | "erasure"
  subjectType String    @map("subject_type") // "contact" | "user" | "tenant"
  subjectId   String    @map("subject_id")
  status      String    @default("PENDING") // "PENDING" | "COMPLETED" | "FAILED"
  requestedBy String?   @map("requested_by") // userId who initiated (null = self-service)
  result      Json? // summary of what was exported/erased (counts per store)
  error       String? // failure reason when status=FAILED
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, requestType])
  @@index([tenantId, subjectType, subjectId])
  @@map("data_subject_requests")
}

// ─── Channel Accounts ────────────────────────────────────────

model ChannelAccount {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  channel     ChannelType
  externalId  String      @map("external_id") // WA phone_number_id, FB page_id, or IG business_id
  displayName String      @map("display_name")
  credentials Json        @default("{}") // { accessToken, appSecret, ... }
  isActive    Boolean     @default(true) @map("is_active")

  // Per-channel response mode (for email channels: GMAIL, OUTLOOK)
  responseMode ChannelResponseMode @default(HUMAN_WITH_COPILOT) @map("response_mode")

  // Connection lifecycle
  connectionStatus ChannelConnectionStatus @default(CONNECTED) @map("connection_status")
  connectedAt      DateTime?               @map("connected_at")
  connectedBy      String?                 @map("connected_by") // userId who connected
  tokenExpiresAt   DateTime?               @map("token_expires_at")
  platformMeta     Json?                   @map("platform_meta") // platform-specific metadata
  lastError        String?                 @map("last_error")
  lastHealthCheck  DateTime?               @map("last_health_check")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  templates     MessageTemplate[]

  @@unique([channel, externalId])
  @@index([tenantId])
  @@index([connectionStatus])
  @@index([tokenExpiresAt])
  @@map("channel_accounts")
}

// ─── Tenant Channel Config ───────────────────────────────────

model TenantChannelConfig {
  id          String      @id @default(cuid())
  tenantId    String      @unique @map("tenant_id")
  botFlowMode BotFlowMode @default(UNIFIED) @map("bot_flow_mode")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_channel_configs")
}

// ─── Department Enums ────────────────────────────────────────

enum DepartmentRole {
  AGENT
  MANAGER
}

enum DepartmentQueueMode {
  CLAIM
  ROUND_ROBIN
}

enum CopilotMode {
  READY_MESSAGE
  CONTEXT_ONLY
}

// ─── Auth & RBAC ─────────────────────────────────────────────

enum Role {
  SYSTEM_ADMIN
  ADMIN
  AGENT
}

// Data-reach dimension, INDEPENDENT of which permissions a role holds.
// Carried on the role (defaultScope) and optionally overridden per
// assignment. Future "Team Leader" vs "Department Manager" differ only here.
// See packages/shared/src/lib/permission-catalog.ts (SCOPE_ORDER).
enum PermissionScope {
  OWN
  TEAM
  DEPARTMENT
  WORKSPACE
}

// ─── Identity (the PERSON, cross-tenant) ─────────────────────
// One row per human being, joined to Authentik by `authentikSubject` (the
// OIDC `sub` claim). GOTCHA stores no credentials of any kind: authentication,
// passwords, MFA, and sessions all live in Authentik. An Identity owns any
// number of tenant MEMBERSHIPS (User rows) - the same person can work in
// unlimited tenants, with a different role/department/permissions in each.
//
//   Identity  ──1:N──▶  User (membership in ONE tenant)
//
// Identity-level truth lives here (subject, canonical email/name, MFA
// enrolment stamp); everything tenant-scoped stays on the membership row.
model Identity {
  id               String    @id @default(cuid())
  // Authentik's immutable user UUID (sub_mode=user_uuid). Nullable only for
  // the window between "invited" and "identity provisioned" - in practice
  // ensureIdentity() binds it at invite time.
  authentikSubject String?   @unique @map("authentik_subject")
  // Canonical email, lowercased. Authentik pins username to this; membership
  // rows carry a per-tenant display mirror that is synced from here.
  email            String    @unique
  name             String
  // Identity-level MFA enrolment mirror (an authenticator AND recovery codes
  // exist in Authentik). MFA is a property of the PERSON, not of any one
  // tenant membership - stamped by the account /mfa-gate check and the
  // tenant-security backfill.
  mfaEnrolledAt    DateTime? @map("mfa_enrolled_at")
  // Last tenant this identity actively used - the default the tenant picker
  // preselects and the tenant a hint-less API call resolves to. Soft
  // reference (no FK): a deleted tenant must not break the identity.
  lastTenantId     String?   @map("last_tenant_id")
  // Global session generation for this Identity. The BFF app-session migration
  // (docs/security/bff-session-migration-map.md) snapshots this onto every
  // UserSession at creation; a bump here (logout-all, credential/MFA reset,
  // identity disabled, forced re-auth) makes every session with an older
  // snapshot invalid - the "global reauthentication" mechanism. Additive and
  // inert until cookie sessions are enabled by feature flag.
  sessionVersion   Int       @default(0) @map("session_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  memberships User[]
  sessions    UserSession[]

  @@map("identities")
}

/// Server-side application session for the BFF/HttpOnly-cookie auth model.
/// The browser holds only an opaque random identifier in an HttpOnly cookie;
/// the raw value is NEVER stored - only its SHA-256 hash (sessionTokenHash) is,
/// so a database leak does not yield forgeable cookies. OIDC access/refresh
/// tokens live here encrypted with SESSION_ENCRYPTION_KEY (see
/// lib/session-crypto.ts), never in plaintext and never in the browser.
/// A session belongs to an IDENTITY, not a tenant; the active tenant is
/// resolved through activeMembership (a per-tenant User row), never a raw
/// tenantId. Additive infrastructure: no runtime path reads this until the
/// cookie feature flags are enabled in a later commit.
model UserSession {
  id String @id @default(cuid())

  // Ownership: the Identity this session authenticates. Global re-auth compares
  // sessionVersion against Identity.sessionVersion.
  identityId     String @map("identity_id")
  sessionVersion Int    @default(0) @map("session_version")

  // Active membership = the per-tenant User row this session currently acts as.
  // Nullable: a multi-workspace identity with no selection yet is gated behind
  // the tenant picker. SetNull on membership delete forces re-selection rather
  // than leaving a dangling tenant reference (never coupled directly to Tenant).
  activeMembershipId String? @map("active_membership_id")

  // Lookup key: SHA-256 of the opaque cookie identifier. Unique + indexed.
  // The raw identifier is never persisted or logged.
  sessionTokenHash String @unique @map("session_token_hash")

  // Provider tokens, sealed by lib/session-crypto (AES-256-GCM, versioned,
  // AAD-bound to purpose + owner). Never plaintext.
  encryptedAccessToken  String    @map("encrypted_access_token")
  encryptedRefreshToken String?   @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  oidcSessionId         String?   @map("oidc_session_id")

  // CSRF binding secret (double-submit HMAC). Server-side only; never sent to
  // the browser and never logged.
  csrfSecret String @map("csrf_secret")

  // Lifecycle.
  rememberMe       Boolean   @default(false) @map("remember_me")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revocationReason String?   @map("revocation_reason")

  // Session metadata for the session-list UI + audit (no secrets). IP is stored
  // as a salted hash only where retained, never raw.
  browser         String?
  device          String?
  operatingSystem String? @map("operating_system")
  userAgentHash   String? @map("user_agent_hash")
  ipHash          String? @map("ip_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  identity         Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  activeMembership User?    @relation("ActiveMembershipSessions", fields: [activeMembershipId], references: [id], onDelete: SetNull)

  // sessionTokenHash is already uniquely indexed (cookie -> hash -> record).
  @@index([identityId]) // identity session listing + global invalidation
  @@index([identityId, sessionVersion]) // stale-version invalidation
  @@index([activeMembershipId]) // membership-context invalidation
  @@index([expiresAt]) // expiry cleanup
  @@index([revokedAt]) // revocation queries
  @@map("user_sessions")
}

// A User row is ONE TENANT MEMBERSHIP of an Identity: the person's role,
// department, permissions, feature grants, and activity inside that single
// tenant. All business authorization keys off this row; the Identity above
// only answers "who is this person".
model User {
  id                       String    @id @default(cuid())
  tenantId                 String    @map("tenant_id")
  // The person this membership belongs to. Everything Authentik-related is
  // resolved through this relation - the membership row itself never talks
  // to the IdP.
  identityId               String    @map("identity_id")
  // Per-tenant display mirror of Identity.email/name (kept in sync by the
  // profile/email-change flows). Reads all over the codebase use these; the
  // Identity row is the source of truth.
  email                    String
  name                     String
  role                     Role      @default(AGENT)
  isActive                 Boolean   @default(true) @map("is_active")
  notificationSoundEnabled Boolean   @default(true) @map("notification_sound_enabled")
  // E.164 personal/mobile number. Used for FORWARD_TO_AGENT inbound mode
  // and smart-callback recognition (when the agent calls the business
  // number back from this device, we identify them by `From === phoneNumber`).
  phoneNumber              String?   @map("phone_number")
  // Per-agent system-language override. NULL means "inherit from
  // `Tenant.defaultLocale`". Drives both UI strings and all AI-generated
  // content the agent consumes. ISO-639-1; today: "en" | "he".
  locale                   String?   @map("locale")
  // Per-feature first-time guidance state for the persistent onboarding
  // layer. Map of feature key -> "unseen" | "snoozed" | "done", e.g.
  // {"knowledge":"done","ai-studio":"snoozed"}. NULL = nothing seen yet.
  onboardingGuides         Json?     @map("onboarding_guides")
  // When this MEMBERSHIP was last actively used (stamped on authenticated
  // requests, throttled). Drives the tenant picker's "last used" ordering and
  // the default-tenant resolution for hint-less API calls.
  lastActiveAt             DateTime? @map("last_active_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  identity                Identity             @relation(fields: [identityId], references: [id], onDelete: Cascade)
  // Sessions currently acting as THIS membership (BFF app-session model). Used
  // for membership-context invalidation when a membership is suspended/removed.
  activeSessions          UserSession[]        @relation("ActiveMembershipSessions")
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations           Conversation[]       @relation("AssignedAgent")
  departmentMembers       DepartmentMember[]
  inAppNotifications      InAppNotification[]
  // Voice channels where this user is the default-ring target for inbound calls.
  defaultVoiceChannels    VoiceChannel[]       @relation("VoiceChannelDefaultAgent")
  // Voice channels where this user is the AGENT_FIRST outbound target
  // (separate from the inbound default agent so outbound can route to a
  // different person - e.g. sales rep for outbound, support rep for inbound).
  agentFirstVoiceChannels VoiceChannel[]       @relation("VoiceChannelAgentFirstAgent")
  roleAssignments         UserRoleAssignment[]
  featureGrants           UserFeatureGrant[]
  approvalRecipients      ApprovalRecipient[]

  @@unique([tenantId, email])
  // One membership per identity per tenant - the same person cannot hold two
  // accounts in one workspace, but CAN hold one in each of many workspaces.
  @@unique([tenantId, identityId])
  @@index([tenantId])
  @@index([identityId])
  @@map("users")
}

// ─── Conversations ───────────────────────────────────────────

enum ConversationStatus {
  OPEN
  WAITING
  CLOSED
}

model Conversation {
  id                 String             @id @default(cuid())
  tenantId           String             @map("tenant_id")
  channel            ChannelType        @default(WHATSAPP)
  channelAccountId   String?            @map("channel_account_id")
  customerExternalId String             @map("customer_external_id") // Phone (WA) or PSID (Messenger)
  customerName       String?            @map("customer_name")
  customerAvatarUrl  String?            @map("customer_avatar_url")
  assignedAgentId    String?            @map("assigned_agent_id")
  // AI agent assigned by the Main Playbook flow (route_target → "agent").
  // Resolved on first dispatch; subsequent inbound messages prefer this over
  // legacy RouterRule lookup so resume is deterministic.
  assignedAiAgentId  String?            @map("assigned_ai_agent_id")
  departmentId       String?            @map("department_id")
  status             ConversationStatus @default(OPEN)
  // Chatbot state tracking
  chatbotFlowId      String?            @map("chatbot_flow_id")
  chatbotNodeId      String?            @map("chatbot_node_id")
  // Per-conversation variable store populated by flow nodes (Collect Input,
  // Set Variable, HTTP Request, AI Generate, Bring User Data). Flat JSON
  // object: { "customer_email": "foo@bar.com", "http_response": {...}, ... }.
  // Interpolated into outbound Send* nodes via {{var_name}} syntax.
  flowVariables      Json?              @map("flow_variables")
  // Comment→DM bridge expiry. Set when a comment-trigger flow promotes itself
  // into a paused conversation (private-reply DM sent, awaiting the user's
  // reply). If the user doesn't reply within 24h, the bridge is dead - Meta
  // disallows further DMs in that thread (one-DM-per-comment policy). On
  // expiry the conversation is closed and the chatbot state cleared. Cleared
  // when the user replies within the window (the conversation graduates to a
  // normal DM and is no longer Meta-restricted).
  flowExpiresAt      DateTime?          @map("flow_expires_at")
  isHandedOver       Boolean            @default(false) @map("is_handed_over")
  handledBy          String?            @map("handled_by") // "ai_agent", "flow", "human", null (unrouted)
  lastMessageAt      DateTime?          @map("last_message_at")
  reminderSentAt     DateTime?          @map("reminder_sent_at")
  closedAt           DateTime?          @map("closed_at")
  aiSummary          String?            @map("ai_summary")
  // Detected language of the conversation thread - set once from the
  // first inbound message (heuristic + LLM fallback). Drives the
  // language of suggested-reply drafts and any other "match the
  // customer's language" content. System-language settings (tenant /
  // agent) override THIS for surfaces that should stay in the agent's
  // language (briefs, summaries, coaching).
  detectedLocale     String?            @map("detected_locale")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount   ChannelAccount?           @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  assignedAgent    User?                     @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  department       Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  chatbotFlow      ChatbotFlow?              @relation(fields: [chatbotFlowId], references: [id], onDelete: SetNull)
  messages         Message[]
  intelligence     ConversationIntelligence?
  voiceCallSession VoiceCallSession?
  callAnalysis     CallAnalysis?

  @@index([tenantId, status])
  @@index([tenantId, assignedAgentId])
  @@index([tenantId, assignedAiAgentId])
  @@index([tenantId, departmentId])
  @@index([tenantId, channel, customerExternalId])
  @@index([flowExpiresAt])
  @@map("conversations")
}

// ─── Messages ────────────────────────────────────────────────

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id                 String           @id @default(cuid())
  tenantId           String           @map("tenant_id")
  conversationId     String?          @map("conversation_id")
  channel            ChannelType?
  externalMessageId  String?          @map("external_message_id") // WA msg ID or Messenger mid
  direction          MessageDirection
  body               String
  messageType        String           @default("text") @map("message_type")
  status             MessageStatus    @default(PENDING)
  senderName         String?          @map("sender_name")
  metadata           Json?
  mediaUrl           String?          @map("media_url")
  fileName           String?          @map("file_name")
  broadcastId        String?          @map("broadcast_id") // link to originating broadcast
  scheduledMessageId String?          @map("scheduled_message_id") // link to originating scheduled msg
  errorMessage       String?          @map("error_message")
  deliveredAt        DateTime?        @map("delivered_at")
  readAt             DateTime?        @map("read_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([externalMessageId])
  @@index([tenantId])
  @@index([broadcastId])
  @@index([scheduledMessageId])
  @@map("messages")
}

// ─── AI Agent Status ─────────────────────────────────────────

enum AIAgentStatus {
  ACTIVE
  DRAFT
  PAUSED
}

// ─── AI Agents (AI Studio Team Members) ─────────────────────

model AIAgent {
  id                  String        @id @default(cuid())
  tenantId            String        @map("tenant_id")
  name                String
  role                String        @default("customer_support") // customer_support, sales, booking, billing, custom
  avatarColor         String        @default("#7c5cfc") @map("avatar_color")
  status              AIAgentStatus @default(DRAFT)
  // Creation-wizard progress. Set to "chat" when the builder creates the
  // DRAFT, advanced through chat→kb→refine→tools as the admin proceeds, and
  // cleared (null) once the agent is saved from the editor (= wizard done).
  // An INCOMPLETE wizard draft is `status=DRAFT AND builderStep IS NOT NULL`:
  // those are surfaced as "resume setup" and excluded from the active
  // employees list, so abandoned sessions never pollute the account.
  builderStep         String?       @map("builder_step")
  tone                String        @default("professional") // professional, friendly, casual, formal
  languages           Json          @default("{\"english\":true}") // { english: bool, hebrew: bool, arabic: bool }
  style               Json          @default("{}") // { useEmojis, concise, useFirstName, proactive }
  channels            Json          @default("[]") // ["whatsapp", "instagram", "webchat"]
  escalationRules     Json          @default("[]") @map("escalation_rules") // [{ label, type, value, enabled }]
  interactiveMessages Json          @default("{}") @map("interactive_messages") // { allowQuickReply, allowListMenu, ... }

  // LLM settings (inherited from CopilotConfig pattern)
  systemPrompt     String  @default("") @map("system_prompt")
  sharedPrompt     String? @map("shared_prompt")
  autonomousPrompt String? @map("autonomous_prompt")
  model            String  @default("gpt-5-mini")
  provider         String  @default("openai")
  temperature      Float   @default(0.7)
  maxTokens        Int     @default(1024) @map("max_tokens")

  // Persona configuration (gender-aware behavior, extensible)
  persona Json? // { gender: "male"|"female"|"neutral", traits: {}, customAttributes: {} }

  // Structured AI personality blocks
  identity   Json? // { role, responsibility, representationGuidelines[] }
  goals      Json? // { focus, slaAwareness, conversionObjective }  (legacy; superseded by `goal`/`successCriteria` columns)
  toneConfig Json? @map("tone_config") // { formalityLevel, empathyLevel, assertiveness }
  behavioral Json? // { escalationTriggers[], forbiddenActions[], safetyBoundaries[] }

  // Product Qualification Context (sales-oriented skills). Static per agent so
  // it is cache-safe in the prompt. Drives needs-vs-product qualification
  // instead of generic discovery.
  // { whatWeSell, idealCustomerProfile, problemsSolved[], expectedOutcomes[], qualificationSignals[], disqualifiers[] }
  salesContext Json? @map("sales_context")

  // Last readiness-test report (P1-5): persisted so the owner can re-view the
  // coverage result without re-running the LLM-costly generator each time.
  // { score, coverage[], gaps[], generatedAt }
  readinessReport Json? @map("readiness_report")

  // First-class goal + success criteria. Always rendered into the system
  // prompt by buildGoals() - so non-funnel agents (Support, Research)
  // have meaningful per-agent goal text. For Sales/SDR/Recruiting these
  // STACK with the funnel stage's goal; for Support/Research they ARE
  // the goal. Required at save time for Support/Research/Billing/Custom;
  // optional for Sales/SDR/Recruiting (funnel provides the goal there).
  goal            String? @db.Text
  successCriteria String? @map("success_criteria") @db.Text

  // Autonomous behavior settings
  maxAutonomousMessages Int    @default(10) @map("max_autonomous_messages")
  maxAutonomousMinutes  Int    @default(15) @map("max_autonomous_minutes")
  confidenceThreshold   Float  @default(0.6) @map("confidence_threshold")
  escalationMessage     String @default("Let me connect you with a team member who can help further.") @map("escalation_message")
  conversationFlow      Json?  @map("conversation_flow") // [{ step, action, details }] - autonomous mode conversation flow
  customGuardrails      Json?  @map("custom_guardrails") // string[] - user-defined guardrails appended to static ones

  // Mode capabilities - which runtime modes this agent may run in.
  // { auto: bool, assist: bool }. Both default true.
  capabilities Json @default("{\"auto\":true,\"assist\":true}") @map("capabilities")

  // Behavioral anchors - guidance, NOT executable logic.
  // [{ id, condition, intent, guidance }] - rendered into the system prompt.
  behavioralAnchors Json @default("[]") @map("behavioral_anchors")

  // Deterministic escalation gates (LLM-independent triggers).
  // [{ type: "max_messages"|"keyword"|"max_minutes", value, enabled }]
  // Differs from escalationRules (LLM-judged). Checked in evaluatePolicies()
  // pre-flight so the bot can't bypass them.
  escalationGates Json @default("[]") @map("escalation_gates")

  // Department this AI employee belongs to. NULL = tenant-wide agent (no
  // department binding). Used by the stage resolver to decide which funnel
  // applies, and by routing to find the agent for a department.
  departmentId String? @map("department_id")

  // Funnel this agent runs (TenantFunnel.id). NULL = fall through to
  // channel override → conversation department → tenant default.
  funnelId String? @map("funnel_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department     Department?        @relation("AIAgentDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  funnel         TenantFunnel?      @relation("AIAgentFunnel", fields: [funnelId], references: [id], onDelete: SetNull)
  knowledgeBases AIAgentKnowledge[]
  routerRules    RouterRule[]       @relation("RouterRuleAIAgent")
  voiceChannels  VoiceChannel[]     @relation("VoiceChannelAIAgent")

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, funnelId])
  @@map("ai_agents")
}

// ─── AI Agent ↔ Knowledge Base (many-to-many) ───────────────

model AIAgentKnowledge {
  id              String   @id @default(cuid())
  aiAgentId       String   @map("ai_agent_id")
  knowledgeBaseId String   @map("knowledge_base_id")
  createdAt       DateTime @default(now()) @map("created_at")

  aiAgent       AIAgent       @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([aiAgentId, knowledgeBaseId])
  @@index([aiAgentId])
  @@index([knowledgeBaseId])
  @@map("ai_agent_knowledge")
}

// ─── Router Rules (Main Playbook) ───────────────────────────

enum RouterRuleRouteType {
  AI_AGENT
  FLOW
  HUMAN
  DEPARTMENT
}

model RouterRule {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  // Evaluation order within non-default rules. Default rules always evaluate last.
  // Lower position runs first. UI drag-to-reorder writes this field.
  position    Int                 @default(0)
  name        String
  conditions  Json                @default("[]") // [{ type: "intent"|"tag"|"keyword"|"channel", operator, value }]
  logic       String              @default("AND") // "AND" | "OR"
  routeType   RouterRuleRouteType @map("route_type")
  routeTarget String?             @map("route_target") // ID of target (aiAgentId, flowId, departmentId)
  aiAgentId   String?             @map("ai_agent_id") // populated when routeType = AI_AGENT
  enabled     Boolean             @default(true)
  isDefault   Boolean             @default(false) @map("is_default")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiAgent AIAgent? @relation("RouterRuleAIAgent", fields: [aiAgentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, enabled, position])
  @@map("router_rules")
}

// ─── Chatbot Flow Builder ────────────────────────────────────

model ChatbotFlow {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  name        String
  description String?
  isActive    Boolean      @default(false) @map("is_active")
  channel     ChannelType? // null = ALL channels
  trigger     String? // trigger condition description
  runCount    Int          @default(0) @map("run_count") // number of times this flow has been executed
  // JSON definition of the flow graph
  nodes       Json         @default("[]")
  edges       Json         @default("[]")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  // WebhookTrigger.workflowId references a flow here in "flow" mode, but is a
  // plain (un-FK'd) anchor - see that model - so there is no relation back-ref.

  @@index([tenantId, isActive])
  @@index([tenantId, channel, isActive])
  @@map("chatbot_flows")
}

// ─── Webhook Triggers ────────────────────────────────────────
//
// Lets a workflow (ChatbotFlow) be fired by an inbound HTTP call instead of
// the built-in trigger kinds (channel_entry / comment / keyword / schedule).
// Foundation for the custom-webhook-as-workflow-trigger feature - pure data
// model, no route/dispatch logic yet.
//
// The webhook runs the flow context-free (no conversation/customer). Customer
// resolution is a separate in-flow node, out of scope here.
//
// Security at this stage = an unguessable URL `token` (unique-indexed for O(1)
// lookup) plus a basic shared `secret` checked in a request header. No HMAC /
// IP allowlist yet.
model WebhookTrigger {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  // Anchor that provisions the URL and identifies this trigger's node on the
  // Main Playbook canvas. In "flow" mode it is a real ChatbotFlow id (validated
  // in app code, trigger-admin.ts). In "connected" mode it is the webhook_trigger
  // node's own canvas id - NOT a ChatbotFlow - so this is a plain (indexed)
  // string, not an FK relation. See the dropped FK in
  // migrations/20260604150000_webhook_trigger_drop_flow_fk.
  workflowId String   @map("workflow_id")
  token      String   @unique // unguessable path segment that identifies this trigger
  secret     String // shared secret expected in an inbound request header
  enabled    Boolean  @default(true)
  // What the inbound POST runs:
  //   "flow"      → run the associated ChatbotFlow (`workflowId`) - original behavior.
  //   "connected" → walk the nodes wired to this webhook trigger node on the
  //                 Main Playbook canvas (FlowCanvas), context-free.
  // The `workflowId` stays the anchor in both modes (it provisions the URL and
  // identifies which canvas node this trigger represents) - but only "flow" mode
  // requires it to be a real ChatbotFlow; "connected" mode anchors to the
  // trigger node's own canvas id.
  targetMode String   @default("flow") @map("target_mode")
  // User-declared shape of the inbound request body: [{ key, type }] where type
  // is "string" | "number" | "boolean". Lets the mapper (manual field binding)
  // offer a known set of source fields instead of free-text. Declaration ONLY -
  // inbound payloads are NOT validated/rejected against this. Defaults to [].
  bodySchema Json     @default("[]") @map("body_schema")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workflowId])
  @@map("webhook_triggers")
}

// ─── Departments ────────────────────────────────────────────

model Department {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  parentId    String?             @map("parent_id")
  name        String
  description String?
  queueMode   DepartmentQueueMode @default(CLAIM) @map("queue_mode")
  isActive    Boolean             @default(true) @map("is_active")

  // Working hours & SLA
  workingHours     Json? @map("working_hours") // { timezone, schedule: { monday: { enabled, open, close }, ... } }
  slaTarget        Int?  @map("sla_target") // Response SLA in minutes
  escalationPolicy Json? @map("escalation_policy") // { escalateOnBreach, escalateTo, maxWaitMinutes }

  // Automation settings
  autoGreetingEnabled  Boolean @default(false) @map("auto_greeting_enabled")
  autoGreetingMessage  String? @map("auto_greeting_message")
  autoCloseMinutes     Int?    @map("auto_close_minutes") // Auto-close after X inactivity minutes
  escalateOnSlaBreach  Boolean @default(false) @map("escalate_on_sla_breach")
  aiSuggestionsEnabled Boolean @default(true) @map("ai_suggestions_enabled")
  autoRepliesEnabled   Boolean @default(false) @map("auto_replies_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent                  Department?              @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                Department[]             @relation("DepartmentHierarchy")
  members                 DepartmentMember[]
  conversations           Conversation[]
  agentToolPermissions    AgentToolPermission[]
  funnels                 TenantFunnel[]
  notificationPreferences NotificationPreference[]
  aiAgents                AIAgent[]                @relation("AIAgentDepartment")
  // Voice channels that fall back to this department when the default agent
  // doesn't answer within the channel's ring timeout.
  voiceChannelFallback    VoiceChannel[]           @relation("VoiceChannelFallbackDept")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([parentId])
  @@map("departments")
}

model DepartmentMember {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  // NOT unique: a user can belong to SEVERAL departments (People & Teams
  // multi-department membership). Pair-uniqueness below prevents duplicates.
  userId         String         @map("user_id")
  departmentId   String         @map("department_id")
  departmentRole DepartmentRole @default(AGENT) @map("department_role")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@index([tenantId])
  @@map("department_members")
}

// ─── Business Profile (Onboarding Step A) ───────────────────

model BusinessProfile {
  id                          String           @id @default(cuid())
  tenantId                    String           @unique @map("tenant_id")
  organizationName            String           @map("organization_name")
  industry                    String
  businessDescription         String           @map("business_description")
  businessPriority            BusinessPriority @map("business_priority")
  estimatedDailyConversations Int              @map("estimated_daily_conversations")
  numberOfAgents              Int              @map("number_of_agents")
  // Multi-select goals captured during onboarding v2 - array of slugs like
  // ["reply_faster", "qualify_leads", "handle_calls"]. Drives the post-
  // onboarding home screen, mission ordering, and the guided tour focus.
  businessGoals               Json?            @map("business_goals")
  // Website domain captured during onboarding so we can re-run the AI
  // analysis later (e.g. on a "refresh description" button in settings).
  websiteDomain               String?          @map("website_domain")
  // Auto-understood during onboarding (website crawl). Country in plain
  // English (e.g. "Israel"); primaryLanguage as ISO-639-1 mirrors
  // Tenant.defaultLocale but is kept here for the confirmation card.
  country                     String?
  primaryLanguage             String?          @map("primary_language")
  // The single "system of truth" the tenant connected during onboarding
  // (slug: "hubspot" | "salesforce" | "zoho_crm" | "shopify"). Display +
  // gate signal; the live connection state is still read from
  // TenantIntegration. NULL = not chosen yet.
  primarySystem               String?          @map("primary_system")
  // Industry Intelligence Pack matched during onboarding (slug, e.g.
  // "event_hall"). Applying a pack clones its scoped FieldDefinitions to the
  // tenant. NULL = generic / not chosen.
  packSlug                    String?          @map("pack_slug")
  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

// ─── Business Discovery (Onboarding Intelligence Engine) ────
// The "opening balance" of the AI Readiness spine. Produced by the deep
// 5-domain website scan at the very start of onboarding (Movements 1-2 of
// the Onboarding Bible). Persisted so the report survives a refresh / an
// OAuth round-trip, and so Business Health (Movement 3) and the first
// AI Recommendation (Movement 4) can be derived from it without re-running
// the LLM-costly scan. One row per tenant.
//
// Every JSON blob is the *structured understanding* the AI reflected back -
// never silently ingested. `report` is the first-person narrated briefing
// the customer reads ("I analyzed your business. I found 126 products…").
// `gaps` are first-class findings ("I couldn't find a refund policy").
model BusinessDiscovery {
  id            String  @id @default(cuid())
  tenantId      String  @unique @map("tenant_id")
  websiteDomain String? @map("website_domain")
  // Lifecycle: PENDING (scan queued) → SCANNING → COMPLETE → FAILED.
  status        String  @default("PENDING")

  // The five intelligence domains (Bible Part II). Each is the structured
  // extraction the customer can see, confirm, and correct.
  brand         Json? // { voice, tone, style, vocabulary[], forbiddenWords[], ctaStyle, languages[], positioning }
  business      Json? // { industry, icp, personas[], products[], services[], pricingModel, valueProp, businessModel, summary }
  knowledge     Json? // { faq, helpCenter, docs, policies{shipping,returns,refunds,terms,privacy}, articleCount }
  communication Json? // { channels: [{ type, detail, confidence }] }
  technology    Json? // { storefront, cms, tools: [{ slug, name, category }] }

  // Findings + honest gaps + the first recommendation + a calibrated
  // confidence read per domain. All reflected back in the UI.
  gaps           Json? // [{ id, domain, label, severity, ask }]
  recommendation Json? // { employeeRole, employeeName, reason, systems: [{ slug, reason }], knowledge: [{ label, reason }], channel }
  health         Json? // { knowledge: [{ label, ok }], communication: [...], tools: [...] } snapshot at scan time
  confidence     Json? // { business, brand, knowledge, customers, communication, integrations }  (0-100)

  // First-person narrated briefing (Movement 1 / Output 1).
  report String? @db.Text

  // The single earned question (Movement 5): primary business goal slug.
  primaryGoal String? @map("primary_goal")

  // Resume checkpoint (P0): the last movement key the owner reached
  // (review|connect|goal|integrations|knowledge|recommendation|tune|ready).
  // Derived state stays authoritative for stage; `progress` only refines the
  // resume position WITHIN the review→ready band so a reload during movements
  // 6-9 returns to that movement instead of falling back to integrations.
  progress String?

  // Live ceremony phase (Movement 1) - updated between scan phases so the
  // loader's checkmarks land on real events, not a timer:
  // homepage|links|pages|signals|synthesis|normalizing|done.
  scanPhase String? @map("scan_phase")

  // Movement 8 tune-chat transcript, persisted (bounded to the last 20 turns)
  // so a reload mid-tune resumes the conversation instead of losing it.
  tuneTranscript Json? @map("tune_transcript")

  scannedAt DateTime? @map("scanned_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_discoveries")
}

// ─── Recommendations (living AI backlog) ────────────────────
// A recommendation is NOT an onboarding step. It is a persistent, evolving
// suggestion the AI produces as it learns the business ("connect Shopify",
// "import your refund policy", "hire a Support employee"). Onboarding is merely
// the FIRST surface that shows them; later they populate the Home dashboard.
//
// A recommendation lives until it is completed, dismissed, or REPLACED by a
// better one. Idempotent via unique (tenantId, dedupeKey): a re-scan updates
// the same logical rec instead of duplicating, and never resurrects one the
// customer already completed or dismissed.
model Recommendation {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  source      String    @default("discovery") // discovery | store_inspection | manual
  kind        String // hire_employee | connect_system | connect_channel | import_knowledge | setup_workflow | tool_detected (detected on site, no connector - acknowledgment only)
  title       String
  reason      String?   @db.Text
  action      String? // machine hint, e.g. "connect:shopify" | "hire:customer_support" | "teach:refund_policy"
  targetSlug  String?   @map("target_slug") // shopify | hubspot | whatsapp | ...
  confidence  String    @default("likely")
  priority    Int       @default(0) // higher = surfaced first (already-detected systems rank up)
  status      String    @default("OPEN") // OPEN | COMPLETED | DISMISSED | REPLACED
  dedupeKey   String    @map("dedupe_key")
  payload     Json?
  completedAt DateTime? @map("completed_at")
  dismissedAt DateTime? @map("dismissed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, priority])
  @@map("recommendations")
}

// ─── Scheduled Nudges (Lifecycle Nudge Engine) ──────────────
// A generic, restart-safe, idempotent scheduler for lifecycle nudges. The DB
// row is the source of truth (survives a Redis flush); a repeatable BullMQ
// sweep sends the due ones. Onboarding is the first consumer, but `kind` keeps
// it generic for future lifecycle nudges (trial-ending, re-engagement, …).
//
// Idempotency: unique (tenantId, dedupeKey) - scheduling the same logical nudge
// again UPDATES the existing PENDING row (reschedule) instead of duplicating.
// Content is computed at SEND time from live state, so a nudge whose reason no
// longer holds (the customer already did the thing) is marked SKIPPED, not sent.
model ScheduledNudge {
  id           String    @id @default(cuid())
  tenantId     String    @map("tenant_id")
  kind         String // "onboarding" | future lifecycle kinds
  dedupeKey    String    @map("dedupe_key") // stable per logical nudge, e.g. "onboarding_next_step"
  scheduledFor DateTime  @map("scheduled_for")
  status       String    @default("PENDING") // PENDING | SENT | CANCELLED | SKIPPED | FAILED
  channel      String    @default("email") // email | in_app | both
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  sentAt       DateTime? @map("sent_at")
  payload      Json? // optional context for content computation / templating
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([status, scheduledFor])
  @@index([tenantId, status])
  @@map("scheduled_nudges")
}

// ─── Tenant Invitations ─────────────────────────────────────
// Minimal invitation model - used both for the onboarding "invite
// teammate by email" step and for the shareable tenant invite link.
// `email` is nullable so the same model handles both: filled = direct
// invite (email-targeted), null = open-link invite anyone can accept.

model TenantInvite {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  token      String    @unique
  email      String?
  role       String    @default("AGENT")
  invitedBy  String?   @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  userId     String?   @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
  @@map("tenant_invites")
}

