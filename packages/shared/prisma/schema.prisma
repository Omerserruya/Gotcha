  config         Json             @default("{}")
  connectedBy    String?          @map("connected_by")
  connectedAt    DateTime?        @map("connected_at")
  lastTestedAt   DateTime?        @map("last_tested_at")
  lastTestResult Boolean?         @map("last_test_result")
  lastError      String?          @map("last_error")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  integration IntegrationCatalog @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tenantTools TenantTool[]

  @@unique([tenantId, integrationId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_integrations")
}

// ─── Tenant Tool Activation ─────────────────────────────────

model TenantTool {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  tenantIntegrationId String   @map("tenant_integration_id")
  catalogToolId       String   @map("catalog_tool_id")
  isEnabled           Boolean  @default(true) @map("is_enabled")
  configOverrides     Json     @default("{}") @map("config_overrides")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenantIntegration TenantIntegration     @relation(fields: [tenantIntegrationId], references: [id], onDelete: Cascade)
  catalogTool       CatalogTool           @relation(fields: [catalogToolId], references: [id], onDelete: Cascade)
  agentPermissions  AgentToolPermission[]
  executions        ToolExecution[]

  @@unique([tenantIntegrationId, catalogToolId])
  @@index([tenantId])
  @@index([tenantId, isEnabled])
  @@map("tenant_tools")
}

// ─── Tenant Tool Permission (iOS-style privacy toggle + HITL) ───
// Cross-cuts INTERNAL tools (static TOOL_REGISTRY entries) AND EXTERNAL
// integration tools (catalog). A single row per (tenantId, toolName)
// lets tenants:
//   - Disable individual tools entirely (enabled=false)
//   - Force HITL approval per tool (requiresApproval=true) — even when
//     the tool is normally low-risk
//   - Configure approver role + notification channels + expiry
//   - Allow the approver to modify params before running
// Used by the unified evaluatePolicies() entry point called from
// both the bot engine (autonomous actions) and action-executor
// (Command Center plans). Replaces the hardcoded HIGH_RISK_TOOLS list.
model TenantToolPermission {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  toolName          String   @map("tool_name") // "send_message" | "integration.hubspot.create_deal" | ...
  enabled           Boolean  @default(true)
  // HITL config — when true, actions using this tool pause and create
  // an ApprovalRequest; the bot conversation is held until a human
  // decides. See memory/bug_f4_approval_wrong_surface.md.
  requiresApproval  Boolean  @default(false) @map("requires_approval")
  approverRole      String?  @map("approver_role") // "supervisor" | "finance" | "admin" | null
  notifyChannels    Json     @default("[\"in_app\"]") @map("notify_channels") // ["in_app","email","slack"]
  expiresAfterMin   Int      @default(30) @map("expires_after_min")
  allowModification Boolean  @default(false) @map("allow_modification") // approver can edit params
  updatedBy         String?  @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, toolName])
  @@index([tenantId])
  @@index([tenantId, enabled])
  @@map("tenant_tool_permissions")
}

// ─── Approval Requests (bot-initiated actions pending human OK) ─
// Created when an autonomous bot/flow hits a tool marked
// TenantToolPermission.requiresApproval=true (or flagged by a
// PolicyRule). The conversation is paused until a human resolves it.
//
// Key architectural note: this is NOT for Command Center approvals.
// Command Center actions are human-initiated by construction — the
// guardrails there are dry-run preview + confirmation modal, not a
// separate queue. ApprovalRequest is exclusively for the bot path.
//
// See memory/bug_f4_approval_wrong_surface.md for the full design.
model ApprovalRequest {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  // Nullable: System Copilot plans aren't conversation-scoped (e.g.
  // "build a workflow that fires after 2 days"). Customer-facing approvals
  // continue to fill this in.
  conversationId String?        @map("conversation_id")
  messageId      String?        @map("message_id") // the inbound that triggered the action
  contactId      String?        @map("contact_id")
  tool           String // "cancel_order" | "issue_refund" | "integration.hubspot.create_deal"
  params         Json // the full PlannedAction.params the bot wanted to run
  summary        String // one-sentence human-facing: "Cancel order #12345 and refund $89.50"
  reason         String // bot's own reasoning: "Customer requested cancellation within 24h window"
  policyRuleId   String?        @map("policy_rule_id") // which rule fired (nullable — could be simple HITL flag)
  policyRuleName String?        @map("policy_rule_name") // denormalized for display even if rule deleted
  riskLevel      String         @default("medium") @map("risk_level") // low | medium | high
  riskTags       Json           @default("[]") @map("risk_tags") // ["HIGH","IRREVERSIBLE","FINANCIAL"]
  status         ApprovalStatus @default(PENDING)
  requestedBy    String         @map("requested_by") // "bot" | "flow:<id>" | "ai-agent:<id>"
  decidedBy      String?        @map("decided_by")
  decidedAt      DateTime?      @map("decided_at")
  decisionReason String?        @map("decision_reason")
  modifiedParams Json?          @map("modified_params") // if approver edited before running
  expiresAt      DateTime       @map("expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, conversationId])
  @@index([tenantId, contactId])
  @@index([expiresAt])
  @@map("approval_requests")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

// ─── Agent Tool Permissions ─────────────────────────────────

model AgentToolPermission {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  departmentId    String?  @map("department_id")
  agentId         String?  @map("agent_id") // human agent (User) ID
  aiAgentId       String?  @map("ai_agent_id") // AI agent ID
  tenantToolId    String   @map("tenant_tool_id")
  isAllowed       Boolean  @default(true) @map("is_allowed")
  requireApproval Boolean  @default(false) @map("require_approval")

  // Per-agent tool SEMANTICS (Tier 2). Override what the tool MEANS to
  // THIS agent — e.g. the same `create_task` is "schedule SDR callback"
  // for a Sales agent and "create support ticket" for a Support agent.
  // Rendered into the OpenAI function.description by composeToolDescription
  // so the LLM picks tools by per-agent intent, not platform-global text.
  description String? @db.Text // what this tool does FOR THIS AGENT
  usageRule   String? @map("usage_rule") @db.Text // when to use / preconditions / forbidden contexts for THIS AGENT

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenantTool TenantTool  @relation(fields: [tenantToolId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([tenantToolId, departmentId, agentId])
  @@index([tenantId])
  @@index([departmentId])
  @@index([agentId])
  @@index([aiAgentId])
  @@map("agent_tool_permissions")
}

// ─── Tool Executions (Audit Log) ────────────────────────────

model ToolExecution {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  tenantToolId   String   @map("tenant_tool_id")
  input          Json     @default("{}")
  output         Json     @default("{}")
  success        Boolean  @default(true)
  durationMs     Int?     @map("duration_ms")
  triggeredBy    String   @default("ai") @map("triggered_by")
  approvedBy     String?  @map("approved_by")
  createdAt      DateTime @default(now()) @map("created_at")

  tenantTool TenantTool @relation(fields: [tenantToolId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
  @@index([tenantToolId])
  @@index([tenantId, createdAt])
  @@map("tool_executions")
}

// ─── Conversation Intelligence ──────────────────────────────

model ConversationIntelligence {
