// ─── Catalog Tools (what tools an integration offers) ───────

enum ToolCategory {
  READ
  WRITE
  DELETE
  ACTION
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model CatalogTool {
  id            String @id @default(cuid())
  integrationId String @map("integration_id")
  slug          String
  name          String
  description   String

  // NEW — complete tool contract for the LLM tool-surface.
  // `whenToUse` is human-written guidance that the prompt renders alongside
  // `description`. `exampleUsage` gives the LLM a worked example so it can
  // infer call shapes without relying only on description heuristics.
  whenToUse    String? @map("when_to_use") @db.Text
  exampleUsage Json?   @map("example_usage") // [{ input, output, note }]

  // Which execution modes this tool is valid in. Filtered at buildToolSurface time.
  // Default: both. Examples of AUTO-only: send_message, close_conversation.
  allowedModes Json @default("[\"AUTO\",\"ASSIST\"]") @map("allowed_modes")

  // HITL policy — this is the SEED for new tenants. The tenant override
  // (TenantTool.configOverrides.hitlPolicy or TenantToolPermission row) is
  // AUTHORITATIVE: it can both tighten and loosen this default. Per-agent
  // permissions only govern access (isAllowed), not HITL. Shape:
  //   { mode: "never" | "always" | "on_condition",
  //     condition?: string,       // CEL-lite predicate over args
  //     approverRole?: string,
  //     notifyChannels?: string[] }
  hitlPolicy Json @default("{\"mode\":\"never\"}") @map("hitl_policy")

  // Runtime limits honored by the tool executor.
  timeoutMs               Int  @default(10000) @map("timeout_ms")
  maxRetries              Int  @default(0) @map("max_retries")
  retryBackoffMs          Int  @default(1000) @map("retry_backoff_ms")
  circuitBreakerThreshold Int? @map("circuit_breaker_threshold")

  // Schema version for the inputSchema — bumped when args shape changes;
  // forces prompt regeneration on agents referencing this tool.
  schemaVersion Int @default(1) @map("schema_version")

  category     ToolCategory @default(READ)
  inputSchema  Json         @default("{}") @map("input_schema")
  outputSchema Json         @default("{}") @map("output_schema")
  endpoint     String?
  method       String       @default("GET")
  isDefault    Boolean      @default(true) @map("is_default")
  riskLevel    RiskLevel    @default(LOW) @map("risk_level")
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at")

  integration IntegrationCatalog @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tenantTools TenantTool[]

  @@unique([integrationId, slug])
  @@index([integrationId])
  @@map("catalog_tools")
}

