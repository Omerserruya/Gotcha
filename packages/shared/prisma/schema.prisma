  config         Json             @default("{}")
  connectedBy    String?          @map("connected_by")
  connectedAt    DateTime?        @map("connected_at")
  lastTestedAt   DateTime?        @map("last_tested_at")
  lastTestResult Boolean?         @map("last_test_result")
  lastError      String?          @map("last_error")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  integration IntegrationCatalog @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tenantTools TenantTool[]

  @@unique([tenantId, integrationId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_integrations")
}

// ─── Tenant Tool Activation ─────────────────────────────────

model TenantTool {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  tenantIntegrationId String   @map("tenant_integration_id")
  catalogToolId       String   @map("catalog_tool_id")
  isEnabled           Boolean  @default(true) @map("is_enabled")
  configOverrides     Json     @default("{}") @map("config_overrides")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenantIntegration TenantIntegration     @relation(fields: [tenantIntegrationId], references: [id], onDelete: Cascade)
  catalogTool       CatalogTool           @relation(fields: [catalogToolId], references: [id], onDelete: Cascade)
  agentPermissions  AgentToolPermission[]
  executions        ToolExecution[]

  @@unique([tenantIntegrationId, catalogToolId])
  @@index([tenantId])
  @@index([tenantId, isEnabled])
  @@map("tenant_tools")
}

// ─── Tenant Tool Permission (iOS-style privacy toggle + HITL) ───
// Cross-cuts INTERNAL tools (static TOOL_REGISTRY entries) AND EXTERNAL
// integration tools (catalog). A single row per (tenantId, toolName)
// lets tenants:
//   - Disable individual tools entirely (enabled=false)
//   - Force HITL approval per tool (requiresApproval=true) - even when
//     the tool is normally low-risk
//   - Configure approver role + notification channels + expiry
//   - Allow the approver to modify params before running
// Used by the unified evaluatePolicies() entry point called from
// both the bot engine (autonomous actions) and action-executor
// (Command Center plans). Replaces the hardcoded HIGH_RISK_TOOLS list.
model TenantToolPermission {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  toolName          String   @map("tool_name") // "send_message" | "integration.hubspot.create_deal" | ...
  enabled           Boolean  @default(true)
  // HITL config - when true, actions using this tool pause and create
  // an ApprovalRequest; the bot conversation is held until a human
  // decides. See memory/bug_f4_approval_wrong_surface.md.
  requiresApproval  Boolean  @default(false) @map("requires_approval")
  approverRole      String?  @map("approver_role") // "supervisor" | "finance" | "admin" | null
  notifyChannels    Json     @default("[\"in_app\"]") @map("notify_channels") // ["in_app","email","slack"]
  expiresAfterMin   Int      @default(30) @map("expires_after_min")
  allowModification Boolean  @default(false) @map("allow_modification") // approver can edit params
  updatedBy         String?  @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, toolName])
  @@index([tenantId])
  @@index([tenantId, enabled])
  @@map("tenant_tool_permissions")
}

// ─── Approval Requests (bot-initiated actions pending human OK) ─
// Created when an autonomous bot/flow hits a tool marked
// TenantToolPermission.requiresApproval=true (or flagged by a
// PolicyRule). The conversation is paused until a human resolves it.
//
// Key architectural note: this is NOT for Command Center approvals.
// Command Center actions are human-initiated by construction - the
// guardrails there are dry-run preview + confirmation modal, not a
// separate queue. ApprovalRequest is exclusively for the bot path.
//
// See memory/bug_f4_approval_wrong_surface.md for the full design.
model ApprovalRequest {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  // Nullable: System Copilot plans aren't conversation-scoped (e.g.
  // "build a workflow that fires after 2 days"). Customer-facing approvals
  // continue to fill this in.
  conversationId String?        @map("conversation_id")
  messageId      String?        @map("message_id") // the inbound that triggered the action
  contactId      String?        @map("contact_id")
  tool           String // "cancel_order" | "issue_refund" | "integration.hubspot.create_deal"
  params         Json // the full PlannedAction.params the bot wanted to run
  summary        String // one-sentence human-facing: "Cancel order #12345 and refund $89.50"
  reason         String // bot's own reasoning: "Customer requested cancellation within 24h window"
  policyRuleId   String?        @map("policy_rule_id") // which rule fired (nullable - could be simple HITL flag)
  policyRuleName String?        @map("policy_rule_name") // denormalized for display even if rule deleted
  riskLevel      String         @default("medium") @map("risk_level") // low | medium | high
  riskTags       Json           @default("[]") @map("risk_tags") // ["HIGH","IRREVERSIBLE","FINANCIAL"]
  status         ApprovalStatus @default(PENDING)
  requestedBy    String         @map("requested_by") // "bot" | "flow:<id>" | "ai-agent:<id>"
  decidedBy      String?        @map("decided_by")
  decidedAt      DateTime?      @map("decided_at")
  decisionReason String?        @map("decision_reason")
  modifiedParams Json?          @map("modified_params") // if approver edited before running
  // Kernel resume envelope (P1-3/B6): when the request originated from the
  // Capability Runtime's approval gate, the FULL ExecutionRequest is stored so
  // approval-resume re-enters the Runtime (invariants apply on HITL writes)
  // instead of the legacy tool executor. Null for legacy-brain requests.
  resumeEnvelope Json?          @map("resume_envelope")
  expiresAt      DateTime       @map("expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // ── Execution lifecycle (separate from the DECISION above) ──
  // A manager approving is not the action happening. `status` records the
  // human decision; `executionState` records what the system then did. Both
  // are needed: without this, a dispatch that failed left an APPROVED row
  // indistinguishable from one that succeeded, nothing could retry it, and
  // the customer was simply never told anything.
  executionState      ExecutionState @default(NOT_STARTED) @map("execution_state")
  executionStartedAt  DateTime?      @map("execution_started_at")
  executionEndedAt    DateTime?      @map("execution_ended_at")
  /// Provider/tool result summary. NEVER the raw credential-bearing payload.
  executionResult     Json?          @map("execution_result")
  executionError      String?        @map("execution_error")
  executionAttempts   Int            @default(0) @map("execution_attempts")
  /// Set once the customer has been told the outcome. Presence of this value
  /// is the once-only guard for the continuation message: delivery may be
  /// retried, but the business action behind it is never re-run.
  customerNotifiedAt  DateTime?      @map("customer_notified_at")
  /// Id of the OUTBOUND message that carried the outcome to the customer.
  customerMessageId   String?        @map("customer_message_id")
  /// How the decision arrived - web UI, WhatsApp button, API. Audit trail.
  decisionChannel     String?        @map("decision_channel")
  /// Ties every log line of one approval together across services.
  correlationId       String?        @map("correlation_id")
  /// Out-of-band (WhatsApp) manager notification: "sent" | "skipped" | "failed".
  /// `skipped` is a FIRST-CLASS state - the inbox renders the reason so an
  /// unconfigured tenant sees an actionable setup prompt rather than silence.
  managerNotifyState  String?        @map("manager_notify_state")
  managerNotifyReason String?        @map("manager_notify_reason")
  managerNotifiedAt   DateTime?      @map("manager_notified_at")
  /// Deterministic fingerprint of the BUSINESS operation (tool + normalized
  /// identifying args, e.g. "shopify.process_refund:order=1004"). Row-level
  /// guards are not enough when TWO rows describe the SAME operation - the
  /// customer got two "your refund is done" messages that way. This key dedups
  /// HITL creation (an open sibling wins) and the completion notification
  /// (any notified sibling wins).
  operationKey        String?        @map("operation_key")

  @@index([tenantId, operationKey])
  @@index([tenantId, status])
  @@index([tenantId, conversationId])
  @@index([tenantId, contactId])
  @@index([expiresAt])
  // Drives the resume sweeper: find approvals whose action still needs to run
  // or whose customer was never told.
  @@index([status, executionState])
  @@map("approval_requests")
}

/// Who may be pinged on WhatsApp to decide an approval, and where.
///
/// EXPLICIT ONLY. There is deliberately no "fall back to the tenant owner /
/// first admin" path: silently routing a refund approval to whoever happens to
/// be an admin is how the wrong person ends up authorising money movement.
/// A row must exist, be `enabled`, point at a real ACTIVE membership of the
/// tenant, and carry a validated E.164 number - otherwise the request simply
/// stays in the in-app approval inbox and says why it was not sent.
model ApprovalRecipient {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  /// The GOTCHA membership authorised to decide. Authorisation is re-checked
  /// at decision time, never trusted from the notification itself.
  userId       String   @map("user_id")
  /// Delivery channel. Only "whatsapp" today; the column exists so adding
  /// SMS/Telegram later does not need a migration.
  channel      String   @default("whatsapp")
  /// E.164, validated on write (normalised, digits only, leading +).
  phoneE164    String   @map("phone_e164")
  /// OFF by default - a tenant must deliberately turn this on.
  enabled      Boolean  @default(false)
  /// Cap what may be decided from a phone. HIGH-risk actions can be forced to
  /// the web UI ("Open in GOTCHA") instead of one-tap approval.
  maxRiskLevel String   @default("medium") @map("max_risk_level")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, channel])
  @@index([tenantId, enabled])
  @@map("approval_recipients")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

/// What happened to the ACTION after a human said yes. Distinct from
/// ApprovalStatus, which only records the human decision.
///   NOT_STARTED - no decision yet, or the decision was no.
///   EXECUTING   - dispatch in flight (claimed by exactly one worker).
///   SUCCEEDED   - the provider confirmed the action. ONLY this state may
///                 produce a "we did it" message to the customer.
///   FAILED      - dispatch ran and did not succeed; retryable or terminal.
enum ExecutionState {
  NOT_STARTED
  EXECUTING
  SUCCEEDED
  FAILED
  // Historical rows approved BEFORE the execution state machine existed. Their
  // dispatch outcome was never recorded (many provably never ran). They must
  // not read as SUCCEEDED (that falsifies history) and must not be retryable
  // (re-running an old refund/booking is worse). Terminal, audit-only state.
  LEGACY_UNVERIFIED
}

// ─── Agent Tool Permissions ─────────────────────────────────

model AgentToolPermission {
  id              String  @id @default(cuid())
  tenantId        String  @map("tenant_id")
  departmentId    String? @map("department_id")
  agentId         String? @map("agent_id") // human agent (User) ID
  aiAgentId       String? @map("ai_agent_id") // AI agent ID
  tenantToolId    String  @map("tenant_tool_id")
  isAllowed       Boolean @default(true) @map("is_allowed")
  requireApproval Boolean @default(false) @map("require_approval")

  // Per-agent tool SEMANTICS (Tier 2). Override what the tool MEANS to
  // THIS agent - e.g. the same `create_task` is "schedule SDR callback"
  // for a Sales agent and "create support ticket" for a Support agent.
  // Rendered into the OpenAI function.description by composeToolDescription
  // so the LLM picks tools by per-agent intent, not platform-global text.
  description String? @db.Text // what this tool does FOR THIS AGENT
  usageRule   String? @map("usage_rule") @db.Text // when to use / preconditions / forbidden contexts for THIS AGENT

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenantTool TenantTool  @relation(fields: [tenantToolId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([tenantToolId, departmentId, agentId])
  @@index([tenantId])
  @@index([departmentId])
  @@index([agentId])
  @@index([aiAgentId])
  @@map("agent_tool_permissions")
}

// ─── Tool Executions (Audit Log) ────────────────────────────

model ToolExecution {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  tenantToolId   String   @map("tenant_tool_id")
  input          Json     @default("{}")
  output         Json     @default("{}")
  success        Boolean  @default(true)
  durationMs     Int?     @map("duration_ms")
  triggeredBy    String   @default("ai") @map("triggered_by")
  approvedBy     String?  @map("approved_by")
  createdAt      DateTime @default(now()) @map("created_at")

  tenantTool TenantTool @relation(fields: [tenantToolId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
  @@index([tenantToolId])
  @@index([tenantId, createdAt])
  @@map("tool_executions")
}

// ─── Conversation Intelligence ──────────────────────────────

model ConversationIntelligence {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  conversationId    String   @unique @map("conversation_id")
  summary           String?
  detectedIntent    String?  @map("detected_intent")
  intentConfidence  Float?   @map("intent_confidence")
  sentiment         String? // "positive" | "negative" | "neutral"
  sentimentScore    Float?   @map("sentiment_score") // -1.0 to 1.0
  topics            Json     @default("[]") // ["billing", "refund", ...]
  toolsUsed         Json     @default("[]") @map("tools_used") // [{ toolId, toolName, success }]
  resolutionOutcome String?  @map("resolution_outcome") // "resolved" | "escalated" | "abandoned"
  customerEffort    Int?     @map("customer_effort") // 1-5 score
  aiConfidence      Float?   @map("ai_confidence") // overall AI confidence in handling
  metadata          Json?
  analyzedAt        DateTime @default(now()) @map("analyzed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, detectedIntent])
  @@index([tenantId, sentiment])
  @@index([tenantId, analyzedAt])
  @@map("conversation_intelligence")
}

// ─── Agent Scoring (Post-Conversation Review) ──────────────

model AgentScore {
  id             String @id @default(cuid())
  tenantId       String @map("tenant_id")
  conversationId String @map("conversation_id")
  agentId        String @map("agent_id")

  // Scores (1-5 scale)
  responseQuality   Int?   @map("response_quality") // Quality of agent responses
  responseSpeed     Int?   @map("response_speed") // How fast they responded
  resolutionScore   Int?   @map("resolution_score") // Did they resolve the issue?
  protocolAdherence Int?   @map("protocol_adherence") // Followed rules/escalation procedures?
  customerHandling  Int?   @map("customer_handling") // Empathy, professionalism
  overallScore      Float? @map("overall_score") // Weighted average (0-100)

  // AI analysis
  strengths    Json    @default("[]") // ["Quick response", "Used KB effectively"]
  improvements Json    @default("[]") // ["Could have escalated sooner"]
  summary      String? // AI-generated performance summary

  // Metadata
  copilotUsageRate Float? @map("copilot_usage_rate") // % of AI suggestions used
  toolsUsedCount   Int    @default(0) @map("tools_used_count")
  messageCount     Int    @default(0) @map("message_count")

  analyzedAt DateTime @default(now()) @map("analyzed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([conversationId, agentId])
  @@index([tenantId])
  @@index([agentId])
  @@index([tenantId, agentId])
  @@index([tenantId, analyzedAt])
  @@map("agent_scores")
}

// ─── Notification Log ───────────────────────────────────────

model NotificationLog {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  channel   String // email, slack, webhook, internal
  type      String // onboarding_email, activation_confirmation, etc.
  recipient String // email address or channel ID
  subject   String?
  body      String?
  status    String    @default("pending") // pending, sent, failed
  error     String?
  metadata  Json?
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([type, status])
  @@map("notification_logs")
}

// ─── Event-driven Notification System ───────────────────────
//
// NotificationPreference defines per-tenant (and optionally per-department)
// rules for which SystemEvents trigger notifications, who receives them,
// and through which channels. Postgres NULLS-DISTINCT semantics on the
// (tenantId, departmentId, eventType) tuple are enforced via two partial
// indexes - one for the NULL departmentId case (tenant default) and one
// for explicit department scope. Mirrors the trick used in the
// `tenant_funnels` table (see 20260507200000_funnel_per_department).

model NotificationPreference {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  /// NULL = tenant-default rule (applies when no department-scoped row exists).
  departmentId String?  @map("department_id")
  eventType    String   @map("event_type")
  enabled      Boolean  @default(true)
  /// CEL-lite - array of { field, op, value } objects.
  conditions   Json?
  /// { type: "tenant_owner" | "department_manager" | "users", userIds?: string[] }
  recipients   Json
  /// string[] - ["email", "in_app", ...]. Adding new channels (slack, sms) is purely
  /// a dispatcher switch; no schema migration needed.
  channels     Json     @default("[\"email\",\"in_app\"]")
  /// CRITICAL | HIGH | MEDIUM | LOW
  priority     String   @default("MEDIUM")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // NOTE: The (tenantId, departmentId, eventType) uniqueness - including the
  // NULL-departmentId case - is enforced via two partial unique indexes
  // declared in the migration SQL (Postgres-14 safe). Prisma's schema-level
  // @@unique can't express the partial-index condition, so it's omitted here
  // intentionally - the DB still rejects duplicates at write-time.
  @@index([tenantId, eventType])
  @@map("notification_preferences")
}

// In-app notification record. One row per user-bound notification surfaced
// in the dashboard's bell/inbox. Created by the dispatcher when "in_app"
// is on the preference's channels. Real-time delivery happens via the
// shared event-bus (publishEvent → frontend SSE/poll). The frontend can
// also fall back to polling the GET /notifications endpoint.
model InAppNotification {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  eventType String   @map("event_type")
  priority  String   @default("MEDIUM")
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([tenantId, createdAt])
  @@map("in_app_notifications")
}

// ─── Contacts (Customer Directory) ─────────────────────────

model Contact {
  id                String      @id @default(cuid())
  tenantId          String      @map("tenant_id")
  externalId        String      @map("external_id") // phone, email, PSID, etc.
  channel           ChannelType
  displayName       String?     @map("display_name")
  email             String?
  emailVerified     Boolean     @default(false) @map("email_verified")
  phone             String?
  phoneVerified     Boolean     @default(false) @map("phone_verified")
  avatarUrl         String?     @map("avatar_url")
  metadata          Json? // custom fields
  tags              Json        @default("[]") // string[] for segmentation
  lastSeenAt        DateTime?   @map("last_seen_at")
  lastInteractionAt DateTime?   @map("last_interaction_at")
  source            String? // campaign/channel source
  optOutChannels    Json        @default("[]") @map("opt_out_channels") // string[] of opted-out channel types
  optedOutAt        DateTime?   @map("opted_out_at")
  // Cross-channel identity: multiple contact rows sharing the same personId
  // represent one real human across WA/IG/Gmail/Messenger/etc. Assigned by
  // the unifier when a shared identifier is discovered (email/phone match
  // or explicit capture via /api/identity/capture).
  personId          String?     @map("person_id")
  // Soft-merge pointer: when set, this row has been merged into mergedIntoId.
  // The row is kept (not deleted) so incoming webhook lookups by
  // (tenantId, channel, externalId) still resolve - `resolveContactByChannelId`
  // follows the pointer to the surviving target. Replaces the old
  // hard-delete path that created "ghost" contacts after merges.
  mergedIntoId      String?     @map("merged_into_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  broadcastRecipients      BroadcastRecipient[]
  voiceSessionParticipants VoiceSessionParticipant[]

  @@unique([tenantId, channel, externalId])
  @@index([tenantId])
  @@index([tenantId, displayName])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, lastInteractionAt])
  @@index([tenantId, personId])
  @@index([mergedIntoId])
  @@map("contacts")
}

// ─── Identity Link Suggestions ─────────────────────────────
// AI-proposed or system-proposed links between contacts. A suggestion is
// created when an identifier (email/phone) extracted from one contact is
// already attached to a different contact in the same tenant. Merging is
// a separate, explicit, approval-gated operation - this table is the
// pending queue feeding that decision. Never auto-merged on insert.

enum IdentityLinkStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

enum IdentityLinkIdentifierType {
  EMAIL
  PHONE
}

model IdentityLinkSuggestion {
  id              String                     @id @default(cuid())
  tenantId        String                     @map("tenant_id")
  sourceContactId String                     @map("source_contact_id")
  targetContactId String                     @map("target_contact_id")
  identifierType  IdentityLinkIdentifierType @map("identifier_type")
  identifierValue String                     @map("identifier_value")
  confidence      Float                      @default(0)
  status          IdentityLinkStatus         @default(PENDING)
  reason          String?
  messageId       String?                    @map("message_id")
  createdAt       DateTime                   @default(now()) @map("created_at")
  decidedAt       DateTime?                  @map("decided_at")
  decidedBy       String?                    @map("decided_by")

  @@unique([tenantId, sourceContactId, targetContactId, identifierType, identifierValue], map: "identity_link_unique")
  @@index([tenantId, status])
  @@index([tenantId, targetContactId])
  @@map("identity_link_suggestions")
}

// ─── Message Templates ─────────────────────────────────────

enum TemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model MessageTemplate {
  id               String         @id @default(cuid())
  tenantId         String         @map("tenant_id")
  name             String
  category         String         @default("general") // marketing, utility, authentication, general
  language         String         @default("en")
  channel          ChannelType? // null = all channels
  channelAccountId String?        @map("channel_account_id") // bind template to a specific connected account (e.g. specific WABA)
  headerType       String?        @map("header_type") // text, image, video, document
  headerContent    String?        @map("header_content")
  body             String // template body with {{1}} placeholders
  footer           String?
  buttons          Json           @default("[]") // [{ type: "QUICK_REPLY"|"URL"|"PHONE", text, url?, phoneNumber? }]
  variables        Json           @default("[]") // [{ key: "1", sample: "John" }]
  externalId       String?        @map("external_id") // WhatsApp template ID after sync
  metaTemplateId   String?        @map("meta_template_id") // Meta's internal template ID
  rejectionReason  String?        @map("rejection_reason") // reason if rejected by Meta
  status           TemplateStatus @default(DRAFT)
  version          Int            @default(1)
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  broadcasts     Broadcast[]

  @@unique([tenantId, name, language, channel])
  @@index([tenantId])
  @@index([tenantId, channel, status])
  @@index([tenantId, channelAccountId])
  @@map("message_templates")
}

// ─── Broadcasts ────────────────────────────────────────────

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Broadcast {
  id               String          @id @default(cuid())
  tenantId         String          @map("tenant_id")
  name             String
  channel          ChannelType
  channelAccountId String          @map("channel_account_id")
  templateId       String?         @map("template_id")
  body             String? // for non-template messages
  variables        Json            @default("{}") // template variable values
  // Per-campaign override for IMAGE/VIDEO/DOCUMENT WhatsApp template
  // headers. When set, this URL is sent as the live header for every
  // recipient instead of the template's example URL.
  headerMediaUrl   String?         @map("header_media_url")
  flowId           String?         @map("flow_id") // trigger flow for each recipient
  // Audience definition (manual chips / filter rules / everyone) - resolved at send time.
  audience         Json?
  status           BroadcastStatus @default(DRAFT)
  scheduledAt      DateTime?       @map("scheduled_at")
  startedAt        DateTime?       @map("started_at")
  completedAt      DateTime?       @map("completed_at")
  createdBy        String          @map("created_by")

  // Analytics counters
  totalRecipients Int @default(0) @map("total_recipients")
  sentCount       Int @default(0) @map("sent_count")
  deliveredCount  Int @default(0) @map("delivered_count")
  readCount       Int @default(0) @map("read_count")
  repliedCount    Int @default(0) @map("replied_count")
  failedCount     Int @default(0) @map("failed_count")

  // Last error message when broadcast halted (channel API failure, billing issue, etc.)
  lastError String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   MessageTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients BroadcastRecipient[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([scheduledAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String    @map("broadcast_id")
  contactId   String?   @map("contact_id")
  externalId  String    @map("external_id") // phone/PSID/email
  // Per-recipient resolved template variable values, snapshotted at
  // materialize time. Resolved from Broadcast.variables (a mapping spec
  // like {"1": {source:"crm", field:"First_Name"}}) against the
  // recipient's CRM record. Worker reads this verbatim - no CRM call
  // at send time.
  variables   Json?
  messageId   String?   @map("message_id") // outgoing message ID after send
  status      String    @default("pending") // pending, sent, delivered, read, replied, failed
  error       String?
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  repliedAt   DateTime? @map("replied_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([broadcastId])
  @@index([broadcastId, status])
  @@index([contactId])
  @@map("broadcast_recipients")
}

// ─── Scheduled Messages ────────────────────────────────────

enum ScheduledMessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model ScheduledMessage {
  id                  String                 @id @default(cuid())
  tenantId            String                 @map("tenant_id")
  conversationId      String?                @map("conversation_id")
  channel             ChannelType
  channelAccountId    String                 @map("channel_account_id")
  recipientExternalId String                 @map("recipient_external_id")
  body                String
  messageType         String                 @default("text") @map("message_type")
  mediaUrl            String?                @map("media_url")
  templateId          String?                @map("template_id")
  variables           Json                   @default("{}")
  sendType            String                 @default("regular") @map("send_type") // regular, conversation, flow
  departmentId        String?                @map("department_id")
  flowId              String?                @map("flow_id")
  scheduledAt         DateTime               @map("scheduled_at")
  status              ScheduledMessageStatus @default(PENDING)
  sentAt              DateTime?              @map("sent_at")
  error               String?
  createdBy           String                 @map("created_by")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status, scheduledAt])
  @@index([tenantId, status])
  @@map("scheduled_messages")
}

// ─── Usage Logs (Centralized Usage Tracking) ───────────────

model UsageLog {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  type             String // "ai_tokens" | "message_sent" | "tool_call" | "automation_run"
  quantity         Int
  tokensEquivalent Int      @map("tokens_equivalent")
  // AI-specific denormalized columns - populated when type="ai_tokens" so the
  // Platform Usage admin view can aggregate by model/feature and price the
  // prompt/completion split accurately without hitting the metadata JSON.
  feature          String? // "chat" | "suggestion" | "summary" | "classification" | "embedding" | "action_plan" | "intent_classify" | "onboarding" | "followup" | "ai_bot" | "knowledge_retrieval"
  model            String?
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  costUsd          Decimal? @map("cost_usd") @db.Decimal(12, 6)
  // Billing / AI-Units (populated when type="ai_tokens" once metering is live).
  // unitsConsumed = (providerCost x categoryMultiplier x marginFactor) / unitCostBasis.
  // This is the profitability ledger row; the coarse wallet movement lives in
  // AiUnitLedgerEntry (linked via ledgerEntryId). billedPeriodKey ties the spend
  // to a subscription billing period for reset/aggregation.
  unitsConsumed    Decimal? @map("units_consumed") @db.Decimal(16, 6)
  billedPeriodKey  String?  @map("billed_period_key")
  ledgerEntryId    String?  @map("ledger_entry_id")
  // Per-turn attribution (P1-6): turnId groups every micro-call of ONE customer
  // turn; durationMs is that call's wall time; aiAgentId denormalizes the
  // employee so per-employee cost/latency rollups don't join through metadata.
  turnId           String?  @map("turn_id")
  durationMs       Int?     @map("duration_ms")
  aiAgentId        String?  @map("ai_agent_id")
  metadata         Json? // { channel, tool, conversationId, messageId, ... }
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([tenantId, feature])
  @@index([tenantId, model])
  @@index([tenantId, billedPeriodKey])
  @@index([tenantId, aiAgentId])
  @@index([tenantId, turnId])
  @@map("usage_logs")
}

// ─── Credit Transactions (DEPRECATED) ──────────────────────
// Superseded by AiUnitLedgerEntry + AiUnitLot. Never written in production;
// kept only to avoid a destructive migration. Do not use in new code.

model CreditTransaction {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  amount      Int // credits consumed (positive = consumed, negative = added)
  source      String // usage type that generated this: "ai_tokens", "message_sent", etc.
  referenceId String?  @map("reference_id") // optional link to usage_log or other entity
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, source])
  @@index([tenantId, createdAt])
  @@map("credit_transactions")
}

// ════════════════════════════════════════════════════════════════════════
// BILLING · SUBSCRIPTION · LICENSING · AI UNITS
// Design dossier: docs / plan i-want-to-design-async-muffin.md
// Separation of concerns:
//   • MONEY      (BillableEntity → BillingProfile/Subscription/Invoice/Charge)
//   • WALLET     (tenant-scoped AiUnitLot/AiUnitLedgerEntry/TenantAiBalance)
//   • ENTITLEMENT(tenant-scoped TenantEntitlement → materialized TenantFeature)
//   • CATALOG    (Plan/PlanEntitlement/CreditPackage/BillableModel/UnitPricingConfig)
// ════════════════════════════════════════════════════════════════════════

enum BillableEntityKind {
  TENANT // V1: one BillableEntity per tenant. Future: ACCOUNT (one payer, N tenants).
  ACCOUNT
}

enum SubscriptionStatus {
  PENDING // created, card not yet on file
  TRIALING
  ACTIVE
  PAST_DUE // renewal charge failed; in dunning
  SUSPENDED // dunning exhausted; AI gated, platform read-only
  CANCELED
  PAUSED
  GRANDFATHERED // temporary one-way compatibility state (enforcement + billing OFF)
}

enum BillingProfileStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethodStatus {
  ACTIVE
  EXPIRED
  REMOVED
}

enum BillingProvider {
  ICOUNT
  STRIPE
  MANUAL // grandfathered / admin-managed; no real provider
}

enum InvoiceType {
  SUBSCRIPTION
  CREDIT_PURCHASE
  AUTO_PURCHASE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  FAILED
  VOID
}

enum ChargeStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

enum PendingChangeType {
  DOWNGRADE
  CANCEL
}

enum AiUnitBucket {
  INCLUDED // monthly plan allotment; expires at renewal (use-it-or-lose-it)
  PURCHASED // bought or auto-purchased; never expires; consumed FIFO after INCLUDED
}

enum AiUnitGrantType {
  PLAN
  PURCHASE
  AUTO
  PROMO
  TRIAL
}

enum AiUnitEntryType {
  GRANT
  CONSUME
  EXPIRE
  ADJUST
  REFUND
}

enum EntitlementValueType {
  BOOLEAN
  COUNTER // numeric limit (max users, AI employees, channels, storage…)
  CONFIG // arbitrary JSON config
}

enum EntitlementSource {
  PLAN_DEFAULT
  OVERRIDE
  PROMO
  TRIAL
  ADDON
  BETA
}

// ─── Billable Entity (the payer abstraction) ───────────────
// Money/subscription models reference billableEntityId, NEVER tenantId, so a
// future BillingAccount → many tenants needs no redesign. V1 seeds one
// TENANT-kind entity per tenant via the BillableEntityTenant link.

model BillableEntity {
  id          String             @id @default(cuid())
  kind        BillableEntityKind @default(TENANT)
  displayName String?            @map("display_name")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  tenants            BillableEntityTenant[]
  billingProfile     BillingProfile?
  subscription       Subscription?
  invoices           Invoice[]
  autoPurchasePolicy AutoPurchasePolicy?

  @@map("billable_entities")
}

model BillableEntityTenant {
  id               String   @id @default(cuid())
  billableEntityId String   @map("billable_entity_id")
  // @unique enforces V1's one-entity-per-tenant. Dropping this unique later
  // (without touching downstream models) is what enables multi-tenant accounts.
  tenantId         String   @unique @map("tenant_id")
  createdAt        DateTime @default(now()) @map("created_at")

  entity BillableEntity @relation(fields: [billableEntityId], references: [id], onDelete: Cascade)
  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([billableEntityId])
  @@map("billable_entity_tenants")
}

// ─── Plan & Pricing Catalog ────────────────────────────────

model Plan {
  id              String          @id @default(cuid())
  key             String // light | pro | business | enterprise | grandfathered
  name            String
  version         Int             @default(1)
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  basePrice       Decimal?        @map("base_price") @db.Decimal(12, 2) // null for sales-only / grandfathered
  currency        String          @default("ILS")
  includedAiUnits Int             @default(0) @map("included_ai_units")
  salesOnly       Boolean         @default(false) @map("sales_only") // Enterprise = true (no public price)
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  entitlements PlanEntitlement[]

  @@unique([key, version])
  @@index([key])
  @@map("plans")
}

model PlanEntitlement {
  id             String               @id @default(cuid())
  planId         String               @map("plan_id")
  entitlementKey String               @map("entitlement_key") // license key OR limit key
  valueType      EntitlementValueType @map("value_type")
  value          Json // { bool } | { count } | arbitrary config
  createdAt      DateTime             @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, entitlementKey])
  @@index([planId])
  @@map("plan_entitlements")
}

model CreditPackage {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  units            Int
  price            Decimal  @db.Decimal(12, 2)
  currency         String   @default("ILS")
  providerPriceRef String?  @map("provider_price_ref")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("credit_packages")
}

// Cost-driven pricing engine. AI Units are an abstraction over real provider
// COST, not raw tokens. Adding a model / changing prices / adjusting margin =
// data change only (no code). Versioned by effectiveFrom (newest active wins).

model BillableModel {
  id                   String   @id @default(cuid())
  model                String // e.g. "gpt-5-mini"
  provider             String   @default("openai")
  kind                 String   @default("CHAT") // CHAT | EMBEDDING | VOICE | DEEP_RESEARCH
  inputCostPer1M       Decimal  @map("input_cost_per_1m") @db.Decimal(12, 6)
  outputCostPer1M      Decimal  @map("output_cost_per_1m") @db.Decimal(12, 6)
  cachedInputCostPer1M Decimal? @map("cached_input_cost_per_1m") @db.Decimal(12, 6)
  categoryMultiplier   Decimal  @default(1) @map("category_multiplier") @db.Decimal(8, 4) // voice 2x, deep-research 10x
  active               Boolean  @default(true)
  effectiveFrom        DateTime @default(now()) @map("effective_from")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([model, active, effectiveFrom])
  @@map("billable_models")
}

model UnitPricingConfig {
  id               String   @id @default(cuid())
  // The real provider cost (USD) that equals exactly 1 AI Unit (e.g. the cost
  // of 10k gpt-5-mini tokens @ 80/20). marginFactor scales cost→Units to set
  // commercial margin. Both are data so margin/cost changes never touch code.
  unitCostBasisUsd Decimal  @map("unit_cost_basis_usd") @db.Decimal(12, 8)
  marginFactor     Decimal  @default(1) @map("margin_factor") @db.Decimal(8, 4)
  currency         String   @default("USD")
  active           Boolean  @default(true)
  effectiveFrom    DateTime @default(now()) @map("effective_from")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([active, effectiveFrom])
  @@map("unit_pricing_configs")
}

// ─── Entitlement layering (feeds the existing permission resolver) ──
// Override layer behind the materialized TenantFeature read cache. Carries
// source + expiry so plan defaults, promos, trials, beta and manual overrides
// coexist without destroying each other.

model TenantEntitlement {
  id             String               @id @default(cuid())
  tenantId       String               @map("tenant_id")
  entitlementKey String               @map("entitlement_key")
  valueType      EntitlementValueType @map("value_type")
  value          Json
  source         EntitlementSource
  expiresAt      DateTime?            @map("expires_at") // temporary features (beta/promo/trial)
  reason         String?
  createdBy      String?              @map("created_by")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entitlementKey, source])
  @@index([tenantId])
  @@index([tenantId, entitlementKey])
  @@map("tenant_entitlements")
}

// ─── Wallet (tenant-scoped AI Units) ───────────────────────
// Two buckets: INCLUDED (monthly, expires at renewal) and PURCHASED (never
// expires, FIFO). Balance = Σ ledger, reconcilable against lot.unitsRemaining.

model AiUnitLot {
  id             String          @id @default(cuid())
  tenantId       String          @map("tenant_id")
  bucket         AiUnitBucket
  grantType      AiUnitGrantType @map("grant_type")
  unitsGranted   Decimal         @map("units_granted") @db.Decimal(16, 6)
  unitsRemaining Decimal         @map("units_remaining") @db.Decimal(16, 6)
  periodKey      String?         @map("period_key") // INCLUDED only - the billing period this allotment belongs to
  expiresAt      DateTime?       @map("expires_at") // INCLUDED → period end; PURCHASED → null
  source         String? // "plan:pro" | "package:5000" | "promo:launch" | "auto"
  referenceId    String?         @map("reference_id") // invoice / order / subscription id
  createdAt      DateTime        @default(now()) @map("created_at")

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries AiUnitLedgerEntry[]

  // FIFO consumption order: INCLUDED current period first, then PURCHASED oldest-first.
  @@index([tenantId, bucket, createdAt])
  @@index([tenantId, periodKey])
  @@map("ai_unit_lots")
}

model AiUnitLedgerEntry {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  lotId       String?         @map("lot_id")
  entryType   AiUnitEntryType @map("entry_type")
  bucket      AiUnitBucket
  units       Decimal         @db.Decimal(16, 6) // signed: GRANT/REFUND +, CONSUME/EXPIRE -
  periodKey   String?         @map("period_key")
  source      String?
  referenceId String?         @map("reference_id") // usage turn / invoice / order
  createdAt   DateTime        @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lot    AiUnitLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entryType])
  @@index([tenantId, periodKey])
  @@map("ai_unit_ledger_entries")
}

// Materialized snapshot for the hot-path pre-flight gate + UI. Derived from the
// ledger/lots; kept in sync transactionally. Shows INCLUDED vs PURCHASED apart.
model TenantAiBalance {
  tenantId           String   @id @map("tenant_id")
  includedRemaining  Decimal  @default(0) @map("included_remaining") @db.Decimal(16, 6)
  purchasedRemaining Decimal  @default(0) @map("purchased_remaining") @db.Decimal(16, 6)
  includedAllowance  Decimal  @default(0) @map("included_allowance") @db.Decimal(16, 6) // current plan's monthly grant (for % calc)
  periodKey          String?  @map("period_key")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_ai_balances")
}

// ─── Money primitives (keyed by billableEntityId) ──────────

model BillingProfile {
  id                 String               @id @default(cuid())
  billableEntityId   String               @unique @map("billable_entity_id")
  provider           BillingProvider      @default(ICOUNT)
  providerCustomerId String?              @map("provider_customer_id")
  currency           String               @default("ILS")
  billingEmail       String?              @map("billing_email")
  vatId              String?              @map("vat_id")
  status             BillingProfileStatus @default(ACTIVE)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  entity         BillableEntity  @relation(fields: [billableEntityId], references: [id], onDelete: Cascade)
  paymentMethods PaymentMethod[]

  @@map("billing_profiles")
}

model PaymentMethod {
  id               String              @id @default(cuid())
  billingProfileId String              @map("billing_profile_id")
  provider         BillingProvider     @default(ICOUNT)
  // Tokenized reference only - raw PAN is NEVER stored (iCount is the PCI vault).
  token            String
  brand            String?
  last4            String?
  expMonth         Int?                @map("exp_month")
  expYear          Int?                @map("exp_year")
  isDefault        Boolean             @default(false) @map("is_default")
  status           PaymentMethodStatus @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  profile BillingProfile @relation(fields: [billingProfileId], references: [id], onDelete: Cascade)

  @@index([billingProfileId])
  @@map("payment_methods")
}

model Subscription {
  id                      String             @id @default(cuid())
  billableEntityId        String             @unique @map("billable_entity_id") // V1: one active subscription per entity
  billingProfileId        String?            @map("billing_profile_id")
  planKey                 String             @map("plan_key")
  planVersion             Int                @default(1) @map("plan_version")
  status                  SubscriptionStatus @default(PENDING)
  // When false (GRANDFATHERED), the AI runtime gate is skipped and no billing
  // runs. NOT an infinite-units balance - financial state stays deterministic.
  enforcementEnabled      Boolean            @default(true) @map("enforcement_enabled")
  trialEndsAt             DateTime?          @map("trial_ends_at")
  currentPeriodStart      DateTime?          @map("current_period_start")
  currentPeriodEnd        DateTime?          @map("current_period_end")
  cancelAtPeriodEnd       Boolean            @default(false) @map("cancel_at_period_end")
  providerSubscriptionRef String?            @map("provider_subscription_ref")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  entity        BillableEntity             @relation(fields: [billableEntityId], references: [id], onDelete: Cascade)
  pendingChange PendingSubscriptionChange?
  events        SubscriptionEvent[]
  dunning       DunningState?

  @@index([status])
  @@index([currentPeriodEnd])
  @@index([trialEndsAt])
  @@map("subscriptions")
}

model PendingSubscriptionChange {
  id                String            @id @default(cuid())
  subscriptionId    String            @unique @map("subscription_id")
  changeType        PendingChangeType @map("change_type")
  targetPlanKey     String?           @map("target_plan_key")
  targetPlanVersion Int?              @map("target_plan_version")
  effectiveAt       DateTime          @map("effective_at") // = currentPeriodEnd
  createdBy         String?           @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at")
  appliedAt         DateTime?         @map("applied_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([effectiveAt, appliedAt])
  @@map("pending_subscription_changes")
}

model SubscriptionEvent {
  id             String              @id @default(cuid())
  subscriptionId String              @map("subscription_id")
  type           String // "trial_started" | "activated" | "plan_changed" | "suspended" | ...
  fromStatus     SubscriptionStatus? @map("from_status")
  toStatus       SubscriptionStatus? @map("to_status")
  actor          String? // user id | "system" | "scheduler"
  metadata       Json?
  at             DateTime            @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, at])
  @@map("subscription_events")
}

model Invoice {
  id                 String          @id @default(cuid())
  billableEntityId   String          @map("billable_entity_id")
  provider           BillingProvider @default(ICOUNT)
  // Reference to the iCount-issued legal tax document (חשבונית מס) - the
  // authoritative record. This row is a thin mirror for in-app display.
  providerInvoiceRef String?         @map("provider_invoice_ref")
  providerPdfUrl     String?         @map("provider_pdf_url")
  type               InvoiceType
  amount             Decimal         @db.Decimal(12, 2)
  currency           String          @default("ILS")
  vat                Decimal?        @db.Decimal(12, 2)
  status             InvoiceStatus   @default(DRAFT)
  lineItems          Json?           @map("line_items")
  issuedAt           DateTime?       @map("issued_at")
  paidAt             DateTime?       @map("paid_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  entity  BillableEntity @relation(fields: [billableEntityId], references: [id], onDelete: Cascade)
  charges Charge[]

  @@index([billableEntityId, createdAt])
  @@index([status])
  @@map("invoices")
}

model Charge {
  id                String          @id @default(cuid())
  invoiceId         String          @map("invoice_id")
  provider          BillingProvider @default(ICOUNT)
  providerChargeRef String?         @map("provider_charge_ref")
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("ILS")
  status            ChargeStatus    @default(PENDING)
  attemptNumber     Int             @default(1) @map("attempt_number")
  failureCode       String?         @map("failure_code")
  idempotencyKey    String          @unique @map("idempotency_key")
  createdAt         DateTime        @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("charges")
}

model AutoPurchasePolicy {
  id               String    @id @default(cuid())
  billableEntityId String    @unique @map("billable_entity_id")
  enabled          Boolean   @default(false)
  thresholdPct     Int       @default(10) @map("threshold_pct") // trigger when remaining <= this % of allowance
  packageKey       String?   @map("package_key")
  maxMonthlySpend  Decimal?  @map("max_monthly_spend") @db.Decimal(12, 2)
  currency         String    @default("ILS")
  monthSpendKey    String?   @map("month_spend_key") // current spend window (billing-cycle anchored)
  monthSpentAmount Decimal   @default(0) @map("month_spent_amount") @db.Decimal(12, 2)
  lastTriggeredAt  DateTime? @map("last_triggered_at")
  updatedBy        String?   @map("updated_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  entity BillableEntity @relation(fields: [billableEntityId], references: [id], onDelete: Cascade)

  @@map("auto_purchase_policies")
}

model DunningState {
  id              String    @id @default(cuid())
  subscriptionId  String    @unique @map("subscription_id")
  stage           Int       @default(0)
  nextRetryAt     DateTime? @map("next_retry_at")
  attempts        Int       @default(0)
  lastFailureCode String?   @map("last_failure_code")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([nextRetryAt])
  @@map("dunning_states")
}

// Immutable log of every provider webhook received - the audit + idempotency
// spine for refunds/chargebacks/payment confirmations. `providerEventId` is
// unique so a redelivered webhook is processed at most once; the raw payload is
// retained so any money event can be reconstructed months later.
model BillingWebhookEvent {
  id              String          @id @default(cuid())
  provider        BillingProvider @default(ICOUNT)
  providerEventId String          @unique @map("provider_event_id")
  eventType       String          @map("event_type")
  tenantId        String?         @map("tenant_id")
  payload         Json
  status          String          @default("RECEIVED") // RECEIVED | PROCESSED | IGNORED | FAILED
  error           String?
  receivedAt      DateTime        @default(now()) @map("received_at")
  processedAt     DateTime?       @map("processed_at")

  @@index([provider, eventType])
  @@index([tenantId])
  @@index([receivedAt])
  @@map("billing_webhook_events")
}

// PERMANENT, provider-neutral evaluation corpus: one row per turn comparing the
// (temporary) Planner's decision to the (shadow) Reasoner's decision over the
// SAME Oracle Facts. Foundation for prompt eval, regression detection, model
// comparison, fine-tuning, Planner-retirement decisions, and future automated
// evals. `reasonerInput` stores the full neutral input so any FUTURE model can
// be replayed against the exact same inputs. NEVER stores provider-specific
// request/response - that stays behind the ReasonerProvider boundary.
model ReasonerShadowEval {
  id            String   @id @default(cuid())
  schemaVersion Int      @default(1) @map("schema_version")
  createdAt     DateTime @default(now()) @map("created_at")

  tenantId       String  @map("tenant_id")
  conversationId String  @map("conversation_id")
  turnId         String  @map("turn_id")
  agentId        String? @map("agent_id")

  /// Replayable, provider-neutral input (Facts + Context + Memory).
  reasonerInput Json @map("reasoner_input")

  /// Both decisions in the ONE canonical vocabulary.
  plannerDecision  Json @map("planner_decision")
  reasonerDecision Json @map("reasoner_decision")

  /// Agreement classification.
  agree          Boolean
  moveTypeMatch  Boolean @map("move_type_match")
  detailMatch    Boolean @map("detail_match")
  divergenceAxis String  @map("divergence_axis") // none | move_type | operation | field

  /// Live-turn correlation (the Planner drove production; nullable/backfilled).
  executedOperation    String? @map("executed_operation")
  runtimeResult        String? @map("runtime_result")
  finalBusinessOutcome String? @map("final_business_outcome")

  /// Provenance / eval axes (provider-neutral).
  provider      String
  model         String
  promptVersion String @map("prompt_version")
  latencyMs     Int?   @map("latency_ms")
  inputTokens   Int?   @map("input_tokens")
  outputTokens  Int?   @map("output_tokens")

  /// Untrusted reasoning rationale (audit/eval only).
  reasoningTrace String? @map("reasoning_trace")
  metadata       Json?

  @@index([tenantId, createdAt])
  @@index([conversationId])
  @@index([divergenceAxis])
  @@index([agree])
  @@index([provider, model, promptVersion])
  @@map("reasoner_shadow_evals")
}

// ─── Agent Loop (autonomous reasoning loop - observability corpus) ─────────
// One run per loop; one iteration row per reason→execute cycle. Fully replayable
// (each iteration stores the provider-neutral Oracle Facts snapshot the Reasoner
// saw). Additive + flag-gated; the legacy Planner remains production.

model AgentLoopRun {
  id        String   @id @default(cuid())
  loopId    String   @unique @map("loop_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenantId       String  @map("tenant_id")
  conversationId String  @map("conversation_id")
  turnId         String  @map("turn_id")
  agentId        String? @map("agent_id")

  /// The business outcome the loop drove toward.
  goal              String?
  /// Exactly one TerminationReason (finish/need_input/escalate/max_iterations/…).
  terminationReason String  @map("termination_reason")
  iterationCount    Int     @map("iteration_count")
  spentUnits        Int     @map("spent_units")
  wallMs            Int     @map("wall_ms")
  /// advisory | autonomous
  mode              String

  finalDecision    Json    @map("final_decision")
  finalReplyIntent Json    @map("final_reply_intent")
  /// The single customer-facing message the Writer produced.
  reply            String?

  provider      String
  model         String
  promptVersion String @map("prompt_version")

  iterations AgentLoopIteration[]

  @@index([tenantId, createdAt])
  @@index([conversationId])
  @@index([terminationReason])
  @@index([goal])
  @@map("agent_loop_runs")
}

model AgentLoopIteration {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  loopId String       @map("loop_id")
  run    AgentLoopRun @relation(fields: [loopId], references: [loopId], onDelete: Cascade)

  tenantId       String @map("tenant_id")
  conversationId String @map("conversation_id")
  iteration      Int

  goal                String?
  /// Provider-neutral Facts snapshot the Reasoner saw this iteration (replayable).
  oracleFactsSnapshot Json    @map("oracle_facts_snapshot")
  /// Short WHY from the Reasoner read (situation/rationale) - audit only.
  reasoningSummary    String  @map("reasoning_summary")

  decisionType      String   @map("decision_type")
  proposedOperation String?  @map("proposed_operation")
  proposedParams    Json?    @map("proposed_params")
  /// ExecutionResult status if an operation ran (EXECUTED/NEEDS_INPUT/FAILED/…).
  runtimeResult     String?  @map("runtime_result")
  /// Neutral Observation projection (status/outcome/reason/invariants).
  observation       Json?
  /// Goal-relevant Facts signature - powers goal-based progress detection.
  factsSignature    String?  @map("facts_signature")
  progressed        Boolean?

  inputTokens  Int? @map("input_tokens")
  outputTokens Int? @map("output_tokens")
  latencyMs    Int? @map("latency_ms")

  @@unique([loopId, iteration])
  @@index([tenantId, createdAt])
  @@index([conversationId])
  @@map("agent_loop_iterations")
}

/// Agent Loop cross-turn memory - the Reasoner's carried-forward conclusions
/// (AgentMemory: committedGoal, workingHypotheses, alreadyAsked, priorReads,
/// openCommitments), scoped per agent × customer so memory follows the customer
/// across conversations. ADVISORY continuity only - Facts always override it.
model AgentCustomerMemory {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  agentId            String   @map("agent_id")
  customerExternalId String   @map("customer_external_id")
  /// The bounded AgentMemory JSON (last turn's Reasoner memoryUpdate).
  memory             Json
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([tenantId, agentId, customerExternalId])
  @@index([tenantId, updatedAt])
  @@map("agent_customer_memory")
}

// ─── Audit Logs (Full System Audit Trail) ──────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  actorType  String   @map("actor_type") // "user" | "ai" | "system"
  actorId    String?  @map("actor_id") // userId or aiAgentId or null for system
  action     String // "message.sent", "ai.responded", "tool.executed", "conversation.updated", etc.
  targetType String?  @map("target_type") // "conversation", "message", "tool", "user", etc.
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, action])
  @@index([tenantId, actorType])
  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─── Flow Canvas (Visual Routing) ──────────────────────────

model FlowCanvas {
  id        String   @id @default(cuid())
  tenantId  String   @unique @map("tenant_id")
  nodes     Json     @default("[]") // [{ id, type: "channel"|"rule"|"flow"|"agent"|"department", position, data }]
  edges     Json     @default("[]") // [{ id, source, target, data }]
  viewport  Json? // { x, y, zoom }
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("flow_canvas")
}

// ─── Business Policy (Per-tenant AI execution policy) ─────
// Persistent source of truth for the AI service's policy engine. Read
// by services/ai/src/services/policy.service.ts on every executeAction.
// Written via the same service's setPolicy(). In-process caching may
// wrap reads but MUST NOT override the DB value.
model BusinessPolicy {
  tenantId  String   @id @map("tenant_id")
  data      Json     @default("{}") // BusinessPolicy shape (maxDiscountPercent, refundRequiresApproval, escalationKeywords, blockedTopics, outboundQuietHours)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("business_policies")
}

// ─── Post-Conversation Config ──────────────────────────────────
//
// Per-tenant schema for the post-conversation summarizer + rule engine.
// Read by services/ai/src/services/post-conversation-config.service.ts at
// the end of every voice call / closed chat. JSON `data` shape:
//
//   {
//     "summaryFields": [
//       { "key": "budget", "label": "Budget", "description": "...", "type": "text" }
//     ],
//     "taskRules": [
//       { "id": "...", "when": { "intent": "pricing_objection" },
//         "task": { "subject": "Send pricing deck", "priority": "normal" } }
//     ],
//     "crmRules": [
//       { "id": "...", "when": { "intent": "ready_to_buy" },
//         "patch": { "status": "qualified" } }
//     ]
//   }
//
// The summarizer feeds `summaryFields[].key` into the LLM prompt as the
// list of allowed sparse-patch keys. taskRules/crmRules are applied by the
// rule engine after summarization. Designed as a single JSONB doc rather
// than three tables so tenants can edit it transactionally from one form.
model PostConversationConfig {
  tenantId  String   @id @map("tenant_id")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("post_conversation_configs")
}

// ─── System Agent Memory ────────────────────────────────────
// Per-user, per-tenant rolling history for the System Copilot (Command
// Center). Isolated from customer Conversation/Message tables so operator
// threads don't leak into customer-facing queries, audit, or realtime
// publishers. Trimmed to a rolling window by agent-runtime.service.
model SystemAgentMessage {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  sessionId  String   @map("session_id")
  role       String // "user" | "assistant" | "tool"
  content    String   @db.Text
  toolCalls  Json?    @map("tool_calls")
  toolCallId String?  @map("tool_call_id")
  toolName   String?  @map("tool_name")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt])
  @@map("system_agent_messages")
}

// ─── Calendar Accounts (Task 3 - schedule_meeting) ───────────
//
// One row per (tenant × AI agent × calendar provider) connection. Stores
// OAuth credentials encrypted at rest using `encryptCredentials` from
// @chatcenter/shared. Token refresh on 401 is the adapter's responsibility;
// when refresh fails permanently, status flips to BROKEN and the schedule
// tool surface drops `schedule_meeting` until a human reconnects.
//
// Provider semantics:
//   - "google_calendar": full OAuth, freebusy + events.insert
//   - "calendly":         OAuth or PAT; can return scheduling links OR
//                         use the Calendly API for slot listings
enum CalendarProvider {
  GOOGLE_CALENDAR
  CALENDLY
}

enum CalendarAccountStatus {
  CONNECTED
  BROKEN
  DISCONNECTED
}

model CalendarAccount {
  id                String                @id @default(cuid())
  tenantId          String                @map("tenant_id")
  /// The AIAgent that owns this calendar binding.
  aiAgentId         String                @map("ai_agent_id")
  provider          CalendarProvider
  /// Encrypted JSON: { accessToken, refreshToken, scope, idToken? }
  credentials       String                @db.Text
  /// Provider's primary calendar id (Google) or user URI (Calendly).
  externalAccountId String                @map("external_account_id")
  /// Optional explicit calendar to write to (Google secondary calendars).
  defaultCalendarId String?               @map("default_calendar_id")
  /// Provider account email - for display + audit.
  accountEmail      String?               @map("account_email")
  /// When access token expires; adapter refreshes 60s before.
  tokenExpiresAt    DateTime?             @map("token_expires_at")
  status            CalendarAccountStatus @default(CONNECTED)
  lastError         String?               @map("last_error")
  lastSyncedAt      DateTime?             @map("last_synced_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([aiAgentId, provider])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("calendar_accounts")
}

// ─── Meeting Types (Task 3 - scheduling policy per meeting kind) ─
//
// One row per tenant-defined meeting kind ("discovery_call", "demo",
// "consultation", ...). Hydrates `SchedulingPolicy` for the constraints
// resolver. Working-hours / windows are stored as JSON arrays of
// `{ weekday, start, end }` matching the resolver's `DayWindow` shape.
model MeetingType {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  /// Used by the schedule_meeting tool's meeting_type arg. Unique per tenant.
  slug                  String
  name                  String
  description           String?
  durationMinutes       Int      @map("duration_minutes")
  /// IANA timezone for working hours (e.g. "Asia/Jerusalem").
  agentTimezone         String   @map("agent_timezone")
  /// [{ weekday: 0..6, start: "HH:MM", end: "HH:MM" }]
  workingHours          Json     @map("working_hours")
  /// Optional stricter window override for this meeting type. Same shape.
  meetingTypeWindows    Json?    @map("meeting_type_windows")
  bufferBeforeMinutes   Int      @default(15) @map("buffer_before_minutes")
  bufferAfterMinutes    Int      @default(15) @map("buffer_after_minutes")
  minNoticeHours        Int      @default(4) @map("min_notice_hours")
  maxHorizonDays        Int      @default(30) @map("max_horizon_days")
  slotResolutionMinutes Int      @default(30) @map("slot_resolution_minutes")
  /// Emails that should ALWAYS be added as attendees (account manager, SE,
  /// internal ops). Merged with the customer's email + additional_guests
  /// the bot collected. Stored as a JSON array of strings.
  autoGuests            Json     @default("[]") @map("auto_guests")
  /// When false, schedule_meeting will reject this slug.
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("meeting_types")
}

// ─── Meeting Bookings (source of truth for booked calendar events) ─
//
// One row per calendar event the bot books, keyed by the customer (not the
// conversation), so reschedule/cancel resolve the EXACT event to act on even
// across separate conversations - and so the bot never invents a duplicate by
// calling schedule_meeting again on a "move it" intent.
//
// Invariant the handlers enforce: at most ONE ACTIVE booking per customer per
// agent. schedule_meeting reschedules the existing ACTIVE booking instead of
// creating a second event; cancel/reschedule look up `eventId` from here.
//
// Replaces the fragile audit-log + email-attendee scan that locked onto the
// wrong duplicate once any existed (the audit scan remains a read-only fallback
// to backfill bookings made before this table existed).
model MeetingBooking {
  id                 String           @id @default(cuid())
  tenantId           String           @map("tenant_id")
  /// The AIAgent that owns the calendar this event lives on.
  aiAgentId          String           @map("ai_agent_id")
  /// Conversation the booking was made in (context only; lookup is by customer).
  conversationId     String           @map("conversation_id")
  /// Stable customer key (WhatsApp phone / channel external id). Same value
  /// across the customer's conversations → reschedule/cancel work cross-thread.
  customerExternalId String?          @map("customer_external_id")
  /// Calendar attendee email (Google invite target), when known.
  customerEmail      String?          @map("customer_email")
  provider           CalendarProvider
  calendarAccountId  String           @map("calendar_account_id")
  /// Source-of-truth calendar event id - what reschedule/cancel PATCH/DELETE.
  eventId            String           @map("event_id")
  meetingTypeSlug    String?          @map("meeting_type_slug")
  startAt            DateTime         @map("start_at")
  endAt              DateTime         @map("end_at")
  customerTimezone   String?          @map("customer_timezone")
  joinUrl            String?          @map("join_url")
  status             BookingStatus    @default(ACTIVE)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([provider, eventId])
  @@index([tenantId, customerExternalId, status])
  @@index([tenantId, conversationId, status])
  @@index([tenantId, aiAgentId, status])
  @@map("meeting_bookings")
}

enum BookingStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

// ─── Tenant Funnel (Task 2 - configurable funnel + playbooks) ─
//
// Tenant-shaped overlay on top of the platform's closed BEL primitives.
// One row per (tenantId × departmentId × funnelId). NULL departmentId means
// "tenant default" - applies to all departments that have no explicit funnel.
// The BEL loads ONE active funnel per (tenantId × departmentId), preferring
// a department-scoped row and falling back to the tenant-default (NULL) row.
model TenantFunnel {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  funnelId          String   @map("funnel_id")
  /// NULL = tenant default (applies when no department-specific funnel exists).
  departmentId      String?  @map("department_id")
  isActive          Boolean  @default(true) @map("is_active")
  /// FunnelStage[] - see funnel-config.service.ts. Each stage may carry
  /// `crmValue` (vendor stage mapping) and `copilot` (per-stage goal,
  /// required questions, required data fields, exit criteria, nextStageId).
  stages            Json
  /// FunnelTransition[]
  transitions       Json     @default("[]")
  /// StrategyOverride[] - optional.
  strategyOverrides Json?    @map("strategy_overrides")
  /// PlaybookOverride[] - optional.
  playbookOverrides Json?    @map("playbook_overrides")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  aiAgents   AIAgent[]   @relation("AIAgentFunnel")

  @@unique([tenantId, departmentId, funnelId])
  @@index([tenantId, departmentId, isActive])
  @@map("tenant_funnels")
}

/// Stage transition audit log.
///
/// Captures every pipeline-stage change initiated by:
///   - AUTO: the post-call summarizer's stage_transition_suggestion auto-
///     applied (confidence ≥ 0.75 + evidence + vendor crmValue).
///   - MANUAL: a rep clicked "Override stage" from the live workspace.
///   - REVIEW_TASK: the summarizer suggested a transition but it was
///     below threshold, so a CRM task was created for human review and
///     the transition was NOT applied. Kept for funnel velocity analytics
///     ("how often does the bot need a human?").
///
/// vendor_write_ok records whether the CRM patch succeeded - for MANUAL
/// and AUTO sources we attempt the vendor write; for REVIEW_TASK it's
/// always false (no write attempted).
model StageTransition {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  conversationId   String   @map("conversation_id")
  contactId        String?  @map("contact_id")
  /// Funnel id at the time of the transition. Captured for historical
  /// accuracy - the funnel may be edited later.
  funnelId         String   @map("funnel_id")
  /// Stage ids (within `tenant_funnels.stages`). Free-form strings so
  /// renames don't break the audit.
  fromStageId      String?  @map("from_stage_id")
  fromStageLabel   String?  @map("from_stage_label")
  toStageId        String   @map("to_stage_id")
  toStageLabel     String?  @map("to_stage_label")
  /// AUTO | MANUAL | REVIEW_TASK - string column so adding sources later
  /// doesn't require an enum migration.
  source           String
  /// 0..1 - null for MANUAL where confidence isn't computed.
  confidence       Float?
  /// Free-text justification (rep-supplied for MANUAL; LLM-supplied for AUTO/REVIEW_TASK).
  reason           String?
  /// Short transcript quotes the LLM cited.
  evidence         Json     @default("[]")
  /// criteriaMet[] from the summarizer output.
  criteriaMet      Json     @default("[]") @map("criteria_met")
  /// criteriaMissed[] from the summarizer output.
  criteriaMissed   Json     @default("[]") @map("criteria_missed")
  /// Vendor stage value that was written (or would have been).
  vendorValue      String?  @map("vendor_value")
  /// True when applyCrmPatchKindAware succeeded; false for REVIEW_TASK
  /// (no write attempted) or any vendor failure.
  vendorWriteOk    Boolean  @default(false) @map("vendor_write_ok")
  /// Vendor adapter error message when vendorWriteOk = false.
  vendorWriteError String?  @map("vendor_write_error")
  /// User id when source=MANUAL; "voice-postcall:<sessionId>" when AUTO/REVIEW_TASK.
  actorId          String?  @map("actor_id")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, createdAt])
  @@map("stage_transitions")
}

// ─── Action Contracts (deterministic tool-chain enforcement) ───
//
// Tenant-defined business rules of the form: "when trigger X fires, call
// these tools - no skipping, optionally in this order, optionally blocking
// the entire conversation until completion."
//
// Enforcement happens at the BEL: matching contracts inject their tool
// requirements into BehaviorState.requiredActions and (when blocking=true)
// strip everything else from allowedActions. The dispatcher tracks
// completion across turns so partial progress survives multi-turn flows.
//
// executionMode:
//   "ALL_REQUIRED" - all tools must execute this conversation, any order
//   "SEQUENCE"     - tools must execute in the listed order; out-of-order
//                    calls fail validation
//   "AT_LEAST_ONE" - any single tool from requiredTools satisfies the contract
model ActionContract {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  /// Business trigger label - matched against deriveTriggeredActions()
  /// output. Standard values: "refund", "booking", "close_conversation",
  /// "follow_up". Custom strings allowed for tenant-specific events.
  trigger       String
  /// JSON array of { name: string } - the tool function names that must
  /// execute. The dispatcher matches by name against the actual tool calls.
  requiredTools Json     @map("required_tools")
  /// "ALL_REQUIRED" | "SEQUENCE" | "AT_LEAST_ONE"
  executionMode String   @map("execution_mode")
  /// Optional ordered tool-name array used when executionMode = SEQUENCE.
  /// When omitted, falls back to the order of `requiredTools`.
  order         Json?
  /// When true, the bot CANNOT reply until the contract is fulfilled.
  /// allowedActions is restricted to only the contract's tools.
  blocking      Boolean  @default(true)
  /// When false, the contract is dormant - kept for audit but not enforced.
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, trigger])
  @@index([tenantId, isActive])
  @@map("action_contracts")
}

// ─── Action Contract Progress (partial completion across turns) ────
//
// One row per (conversationId × contractId). Tracks which required tools
// have already been called so the contract can complete across multiple
// turns. Cleared when the contract is fully satisfied (or the conversation
// is closed without completion - either way, audit trail lives in
// ai.bot_turn logs).
model ActionContractProgress {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  conversationId String    @map("conversation_id")
  contractId     String    @map("contract_id")
  /// JSON array of tool names already executed (in execution order).
  completedTools Json      @default("[]") @map("completed_tools")
  /// Index of the next required tool when executionMode = SEQUENCE.
  nextStepIndex  Int       @default(0) @map("next_step_index")
  /// Set when a tool returned awaiting_approval - contract is paused.
  pausedReason   String?   @map("paused_reason")
  /// Set on completion. When non-null, the row is essentially historical.
  fulfilledAt    DateTime? @map("fulfilled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([conversationId, contractId])
  @@index([tenantId, conversationId])
  @@map("action_contract_progress")
}

// ─── Custom API Tools (tenant-defined HTTP calls as bot tools) ───
//
// The escape hatch: anything we don't ship a first-class adapter for, the
// tenant can wire as a tool by defining a single HTTP request. The
// dispatcher renders the request, calls fetch, parses the response, and
// returns a result the LLM can read.
//
// Auth modes (auth.kind):
//   "none"
//   "bearer"   - Authorization: Bearer <token>   (token in encrypted creds)
//   "api_key"  - header or query param with the configured key name
//   "basic"    - Basic auth user:pass
//
// `parameters` is the OpenAI function-calling schema the LLM sees.
// `urlTemplate` and `bodyTemplate` may contain `{{name}}` placeholders
// resolved from args + a small helper namespace (e.g. {{tenantId}}).
//
// Domain whitelist enforcement happens at dispatch time - the request URL
// must resolve to a host in `allowedHosts` for the tool to fire. This is
// the OWASP-style guardrail against SSRF + accidental exfiltration.
model CustomApiTool {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  /// Tool slug surfaced as `custom.<slug>`. Unique per tenant.
  slug           String
  name           String
  description    String
  /// "Use this tool when …"
  whenToUse      String   @map("when_to_use")
  /// "Do NOT call this tool when …"
  whenNotToUse   String?  @map("when_not_to_use")
  /// "GET" | "POST" | "PUT" | "PATCH" | "DELETE"
  method         String
  /// e.g. "https://api.example.com/v1/orders/{{order_id}}"
  urlTemplate    String   @map("url_template")
  /// Static headers (in addition to auth).
  headers        Json     @default("{}")
  /// Auth descriptor (encrypted via the integration credential helper).
  /// Shape:
  ///   { kind: "none" } |
  ///   { kind: "bearer", tokenEnv?: string }   ← token stored in `secrets.bearer`
  ///   { kind: "api_key", in: "header"|"query", name: "X-API-Key" } ← key in `secrets.apiKey`
  ///   { kind: "basic" } ← user/pass in secrets.basicUser/basicPass
  auth           Json     @default("{\"kind\":\"none\"}")
  /// Encrypted credential blob (bearer token, api key, basic user/pass).
  secrets        String?  @db.Text
  /// Parameter schema in OpenAI function-calling shape.
  /// { type:"object", properties:{...}, required:[...] }
  parameters     Json     @default("{\"type\":\"object\",\"properties\":{},\"required\":[]}")
  /// Body template - string with {{placeholders}} or null for no body.
  bodyTemplate   String?  @map("body_template") @db.Text
  /// Optional response mapping - JSONPath-like dotted paths summarized for the LLM.
  /// e.g. ["data.id", "data.amount"] - adapter returns just these fields when set.
  responseFields Json?    @map("response_fields")
  /// Domain whitelist - exact host match enforced at dispatch.
  allowedHosts   Json     @default("[]") @map("allowed_hosts")
  /// "READ" | "WRITE" | "DELETE" | "ACTION" - drives permission filtering.
  category       String   @default("READ")
  /// "LOW" | "MEDIUM" | "HIGH" - HIGH-risk auto-requires approval.
  riskLevel      String   @default("MEDIUM") @map("risk_level")
  /// Soft-disable without deleting.
  isActive       Boolean  @default(true) @map("is_active")
  /// Timeout in ms (default 10s).
  timeoutMs      Int      @default(10000) @map("timeout_ms")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("custom_api_tools")
}

// ─── Custom DB Query Tools ──────────────────────────────────
//
// Per-tenant pre-canned SQL/Mongo queries the AI can call as
// `custom_db.<slug>`. Safer than generic `postgres.query_table` because the
// admin defines the exact shape - the AI only fills in named params that match
// `parameterSchema`. No raw SQL is ever assembled at runtime: the template is
// passed verbatim to the driver with `$1, $2…` (Postgres) / positional `?`
// (MySQL) / typed Mongo filter (MongoDB).
model CustomDbQueryTool {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  /// One of: "postgresql" | "aws_rds" | "mongodb" - must match a CONNECTED
  /// integration on this tenant.
  providerSlug    String   @map("provider_slug")
  /// Tool slug surfaced as `custom_db.<slug>`. Unique per tenant.
  slug            String
  name            String
  description     String
  whenToUse       String   @map("when_to_use")
  whenNotToUse    String?  @map("when_not_to_use") @db.Text
  /// The query body. For Postgres/MySQL: SQL with `$1, $2…` (or `?` MySQL)
  /// placeholders. For MongoDB: a JSON object - `collection`, `op`
  /// ("find"|"findOne"|"insertOne"|"updateOne"|"deleteOne"), `filter`,
  /// `update`, `doc` - fields can be `{{paramName}}` for substitution.
  queryTemplate   String   @map("query_template") @db.Text
  /// Parameter schema in OpenAI function-calling shape - describes the
  /// args the AI must fill. Order matters for SQL `$1, $2…`.
  parameterSchema Json     @default("{\"type\":\"object\",\"properties\":{},\"required\":[]}") @map("parameter_schema")
  /// Param order - array of property names matching the SQL placeholders'
  /// numeric order. e.g. ["customer_email", "since"] → $1=email, $2=since.
  parameterOrder  Json     @default("[]") @map("parameter_order")
  /// "READ" | "WRITE" | "DELETE" | "ACTION".
  category        String   @default("READ")
  riskLevel       String   @default("LOW") @map("risk_level")
  isActive        Boolean  @default(true) @map("is_active")
  /// Hard cap on rows returned (Postgres/RDS) or docs returned (Mongo).
  maxRows         Int      @default(100) @map("max_rows")
  /// Statement timeout in ms (default 5s).
  timeoutMs       Int      @default(5000) @map("timeout_ms")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@index([tenantId, providerSlug])
  @@map("custom_db_query_tools")
}

// ─── Voice Call Session (Phase 2) ──────────────────────────────
//
// Durable per-call lifecycle distinct from Conversation. A Conversation can
// have multiple call attempts (transfer, callback) and we need per-call
// durable state that survives WS drops. The runtime layer
// (services/voice-copilot) will write these rows in Phase 3.

model VoiceCallSession {
  id              String    @id @default(cuid())
  callSid         String    @unique @map("call_sid")
  conversationId  String    @unique @map("conversation_id")
  tenantId        String    @map("tenant_id")
  agentId         String?   @map("agent_id")
  customerId      String?   @map("customer_id")
  customerNumber  String    @map("customer_number")
  agentNumber     String?   @map("agent_number")
  direction       String // "inbound" | "outbound"
  status          String // "ringing" | "in-progress" | "completed" | "failed" | "no-answer"
  startedAt       DateTime  @default(now()) @map("started_at")
  answeredAt      DateTime? @map("answered_at")
  endedAt         DateTime? @map("ended_at")
  durationMs      Int?      @map("duration_ms")
  recordingUrl    String?   @map("recording_url")
  recordingStatus String?   @map("recording_status") // "pending" | "available" | "failed"
  endReason       String?   @map("end_reason")
  meta            Json?

  // ─── Phase 1 (Live Call CoPilot) additions ───
  // All nullable / default-safe so existing rows keep their legacy `status`
  // string semantics. New writers populate BOTH columns during the 2-week
  // dual-write window; readers may rely on whichever is preferred.
  channelId       String?    @map("channel_id")
  state           CallState? // typed FSM state - see translator in voice-copilot/state
  stateHistory    Json       @default("[]") @map("state_history") // [{state, at, reason}]
  assignedAgentId String?    @map("assigned_agent_id")
  claimedAt       DateTime?  @map("claimed_at")
  // For MISSED inbound sessions: stamped when the agent has actually
  // dealt with the missed call - either by clicking "Mark as handled"
  // in the inbox, or implicitly when a successful callback to the same
  // customerNumber reaches ACTIVE. The /missed query filters these out,
  // so they stop nagging the inbox once the loop is closed. Cascades
  // server-side, so the WhatsApp template button (which dials without
  // any browser context) still clears the inbox correctly.
  handledAt       DateTime?  @map("handled_at")

  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation   Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel        CommunicationChannel?     @relation(fields: [channelId], references: [id])
  postProcessing VoiceCallPostProcessing?
  actionItems    VoiceCallActionItem[]
  participants   VoiceSessionParticipant[]

  @@index([tenantId, startedAt])
  @@index([agentId, startedAt])
  @@index([tenantId, state])
  @@index([assignedAgentId, state])
  @@index([channelId])
  @@map("voice_call_sessions")
}

// One row per leg ever joined to a voice session's conference: the
// original customer, the agent who answered, and any 3rd party brought
// in via add-participant. Drives the live participants panel (per-row
// hold / hangup) and, post-call, lets the summarizer attribute the
// transcript to additional CRM contacts when an added leg matched a
// known Contact by phone.
//
// ADDED rows are created at dial-time (status=DIALING, callSid=null)
// and matched on conference participant-join by `label` (Twilio echoes
// it back as ParticipantLabel). CUSTOMER + AGENT rows are upserted at
// participant-join time by callSid.
enum VoiceParticipantRole {
  CUSTOMER
  AGENT
  ADDED
}

enum VoiceParticipantStatus {
  DIALING
  JOINED
  LEFT
  FAILED
}

model VoiceSessionParticipant {
  id          String                 @id @default(cuid())
  sessionId   String                 @map("session_id")
  role        VoiceParticipantRole
  status      VoiceParticipantStatus @default(DIALING)
  // Provider leg SID (Twilio CallSid). Null until participant-join fires
  // for ADDED rows (we dial first, learn the SID from the webhook).
  callSid     String?                @map("call_sid")
  // Free-form display label. For ADDED rows this is the label passed to
  // add-participant (used to match the webhook back to this row). For
  // AGENT/CUSTOMER rows it's a stable identifier ("agent"/"customer").
  label       String?
  phoneNumber String?                @map("phone_number")
  displayName String?                @map("display_name")
  // Optional FK to a Contact in this tenant matched by phone at
  // participant-join time. Drives multi-contact summary attribution.
  contactId   String?                @map("contact_id")
  // Whisper/consult mode: true when the leg is parked on hold music.
  onHold      Boolean                @default(false) @map("on_hold")
  joinedAt    DateTime?              @map("joined_at")
  leftAt      DateTime?              @map("left_at")
  endReason   String?                @map("end_reason")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  session VoiceCallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contact Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([sessionId, callSid])
  @@unique([sessionId, label])
  @@index([sessionId, role])
  @@index([sessionId, leftAt])
  @@index([contactId])
  @@map("voice_session_participants")
}

// ─── Call Analysis (Phase 2) ───────────────────────────────────
//
// Stores the stream of ConversationStateFrames emitted by the intelligence
// engine. One row per conversation. Live mode appends frames during the
// call; QA / Async modes write at completion. The frames JSONB is the
// source of truth for both the live UI replay and the post-call analyzers.

model CallAnalysis {
  id             String    @id @default(cuid())
  conversationId String    @unique @map("conversation_id")
  callSid        String?   @unique @map("call_sid")
  tenantId       String    @map("tenant_id")
  mode           String // "live" | "qa" | "async"
  status         String // "running" | "completed" | "failed"
  frames         Json      @default("[]") // ConversationStateFrame[]
  rollingSummary String?   @map("rolling_summary")
  finalSummary   String?   @map("final_summary")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  meta           Json?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  qaScores     QAScore[]

  @@index([tenantId, startedAt])
  @@index([conversationId])
  @@map("call_analyses")
}

// ─── Call Playbook (Phase 2) ───────────────────────────────────
//
// Tenant-configurable conversation guidance. Each playbook contains ordered
// stages (greeting → discovery → ... → close). The StageClassifier in the
// intelligence engine maps live transcript to a current stage; the prompt
// assembler injects the active stage's hints into the LLM call.

model CallPlaybook {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  active      Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages CallPlaybookStage[]

  @@unique([tenantId, name, version])
  @@index([tenantId, active])
  @@map("call_playbooks")
}

model CallPlaybookStage {
  id             String   @id @default(cuid())
  playbookId     String   @map("playbook_id")
  ordinal        Int
  name           String
  description    String
  /// Natural-language description; the StageClassifier reads it.
  exitCriteria   String   @map("exit_criteria")
  /// Field names from MissingFieldDefinition required to leave this stage.
  requiredFields String[] @map("required_fields")
  /// Tenant-authored stage hints injected into prompt when this stage is active.
  prompts        Json?

  playbook CallPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@unique([playbookId, ordinal])
  @@map("call_playbook_stages")
}

// ─── Missing Field Definition (Phase 2) ────────────────────────
//
// Per-tenant required slots the MissingFieldExtractor checks against. Field
// path is dotted (e.g. "customer.budget", "deal.timeframe") so analyzers can
// resolve into structured CRM data without a model migration per slot.

model MissingFieldDefinition {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  /// Dotted path: "customer.budget", "deal.timeframe".
  field           String
  label           String
  description     String?
  required        Boolean  @default(true)
  /// Empty array = applies to every stage. CallPlaybookStage IDs otherwise.
  appliesToStages String[] @map("applies_to_stages")
  /// Suggested phrasing for the rep when prompting for this field.
  hintQuestion    String?  @map("hint_question")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, field])
  @@map("missing_field_definitions")
}

// ─── Tool Execution Request (Phase 2) ──────────────────────────
//
// Renamed from doc's "ToolExecution" to avoid collision with the existing
// ToolExecution model (which is a successful-execution log, not a lifecycle
// record). The ActionOrchestrator (Phase 4) writes these rows for the full
// proposed → approved → running → completed/failed/denied lifecycle.

model ToolExecutionRequest {
  id             String    @id @default(cuid())
  conversationId String    @map("conversation_id")
  tenantId       String    @map("tenant_id")
  /// {mode: "chat"|"live"|"post-call", system: string}
  proposedBy     Json      @map("proposed_by")
  /// {agentId: string}
  actor          Json
  tool           String
  args           Json      @default("{}")
  rationale      String
  /// "proposed" | "approved" | "running" | "completed" | "denied" | "failed"
  status         String
  result         Json?
  error          String?
  attempts       Int       @default(0)
  proposedAt     DateTime  @default(now()) @map("proposed_at")
  decidedAt      DateTime? @map("decided_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([conversationId, proposedAt])
  @@index([tenantId, status])
  @@map("tool_execution_requests")
}

// ─── QA Score (Phase 2 - Mode A output) ────────────────────────
//
// Mode A walks persisted CallAnalysis.frames and scores them against
// playbook compliance, coaching opportunities, and risk. refLiveFrameVersions
// makes every score auditable back to specific live frames.

model QAScore {
  id                      String   @id @default(cuid())
  callAnalysisId          String   @map("call_analysis_id")
  conversationId          String   @map("conversation_id")
  rubricVersion           String   @map("rubric_version")
  playbookComplianceScore Float    @map("playbook_compliance_score")
  coachingScore           Float    @map("coaching_score")
  riskScore               Float    @map("risk_score")
  /// Finding[] - {kind, refUtteranceIds, note}
  findings                Json     @default("[]")
  refLiveFrameVersions    Int[]    @map("ref_live_frame_versions")
  scoredAt                DateTime @default(now()) @map("scored_at")

  callAnalysis CallAnalysis @relation(fields: [callAnalysisId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([scoredAt])
  @@map("qa_scores")
}

// ─── Live Call CoPilot - Phase 1 ────────────────────────────────
//
// All models below are net-new and additive. No existing reader/writer is
// required to consult them. Existing voice (shared-Twilio) tenants ignore
// these tables entirely; opt-in tenants get a row populated only when they
// turn on `voiceCopilotEnabled` and either onboard a BYO channel or have
// an inbound call land on the shared channel.

enum VoiceAuthType {
  BYO // tenant supplied their own Twilio credentials, decrypted from `CommunicationChannel.encryptedSecrets`
}

enum CommunicationChannelStatus {
  PENDING
  ACTIVE
  DISABLED
  ERROR
}

// How a voice channel answers inbound calls.
//   IN_PLATFORM      - Twilio bridges into a conference + media stream so
//                      the agent answers in-browser with Live Call Copilot.
//   FORWARD_TO_AGENT - TwiML simply <Dial>s the channel's defaultAgent's
//                      `phoneNumber` (e.g. their mobile). No conference,
//                      no copilot. Used when the agent is on the road.
enum VoiceInboundMode {
  IN_PLATFORM
  FORWARD_TO_AGENT
}

// How a voice channel places outbound calls.
//   IN_PLATFORM       - Agent's browser places the call via the Voice SDK,
//                       Twilio fires /outbound TwiML, customer is dialed
//                       into the conference. Default; current behavior.
//   AGENT_FIRST       - Twilio REST first dials the default agent's
//                       phoneNumber. Their TwiML answer joins them into
//                       a conference; the customer is then dialed and
//                       bridged. Used when the agent works off a mobile
//                       and the platform initiates the dial (e.g. from
//                       the missed-calls inbox or a pre-signed callback
//                       link in a WhatsApp template).
enum VoiceOutboundMode {
  IN_PLATFORM
  AGENT_FIRST
}

enum CallState {
  RINGING
  CONNECTING
  ACTIVE
  HOLD
  ENDED
  FAILED
  MISSED
}

enum PresenceStatus {
  ONLINE
  BUSY
  OFFLINE
}

enum PostCallStage {
  PENDING
  TRANSCRIPT_FINALIZED
  SUMMARIZED
  ACTION_ITEMS_EXTRACTED
  CRM_WRITTEN
  FOLLOWUP_GENERATED
  FINALIZED
  FAILED
}

enum ActionItemStatus {
  PROPOSED
  ACCEPTED
  DISMISSED
  DONE
}

// Polymorphic parent for any communication-channel integration. Phase 1
// only spawns VoiceChannel children, but the structure is shaped so
// WhatsApp / SMS / Email can later join the same parent without another
// schema rev (their tenant integrations stay where they are today; the
// shared parent merely lets us reason uniformly over channel rows).
model CommunicationChannel {
  id               String                     @id @default(cuid())
  tenantId         String                     @map("tenant_id")
  channelType      ChannelType                @map("channel_type")
  provider         String // "twilio" | future: "sip" | "aircall" | …
  authType         VoiceAuthType              @default(BYO) @map("auth_type")
  friendlyName     String                     @map("friendly_name")
  status           CommunicationChannelStatus @default(PENDING)
  capabilities     Json                       @default("{}") // {inbound, outbound, mediaStream}
  config           Json                       @default("{}") // non-secret config (region, phoneNumber, …)
  encryptedSecrets Bytes?                     @map("encrypted_secrets") // aes-256-gcm via existing util
  webhookSecret    String?                    @map("webhook_secret") // per-channel HMAC, URL-path auth
  healthCheckedAt  DateTime?                  @map("health_checked_at")
  healthStatus     String?                    @map("health_status")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voiceChannel      VoiceChannel?
  voiceCallSessions VoiceCallSession[]

  @@index([tenantId, channelType, status])
  @@map("communication_channels")
}

// Voice-specific specialization. Encrypted Twilio tokens live in the
// parent's `encryptedSecrets`; non-secret config (account SID, phone, …)
// lives here for indexability.
model VoiceChannel {
  id                     String  @id @default(cuid())
  communicationChannelId String  @unique @map("communication_channel_id")
  accountSid             String? @map("account_sid") // Twilio-specific
  twimlAppSid            String? @map("twiml_app_sid") // Twilio-specific
  apiKeySid              String? @map("api_key_sid") // Twilio-specific

  // Per-channel Live Call Copilot configuration. Shape:
  //   {
  //     language: "he" | "en" | ...,            // copilot UI + LLM output language
  //     persona:  string,                       // short tone/persona descriptor
  //     goals:    string,                       // free-text objective (e.g. "Schedule a demo")
  //     questions: { id, text, required }[],    // questions the rep MUST ask
  //     dataFields: { field, label, required }[] // fields the call MUST collect
  //   }
  // Stored as Json (not 5 columns) so the shape can evolve without
  // migrations. Empty {} means "use platform defaults".
  copilotConfig Json @default("{}") @map("copilot_config")

  // Inbound call routing. When `defaultAgentId` is set, the call rings
  // ONLY that user's browser for the first `ringTimeoutSeconds` (default
  // 20s); if still un-claimed after the timeout it broadcasts to every
  // member of `fallbackDepartmentId` (or, if null, to the whole tenant
  // as today). Null `defaultAgentId` = legacy tenant-broadcast behavior.
  defaultAgentId       String? @map("default_agent_id")
  fallbackDepartmentId String? @map("fallback_department_id")
  ringTimeoutSeconds   Int     @default(20) @map("ring_timeout_seconds")

  // Hard cap on how long an inbound call can ring before the platform
  // hangs up the customer leg and marks the session MISSED. Null = no
  // auto-hangup (legacy behavior; the call rings until Twilio's own
  // `<Dial timeout>` gives up or the customer hangs up). When set, the
  // value is interpreted in seconds; the runtime clamps it to a safe
  // [10, 120] range so we never outlive Twilio's call window.
  autoHangupSeconds Int? @map("auto_hangup_seconds")

  // How inbound calls are answered:
  //   IN_PLATFORM       - Twilio media stream + browser-side answer with
  //                       Live Call Copilot (default; current behavior).
  //   FORWARD_TO_AGENT  - TwiML directly <Dial>s defaultAgent.phoneNumber.
  //                       No conference, no media stream, no copilot. If
  //                       the agent's mobile doesn't pick up, the session
  //                       is recorded as MISSED and the WABA missed-call
  //                       alert template fires (if configured).
  inboundMode VoiceInboundMode @default(IN_PLATFORM) @map("inbound_mode")

  // How outbound calls are placed. AGENT_FIRST means the platform calls
  // the agent's mobile first (via Twilio REST), and only after they
  // answer does the platform dial the customer and bridge them. The
  // missed-call callback flow uses this so the agent isn't tied to the
  // browser to return a missed call.
  outboundMode VoiceOutboundMode @default(IN_PLATFORM) @map("outbound_mode")

  // Whose mobile rings when `outboundMode = AGENT_FIRST`. Separate from
  // `defaultAgentId` so the inbound-default and the outbound-target can
  // be different people (e.g. inbound goes to a support rep, outbound
  // goes to a sales rep). Null → falls back to `defaultAgentId` for
  // backward compatibility.
  agentFirstAgentId String? @map("agent_first_agent_id")

  // When `outboundMode = AGENT_FIRST`, this controls whether the
  // workspace page opens in the browser. Default ON (current behavior).
  // OFF is for "fire and forget" outbound - the agent clicks call, the
  // mobile rings, no UI needed; useful when the agent isn't at the
  // computer. Recording / transcription / summary still happen.
  openWorkspaceOnAgentFirst Boolean @default(true) @map("open_workspace_on_agent_first")

  // Phase 6: AI Employee assigned to this voice channel as a first-class
  // FK. Drives call-pilot turns (mode=callpilot) - same AIAgent that runs
  // the tenant's chat/copilot turns. Migrated out of the copilotConfig
  // JSONB blob; the JSONB field is retained for backwards-compat reads
  // for one release window, then dropped.
  aiAgentId String? @map("ai_agent_id")

  parent             CommunicationChannel      @relation(fields: [communicationChannelId], references: [id], onDelete: Cascade)
  defaultAgent       User?                     @relation("VoiceChannelDefaultAgent", fields: [defaultAgentId], references: [id], onDelete: SetNull)
  agentFirstAgent    User?                     @relation("VoiceChannelAgentFirstAgent", fields: [agentFirstAgentId], references: [id], onDelete: SetNull)
  fallbackDepartment Department?               @relation("VoiceChannelFallbackDept", fields: [fallbackDepartmentId], references: [id], onDelete: SetNull)
  aiAgent            AIAgent?                  @relation("VoiceChannelAIAgent", fields: [aiAgentId], references: [id], onDelete: SetNull)
  phoneNumbers       VoiceChannelPhoneNumber[]

  @@index([agentFirstAgentId])
  @@index([aiAgentId])
  @@map("voice_channels")
}

// Phone numbers discovered from Twilio per voice channel. One channel
// (i.e. one Twilio sub-account) can own many numbers; admins flip
// `isActive` to wire a number to the inbound webhook.
model VoiceChannelPhoneNumber {
  id             String   @id @default(cuid())
  voiceChannelId String   @map("voice_channel_id")
  e164           String   @unique
  twilioSid      String?  @map("twilio_sid")
  friendlyName   String?  @map("friendly_name")
  isActive       Boolean  @default(false) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  voiceChannel VoiceChannel @relation(fields: [voiceChannelId], references: [id], onDelete: Cascade)

  @@unique([voiceChannelId, e164])
  @@index([voiceChannelId])
  @@index([isActive])
  @@map("voice_channel_phone_numbers")
}

// Per-agent presence. MVP: tenant-wide broadcast. Schema admits future
// per-skill / per-department routing without another migration.
model AgentPresence {
  agentId              String         @id @map("agent_id")
  tenantId             String         @map("tenant_id")
  status               PresenceStatus @default(OFFLINE)
  activeVoiceSessionId String?        @map("active_voice_session_id")
  lastSeenAt           DateTime       @default(now()) @map("last_seen_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([lastSeenAt])
  @@map("agent_presences")
}

// Post-call pipeline tracker. One row per VoiceCallSession; rows are
// inserted when the session ends and progress through `stage`. Each stage
// is idempotent + individually retryable.
model VoiceCallPostProcessing {
  id         String        @id @default(cuid())
  sessionId  String        @unique @map("session_id")
  stage      PostCallStage @default(PENDING)
  attempts   Int           @default(0)
  lastError  String?       @map("last_error")
  startedAt  DateTime      @default(now()) @map("started_at")
  finishedAt DateTime?     @map("finished_at")
  meta       Json?

  session VoiceCallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([stage])
  @@map("voice_call_post_processing")
}

// Structured action items extracted from a completed call. Surfaced in
// the workspace's right panel ("Follow-up" card) for agent triage.
model VoiceCallActionItem {
  id         String           @id @default(cuid())
  sessionId  String           @map("session_id")
  title      String
  details    String?
  status     ActionItemStatus @default(PROPOSED)
  assignedTo String?          @map("assigned_to")
  dueAt      DateTime?        @map("due_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  session VoiceCallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@map("voice_call_action_items")
}

// ─── Customer Brief ────────────────────────────────────────
//
// Persistent, customer-level behavioral brief that lives BEYOND any single
// conversation. Updated whenever a chat closes or a call hangs up so the
// next agent (or AI) has the latest read on:
//   • mood arc across channels
//   • disappointment / churn-risk signals
//   • tone preferences (formal/casual, short/long-winded, language)
//   • what makes this customer feel good
//   • engagement style
//
// One row per (tenantId, identityKey, locale). identityKey is a derived
// stable key: "person:<id>" | "crm:<vendor>:<id>" | "contact:<id>". Multiple
// keys can exist for the same human until the identity layers converge - the
// writer always picks the strongest available (person > crm > contact).
//
// Locale stored explicitly so a tenant with Hebrew + English agents gets one
// brief per language without re-asking the LLM each time.
model CustomerBrief {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")

  identityKey   String  @map("identity_key")
  personId      String? @map("person_id")
  crmContactId  String? @map("crm_contact_id")
  crmObjectKind String? @map("crm_object_kind")
  contactId     String? @map("contact_id")

  locale String @default("en")

  // Headline behavioral briefing (3-5 sentences). Plain prose, agent-facing.
  brief String

  // Short "things to keep in mind RIGHT NOW" phrases (≤5 items).
  signals Json @default("[]")

  // Behavioral tags - nullable so the LLM can omit when it lacks signal.
  tone                 String?
  mood                 String?
  // Free-form list of recommended behaviors for THIS customer (e.g.
  // "lead with empathy", "skip small talk", "confirm next step in writing").
  recommendedBehaviors Json    @default("[]") @map("recommended_behaviors")

  // Provenance - what the brief is summarizing.
  channels          Json    @default("[]")
  conversationCount Int     @default(0) @map("conversation_count")
  lastSourceChannel String? @map("last_source_channel")
  lastSourceConvId  String? @map("last_source_conv_id")
  lastSourceEvent   String? @map("last_source_event")

  generatedAt DateTime @default(now()) @map("generated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, identityKey, locale])
  @@index([tenantId])
  @@index([tenantId, personId])
  @@index([tenantId, crmContactId])
  @@index([tenantId, contactId])
  @@map("customer_briefs")
}

// ─── Copilot Cue Trust Loop ────────────────────────────────
//
// Per-cue feedback recorded when the rep accepts (used it), rejects
// (dismissed), or ignores (TTL expired un-acted) a live call copilot cue.
//
// Aggregated per (cueKind, cueText) → drives the Laplace-smoothed weight
// CueProjector uses to threshold future surfaces. Without this loop the
// copilot can't learn from rep behavior and trust degrades over time.
model CopilotCueOutcome {
  id             BigInt   @id @default(autoincrement())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  cueId          String   @map("cue_id")
  cueKind        String   @map("cue_kind")
  cueText        String   @map("cue_text")
  dedupKey       String   @map("dedup_key")
  outcome        String
  recordedAt     DateTime @default(now()) @map("recorded_at")

  @@index([cueKind, cueText])
  @@index([tenantId, conversationId])
  @@map("copilot_cue_outcomes")
}

// ─── Feature Permissions ─────────────────────────────────────
//
// Two-layer model:
//   1. TenantFeature      - SYSTEM_ADMIN says "this tenant can use feature X"
//   2. TenantRole + grants - tenant ADMIN says "this user/role can use feature X"
//
// Feature keys are defined in code at packages/shared/src/lib/features.ts
// (FEATURES const). The DB stores them as opaque strings so adding a feature
// is a code change + a row insert, not a schema migration.
//
// Resolution order for hasFeature(user, tenant, feature):
//   SYSTEM_ADMIN              → true
//   tenant feature disabled   → false
//   user-level revoke         → false
//   user-level grant          → true
//   ADMIN role                → true
//   role assignment grants it → true
//   AGENT + defaultAgentAccess="all" → true
//   else                      → false

model TenantFeature {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  feature   String // matches FEATURES key
  enabled   Boolean  @default(false)
  // Optional feature-specific config (e.g. auto-buy spending limits).
  config    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // Audit: who flipped it. NULL for system-seeded rows (migrations, backfill).
  updatedBy String?  @map("updated_by")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature])
  @@index([tenantId])
  @@map("tenant_features")
}

model TenantRole {
  id           String          @id @default(cuid())
  tenantId     String          @map("tenant_id")
  name         String
  description  String?
  // System-managed roles (e.g. seeded "Default Agent") cannot be deleted
  // by tenant admins. Custom roles created by the tenant admin can.
  isSystem     Boolean         @default(false) @map("is_system")
  // Stable key for built-in roles (owner|admin|department_manager|agent).
  // NULL for tenant-created custom roles. Lets the resolver/seed identify
  // built-ins without matching on the (localizable) display name.
  builtinKey   String?         @map("builtin_key")
  // Default data-reach for users assigned this role. Overridable per
  // assignment (UserRoleAssignment.scope).
  defaultScope PermissionScope @default(OWN) @map("default_scope")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  features    TenantRoleFeature[]
  assignments UserRoleAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tenant_roles")
}

model TenantRoleFeature {
  roleId    String   @map("role_id")
  feature   String // matches FEATURES key
  createdAt DateTime @default(now()) @map("created_at")

  role TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, feature])
  @@index([feature])
  @@map("tenant_role_features")
}

model UserRoleAssignment {
  userId     String           @map("user_id")
  roleId     String           @map("role_id")
  // Per-assignment scope override. NULL = inherit the role's defaultScope.
  scope      PermissionScope? @map("scope")
  assignedAt DateTime         @default(now()) @map("assigned_at")
  assignedBy String?          @map("assigned_by")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

model UserFeatureGrant {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  feature   String // matches FEATURES key
  // true  = explicit grant (overrides "no role grant")
  // false = explicit revoke (overrides "role grants this")
  granted   Boolean
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([userId])
  @@map("user_feature_grants")
}

// ─────────────────────────────────────────────────────────────
// Customer Intelligence (V2 domain model) - Phase 1 foundation.
// See docs/customer-intelligence-domain-model.md.
//
// Three intelligence scopes with distinct ownership + lifecycle:
//   CUSTOMER     - durable, per-identity facts (CustomerProfile)
//   OPPORTUNITY  - per-deal facts (Opportunity), N per customer
//   CONVERSATION - per-interaction (existing ConversationIntelligence)
//
// FieldDefinition is the scope-aware schema registry (evolves the flat
// PostConversationConfig.summaryFields). IntelligencePack bundles field
// templates per vertical. IntelligenceFact is the append-only provenance
// log; entity `facts` JSON is the denormalized read snapshot.
// ─────────────────────────────────────────────────────────────

enum IntelligenceScope {
  CUSTOMER
  OPPORTUNITY
  CONVERSATION
  // Migration-safety scope: a field whose true scope could not be determined
  // automatically (e.g. backfilled from legacy summaryFields). The ingest
  // layer NEVER routes/writes a REVIEW_REQUIRED field - it is parked until a
  // human assigns a real scope in the Fields Builder. Incorrect scope is worse
  // than manual review.
  REVIEW_REQUIRED
}

enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
  ENUM
  DATE
  ENTITY_REF
}

enum FactSource {
  MANUAL
  CRM_INBOUND
  LLM_CLOSE
  LLM_LIVE
  RULE
  DERIVED
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  ABANDONED
  ARCHIVED
}

enum FieldOrigin {
  PACK
  CUSTOM
  DISCOVERED
}

// Durable, language-neutral per-identity customer record. The identity spine
// mirrors CustomerBrief (which becomes a prose projection of this). One row
// per resolved identity per tenant.
model CustomerProfile {
  id            String  @id @default(cuid())
  tenantId      String  @map("tenant_id")
  identityKey   String  @map("identity_key")
  personId      String? @map("person_id")
  contactId     String? @map("contact_id")
  crmContactId  String? @map("crm_contact_id")
  crmObjectKind String? @map("crm_object_kind")

  displayName String? @map("display_name")
  phone       String?
  email       String?

  // Denormalized snapshot of durable CUSTOMER-scope facts: { fieldKey: value }.
  // Source of truth for history/provenance is IntelligenceFact.
  facts             Json @default("{}")
  // BEL trust/friction/relationship signals (behavioral).
  behavioralSignals Json @default("{}") @map("behavioral_signals")

  firstSeenAt DateTime? @map("first_seen_at")
  lastSeenAt  DateTime? @map("last_seen_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  opportunities Opportunity[]

  @@unique([tenantId, identityKey])
  @@index([tenantId])
  @@index([tenantId, crmContactId])
  @@map("customer_profiles")
}

// Per-deal intelligence. The home for "industry pack" facts (event_date,
// guest_count, budget, …). A customer may have many, concurrent or sequential.
model Opportunity {
  id                String            @id @default(cuid())
  tenantId          String            @map("tenant_id")
  customerProfileId String            @map("customer_profile_id")
  type              String // pack slug, e.g. "event_hall"
  packId            String?           @map("pack_id")
  title             String?
  stage             String? // references a TenantFunnel/FunnelStage id
  status            OpportunityStatus @default(OPEN)
  estimatedValue    Float?            @map("estimated_value")
  nextAction        String?           @map("next_action")

  // Denormalized snapshot of OPPORTUNITY-scope facts: { fieldKey: value }.
  facts         Json @default("{}")
  // Cross-entity edges (implicit graph): decision_maker, proposed_entity, …
  relationships Json @default("{}")

  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  lastActivityAt DateTime? @map("last_activity_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  customerProfile CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, customerProfileId])
  @@index([tenantId, status])
  @@map("opportunities")
}

// A named, versioned bundle of FieldDefinition templates for a vertical.
// `tenantId == null` => system pack (shared, shippable). Applying a pack
// clones its `fields` template into per-tenant FieldDefinition rows.
model IntelligencePack {
  id           String   @id @default(cuid())
  tenantId     String?  @map("tenant_id") // null = system pack
  slug         String
  name         String
  version      Int      @default(1)
  // SummaryFieldDef[]-shaped template, each entry scope-tagged.
  fields       Json     @default("[]")
  defaultRules Json     @default("{}") @map("default_rules")
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([isSystem])
  @@map("intelligence_packs")
}

// Per-tenant active schema registry. Each field declares the SCOPE it owns
// (customer/opportunity/conversation) - the core anti-overwrite mechanic.
model FieldDefinition {
  id                  String            @id @default(cuid())
  tenantId            String            @map("tenant_id")
  key                 String // stable snake_case
  label               String
  description         String?
  type                FieldType         @default(TEXT)
  scope               IntelligenceScope @default(OPPORTUNITY)
  options             Json              @default("[]") // enum values
  required            Boolean           @default(false)
  // Few-shot extraction hints shown to the LLM: array of plain strings, e.g.
  // ["around 300 guests", "we're 250 people"]. Sharpen extraction accuracy.
  examples            Json              @default("[]")
  // Phrases that look similar but must NOT fill this field (optional). Kills
  // common false positives. Array of plain strings.
  negativeExamples    Json              @default("[]") @map("negative_examples")
  // Minimum extraction confidence (0-1) before a value is auto-applied. Below
  // this, the value is routed to the human-review queue instead of the CRM.
  // null → tenant/global default applies.
  confidenceThreshold Float?            @map("confidence_threshold")
  // Stages where the field is expected (Missing-Info engine).
  stageRelevance      Json              @default("[]") @map("stage_relevance")
  aiExtract           Boolean           @default(true) @map("ai_extract")
  syncToCrm           Boolean           @default(true) @map("sync_to_crm")
  crmFieldMap         Json?             @map("crm_field_map")
  origin              FieldOrigin       @default(CUSTOM)
  packSlug            String?           @map("pack_slug")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([tenantId, scope])
  @@map("field_definitions")
}

// Append-only provenance log. One row per observation of a field. Never
// deleted - superseded. The entity `facts` snapshot is a fold of this under
// the merge policy (manual-wins, confidence+recency, absence!=deletion).
model IntelligenceFact {
  id         String            @id @default(cuid())
  tenantId   String            @map("tenant_id")
  entityType IntelligenceScope @map("entity_type") // CUSTOMER | OPPORTUNITY | CONVERSATION
  entityId   String            @map("entity_id")
  fieldKey   String            @map("field_key")
  value      Json
  confidence Float             @default(1)
  source     FactSource
  // Verbatim snippet from the source conversation that justifies this value,
  // e.g. "We provide healthcare services". The provenance the UI shows so users
  // trust AI-generated intelligence. Null for non-conversational sources.
  evidence   String?
  observedAt DateTime          @default(now()) @map("observed_at")

  conversationId String?   @map("conversation_id")
  validUntil     DateTime? @map("valid_until")
  supersededById String?   @map("superseded_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, entityType, entityId, fieldKey])
  @@map("intelligence_facts")
}

enum IntelligenceReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Human-review queue for uncertain intelligence updates. The ingest layer
// routes a value here (instead of auto-applying it) when its confidence is
// below the field threshold, OR when it CONFLICTS with a confidently-held
// current value. A human approves (→ applied as a MANUAL fact) or rejects.
// This is what keeps low-confidence AI guesses out of the CRM.
model IntelligenceReview {
  id         String            @id @default(cuid())
  tenantId   String            @map("tenant_id")
  entityType IntelligenceScope @map("entity_type")
  entityId   String            @map("entity_id")
  fieldKey   String            @map("field_key")

  proposedValue Json    @map("proposed_value")
  currentValue  Json?   @map("current_value")
  confidence    Float   @default(0)
  evidence      String?
  // Why it landed in review: "low_confidence" | "conflict" | "scope_review".
  reason        String

  status         IntelligenceReviewStatus @default(PENDING)
  source         FactSource
  conversationId String?                  @map("conversation_id")

  resolvedAt DateTime? @map("resolved_at")
  resolvedBy String?   @map("resolved_by") // userId
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@index([tenantId, entityType, entityId])
  @@map("intelligence_reviews")
}

// ─── Business action policies (deterministic AI-action rules) ───────────────
//
// Tenant-configured rules for sensitive AI actions (refunds, cancellations,
// coupons/compensation, customer-data writes). The AI may EXPLAIN these rules,
// but enforcement is this data + packages/shared/lib/business-policy.ts,
// evaluated deterministically at three points: before the AI offers the
// action, before the HITL request is created, and again immediately before
// execution after approval. Prompts can never bypass it.

model BusinessActionPolicy {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  /// REFUND | CANCEL_ORDER | COUPON | COMPENSATION | DISCOUNT | CUSTOMER_WRITE
  actionKind    String   @map("action_kind")
  enabled       Boolean  @default(true)
  /// Policies are IMMUTABLE per version: an update writes a NEW row with
  /// version+1. Historical PolicyDecision rows keep pointing at the version
  /// that actually decided them - changing a rule never rewrites history.
  version       Int      @default(1)
  effectiveFrom DateTime @default(now()) @map("effective_from")
  /// Rule payload - see BusinessPolicyConfig in business-policy.ts.
  config        Json     @default("{}")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, actionKind, version])
  @@index([tenantId, actionKind])
  @@map("business_action_policies")
}

/// Append-only audit of every policy evaluation - the reproducibility record.
model PolicyDecision {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  policyId        String?  @map("policy_id")
  policyVersion   Int?     @map("policy_version")
  actionKind      String   @map("action_kind")
  /// OFFER | HITL_CREATE | PRE_EXECUTION
  evaluationPoint String   @map("evaluation_point")
  conversationId  String?  @map("conversation_id")
  contactId       String?  @map("contact_id")
  aiEmployeeId    String?  @map("ai_employee_id")
  tool            String?
  /// Snapshot of the structured facts the decision was computed FROM.
  inputFacts      Json     @default("{}") @map("input_facts")
  /// ALLOWED | DENIED | REQUIRES_INFORMATION | REQUIRES_EVIDENCE |
  /// REQUIRES_HUMAN_APPROVAL | ALLOWED_WITH_LIMIT | ALTERNATIVE_ACTION_REQUIRED |
  /// FAIL_CLOSED
  decision        String
  matchedRules    Json     @default("[]") @map("matched_rules")
  reasonCodes     Json     @default("[]") @map("reason_codes")
  maxAmount       Float?   @map("max_amount")
  correlationId   String?  @map("correlation_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, actionKind])
  @@map("policy_decisions")
}

/// Explicit customer identity verification for cross-identity access.
///
/// The ONLY way a chat participant may access another customer's records: an
/// OTP delivered to the destination ALREADY STORED on that customer (never to
/// a destination supplied in chat), confirmed in this conversation. Grants are
/// tenant-, conversation- and customer-scoped, short-lived, attempt-limited
/// and auditable. Verification of customer A never authorizes customer B: the
/// access guard matches grants by the TARGET identifiers on the row.
model CustomerVerification {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  conversationId   String    @map("conversation_id")
  /// Authenticated channel sender the grant is bound to (wa phone).
  channelSenderId  String?   @map("channel_sender_id")
  /// Target customer's identifiers as stored in the Source of Truth.
  targetCustomerId String?   @map("target_customer_id")
  targetPhone      String?   @map("target_phone")
  targetEmail      String?   @map("target_email")
  /// "otp_whatsapp_stored_phone" | "otp_email_stored" | "human_agent"
  method           String
  codeHash         String    @map("code_hash")
  /// Code expiry before verification; GRANT expiry after (short-lived).
  expiresAt        DateTime  @map("expires_at")
  attempts         Int       @default(0)
  maxAttempts      Int       @default(5) @map("max_attempts")
  verifiedAt       DateTime? @map("verified_at")
  /// Permitted resource scope of the grant.
  scope            String    @default("customer_read")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([tenantId, conversationId])
  @@index([tenantId, expiresAt])
  @@map("customer_verifications")
}

// ─── Discovery State (structured conversational memory) ─────────────────────
//
// Authoritative, tenant- + conversation-scoped memory of what a customer has
// told the AI during a goal-driven conversation (e.g. a product search):
// facts collected, questions asked/answered, readiness for a provider action,
// and the actions attempted. The model PROPOSES fact updates via extraction;
// the backend (packages/shared/lib/discovery-state.ts) validates, normalizes,
// authorizes and persists them. Keys are derived from trusted server context
// only - never from model tool arguments. Fixes the "transcript-only memory"
// gap that caused repeated questions and fabricated searches.

enum DiscoveryStatus {
  active
  ready_for_action
  awaiting_customer
  action_in_progress
  fulfilled
  abandoned
  superseded
}

model DiscoverySession {
  id             String          @id @default(cuid())
  tenantId       String          @map("tenant_id")
  conversationId String          @map("conversation_id")
  aiAgentId      String?         @map("ai_agent_id")
  goalKey        String          @map("goal_key")
  status         DiscoveryStatus @default(active)
  /// Optimistic-concurrency guard: a write must CAS on the version it read so
  /// two concurrent inbound messages cannot clobber the newer state.
  version        Int             @default(0)
  schemaVersion  Int             @default(1) @map("schema_version")
  startedAt      DateTime        @default(now()) @map("started_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  completedAt    DateTime?       @map("completed_at")
  expiresAt      DateTime?       @map("expires_at")

  facts     DiscoveryFact[]
  questions DiscoveryQuestion[]
  actions   DiscoveryActionAttempt[]

  // One ACTIVE session per (tenant, conversation, goal). A topic change opens
  // a new session and supersedes the old (status=superseded).
  @@index([tenantId, conversationId, status])
  @@index([tenantId, expiresAt])
  @@map("discovery_sessions")
}

model DiscoveryFact {
  id                   String   @id @default(cuid())
  sessionId            String   @map("session_id")
  tenantId             String   @map("tenant_id")
  key                  String
  /// Canonical semantic key (deduped across languages/synonyms).
  normalizedKey        String   @map("normalized_key")
  valueType            String   @map("value_type") // string|number|boolean|enum|range
  valueJson            Json     @map("value_json")
  normalizedValueJson  Json?    @map("normalized_value_json")
  /// customer_explicit | customer_correction | provider | tenant_configuration | knowledge_base | model_inference
  source               String
  confidence           Float    @default(0.9)
  /// active | superseded | rejected
  status               String   @default("active")
  sourceMessageId      String?  @map("source_message_id")
  explicitlyConfirmed  Boolean  @default(false) @map("explicitly_confirmed")
  requiresConfirmation Boolean  @default(false) @map("requires_confirmation")
  /// Sensitivity class for retention/promotion decisions: normal|sensitive.
  sensitivity          String   @default("normal")
  supersedesFactId     String?  @map("supersedes_fact_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([sessionId, normalizedKey, status])
  @@map("discovery_facts")
}

model DiscoveryQuestion {
  id                    String    @id @default(cuid())
  sessionId             String    @map("session_id")
  tenantId              String    @map("tenant_id")
  /// The fact/requirement this question is trying to fill.
  requirementKey        String    @map("requirement_key")
  normalizedQuestionKey String    @map("normalized_question_key")
  /// planned | asked | answered | skipped | no_longer_required
  status                String    @default("planned")
  askedMessageId        String?   @map("asked_message_id")
  answeredMessageId     String?   @map("answered_message_id")
  askedAt               DateTime? @map("asked_at")
  answeredAt            DateTime? @map("answered_at")
  attemptCount          Int       @default(0) @map("attempt_count")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([sessionId, normalizedQuestionKey])
  @@map("discovery_questions")
}

model DiscoveryActionAttempt {
  id               String   @id @default(cuid())
  sessionId        String   @map("session_id")
  tenantId         String   @map("tenant_id")
  actionKey        String   @map("action_key")
  /// Snapshot of the criteria/facts the action ran with (for reproducibility).
  criteriaJson     Json     @map("criteria_json")
  toolName         String?  @map("tool_name")
  executionId      String?  @map("execution_id")
  /// pending | succeeded | failed | no_results | blocked
  resultStatus     String   @map("result_status")
  /// Provider result references (order/product ids, refund id, …) - atoms only.
  resultRefs       Json?    @map("result_refs")
  /// Product/resource ids actually SHOWN to the customer (dedupe re-shows).
  shownResourceIds Json?    @map("shown_resource_ids")
  createdAt        DateTime @default(now()) @map("created_at")

  session DiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("discovery_action_attempts")
}
