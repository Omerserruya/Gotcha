generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Channel Types ───────────────────────────────────────────

enum ChannelType {
  WHATSAPP
  MESSENGER
  INSTAGRAM
  EMAIL
  GMAIL
  OUTLOOK
  SLACK
  WEBCHAT
}

enum ChannelConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum BotFlowMode {
  UNIFIED
  PER_CHANNEL
}

enum ChannelResponseMode {
  HUMAN_WITH_COPILOT
  AI_AUTO_REPLY
}

// ─── Tenant Status & AI Mode ────────────────────────────────

enum TenantStatus {
  PENDING_ADMIN_SETUP
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
}

enum BotType {
  CHATBOT_FLOW
  AUTONOMOUS_AI
}

enum BusinessPriority {
  MAXIMIZE_SALES
  FAST_RESPONSE
  PREMIUM_EXPERIENCE
  REDUCE_WORKLOAD
}

enum OnboardingStep {
  BUSINESS_PROFILE
  DEPARTMENTS
  AI_CONFIG
  COMPLETED
}

// ─── Multi-Tenant ────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(PENDING_ADMIN_SETUP)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Feature flags (set by SYSTEM_ADMIN)
  botEnabled           Boolean  @default(false) @map("bot_enabled")
  botType              BotType? @map("bot_type")
  firstTakeCareEnabled Boolean  @default(false) @map("first_take_care_enabled")

  users             User[]
  conversations     Conversation[]
  messages          Message[]
  chatbotFlows      ChatbotFlow[]
  channelAccounts   ChannelAccount[]
  channelConfig     TenantChannelConfig?
  departments       Department[]
  departmentMembers DepartmentMember[]
  businessProfile   BusinessProfile?
  onboarding        TenantOnboarding?
  knowledgeBases    KnowledgeBase[]
  aiAgents          AIAgent[]
  routerRules       RouterRule[]
  contacts          Contact[]
  messageTemplates  MessageTemplate[]
  broadcasts        Broadcast[]
  scheduledMessages ScheduledMessage[]
  flowCanvas        FlowCanvas?

  @@index([status])
  @@map("tenants")
}

// ─── Channel Accounts ────────────────────────────────────────

model ChannelAccount {
  id          String      @id @default(cuid())
  tenantId    String      @map("tenant_id")
  channel     ChannelType
  externalId  String      @map("external_id") // WA phone_number_id, FB page_id, or IG business_id
  displayName String      @map("display_name")
  credentials Json        @default("{}") // { accessToken, appSecret, ... }
  isActive    Boolean     @default(true) @map("is_active")

  // Per-channel response mode (for email channels: GMAIL, OUTLOOK)
  responseMode ChannelResponseMode @default(HUMAN_WITH_COPILOT) @map("response_mode")

  // Connection lifecycle
  connectionStatus ChannelConnectionStatus @default(CONNECTED) @map("connection_status")
  connectedAt      DateTime?               @map("connected_at")
  connectedBy      String?                 @map("connected_by") // userId who connected
  tokenExpiresAt   DateTime?               @map("token_expires_at")
  platformMeta     Json?                   @map("platform_meta") // platform-specific metadata
  lastError        String?                 @map("last_error")
  lastHealthCheck  DateTime?               @map("last_health_check")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  templates     MessageTemplate[]

  @@unique([channel, externalId])
  @@index([tenantId])
  @@index([connectionStatus])
  @@index([tokenExpiresAt])
  @@map("channel_accounts")
}

// ─── Tenant Channel Config ───────────────────────────────────

model TenantChannelConfig {
  id          String      @id @default(cuid())
  tenantId    String      @unique @map("tenant_id")
  botFlowMode BotFlowMode @default(UNIFIED) @map("bot_flow_mode")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_channel_configs")
}

// ─── Department Enums ────────────────────────────────────────

enum DepartmentRole {
  AGENT
  MANAGER
}

enum DepartmentQueueMode {
  CLAIM
  ROUND_ROBIN
}

enum CopilotMode {
  READY_MESSAGE
  CONTEXT_ONLY
}

// ─── Auth & RBAC ─────────────────────────────────────────────

enum Role {
  SYSTEM_ADMIN
  ADMIN
  AGENT
}

model User {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  email     String
  password  String
  name      String
  role      Role     @default(AGENT)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations    Conversation[]    @relation("AssignedAgent")
  departmentMember DepartmentMember?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─── Conversations ───────────────────────────────────────────

enum ConversationStatus {
  OPEN
  WAITING
  CLOSED
}

model Conversation {
  id                 String             @id @default(cuid())
  tenantId           String             @map("tenant_id")
  channel            ChannelType        @default(WHATSAPP)
  channelAccountId   String?            @map("channel_account_id")
  customerExternalId String             @map("customer_external_id") // Phone (WA) or PSID (Messenger)
  customerName       String?            @map("customer_name")
  customerAvatarUrl  String?            @map("customer_avatar_url")
  assignedAgentId    String?            @map("assigned_agent_id")
  departmentId       String?            @map("department_id")
  status             ConversationStatus @default(OPEN)
  // Chatbot state tracking
  chatbotFlowId      String?            @map("chatbot_flow_id")
  chatbotNodeId      String?            @map("chatbot_node_id")
  isHandedOver       Boolean            @default(false) @map("is_handed_over")
  handledBy          String?            @map("handled_by") // "ai_agent", "flow", "human", null (unrouted)
  lastMessageAt      DateTime?          @map("last_message_at")
  reminderSentAt     DateTime?          @map("reminder_sent_at")
  closedAt           DateTime?          @map("closed_at")
  aiSummary          String?            @map("ai_summary")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount?           @relation(fields: [channelAccountId], references: [id], onDelete: Cascade)
  assignedAgent  User?                     @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  department     Department?               @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  chatbotFlow    ChatbotFlow?              @relation(fields: [chatbotFlowId], references: [id], onDelete: SetNull)
  messages       Message[]
  intelligence   ConversationIntelligence?

  @@index([tenantId, status])
  @@index([tenantId, assignedAgentId])
  @@index([tenantId, departmentId])
  @@index([tenantId, channel, customerExternalId])
  @@map("conversations")
}

// ─── Messages ────────────────────────────────────────────────

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id                 String           @id @default(cuid())
  tenantId           String           @map("tenant_id")
  conversationId     String?          @map("conversation_id")
  channel            ChannelType?
  externalMessageId  String?          @map("external_message_id") // WA msg ID or Messenger mid
  direction          MessageDirection
  body               String
  messageType        String           @default("text") @map("message_type")
  status             MessageStatus    @default(PENDING)
  senderName         String?          @map("sender_name")
  metadata           Json?
  mediaUrl           String?          @map("media_url")
  fileName           String?          @map("file_name")
  broadcastId        String?          @map("broadcast_id") // link to originating broadcast
  scheduledMessageId String?          @map("scheduled_message_id") // link to originating scheduled msg
  errorMessage       String?          @map("error_message")
  deliveredAt        DateTime?        @map("delivered_at")
  readAt             DateTime?        @map("read_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([externalMessageId])
  @@index([tenantId])
  @@index([broadcastId])
  @@index([scheduledMessageId])
  @@map("messages")
}

// ─── AI Agent Mode & Status ─────────────────────────────────

enum AIAgentMode {
  AUTONOMOUS
  COPILOT
  HUMAN_ONLY
}

enum AIAgentStatus {
  ACTIVE
  DRAFT
  PAUSED
}

// ─── AI Agents (AI Studio Team Members) ─────────────────────

model AIAgent {
  id                  String        @id @default(cuid())
  tenantId            String        @map("tenant_id")
  name                String
  role                String        @default("customer_support") // customer_support, sales, booking, billing, custom
  description         String?
  avatarColor         String        @default("#7c5cfc") @map("avatar_color")
  mode                AIAgentMode   @default(AUTONOMOUS)
  status              AIAgentStatus @default(DRAFT)
  tone                String        @default("professional") // professional, friendly, casual, formal
  languages           Json          @default("{\"english\":true}") // { english: bool, hebrew: bool, arabic: bool }
  style               Json          @default("{}") // { useEmojis, concise, useFirstName, proactive }
  channels            Json          @default("[]") // ["whatsapp", "instagram", "webchat"]
  escalationRules     Json          @default("[]") @map("escalation_rules") // [{ label, type, value, enabled }]
  interactiveMessages Json          @default("{}") @map("interactive_messages") // { allowQuickReply, allowListMenu, ... }

  // LLM settings (inherited from CopilotConfig pattern)
  systemPrompt     String  @default("") @map("system_prompt")
  sharedPrompt     String? @map("shared_prompt")
  autonomousPrompt String? @map("autonomous_prompt")
  model            String  @default("gpt-4o-mini")
  provider         String  @default("openai")
  temperature      Float   @default(0.7)
  maxTokens        Int     @default(1024) @map("max_tokens")

  // Persona configuration (gender-aware behavior, extensible)
  persona Json? // { gender: "male"|"female"|"neutral", traits: {}, customAttributes: {} }

  // Structured AI personality blocks
  identity   Json? // { role, responsibility, representationGuidelines[] }
  goals      Json? // { focus, slaAwareness, conversionObjective }
  toneConfig Json? @map("tone_config") // { formalityLevel, empathyLevel, assertiveness }
  behavioral Json? // { escalationTriggers[], forbiddenActions[], safetyBoundaries[] }

  // Autonomous behavior settings
  maxAutonomousMessages Int    @default(10) @map("max_autonomous_messages")
  maxAutonomousMinutes  Int    @default(15) @map("max_autonomous_minutes")
  confidenceThreshold   Float  @default(0.6) @map("confidence_threshold")
  escalationMessage     String @default("Let me connect you with a team member who can help further.") @map("escalation_message")
  conversationFlow      Json?  @map("conversation_flow") // [{ step, action, details }] — autonomous mode conversation flow
  customGuardrails      Json?  @map("custom_guardrails") // string[] — user-defined guardrails appended to static ones

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  knowledgeBases AIAgentKnowledge[]
  routerRules    RouterRule[]       @relation("RouterRuleAIAgent")

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("ai_agents")
}

// ─── AI Agent ↔ Knowledge Base (many-to-many) ───────────────

model AIAgentKnowledge {
  id              String   @id @default(cuid())
  aiAgentId       String   @map("ai_agent_id")
  knowledgeBaseId String   @map("knowledge_base_id")
  createdAt       DateTime @default(now()) @map("created_at")

  aiAgent       AIAgent       @relation(fields: [aiAgentId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@unique([aiAgentId, knowledgeBaseId])
  @@index([aiAgentId])
  @@index([knowledgeBaseId])
  @@map("ai_agent_knowledge")
}

// ─── Router Rules (Main Playbook) ───────────────────────────

enum RouterRuleRouteType {
  AI_AGENT
  FLOW
  HUMAN
  DEPARTMENT
}

model RouterRule {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  priority    Int                 @default(0)
  name        String
  conditions  Json                @default("[]") // [{ type: "intent"|"tag"|"keyword"|"channel", operator, value }]
  logic       String              @default("AND") // "AND" | "OR"
  routeType   RouterRuleRouteType @map("route_type")
  routeTarget String?             @map("route_target") // ID of target (aiAgentId, flowId, departmentId)
  aiAgentId   String?             @map("ai_agent_id") // populated when routeType = AI_AGENT
  enabled     Boolean             @default(true)
  isDefault   Boolean             @default(false) @map("is_default")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiAgent AIAgent? @relation("RouterRuleAIAgent", fields: [aiAgentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, enabled, priority])
  @@map("router_rules")
}

// ─── Chatbot Flow Builder ────────────────────────────────────

model ChatbotFlow {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  name        String
  description String?
  isActive    Boolean      @default(false) @map("is_active")
  channel     ChannelType? // null = ALL channels
  trigger     String? // trigger condition description
  runCount    Int          @default(0) @map("run_count") // number of times this flow has been executed
  // JSON definition of the flow graph
  nodes       Json         @default("[]")
  edges       Json         @default("[]")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId, isActive])
  @@index([tenantId, channel, isActive])
  @@map("chatbot_flows")
}

// ─── Departments ────────────────────────────────────────────

model Department {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  parentId    String?             @map("parent_id")
  name        String
  description String?
  queueMode   DepartmentQueueMode @default(CLAIM) @map("queue_mode")
  isActive    Boolean             @default(true) @map("is_active")

  // Working hours & SLA
  workingHours     Json? @map("working_hours") // { timezone, schedule: { monday: { enabled, open, close }, ... } }
  slaTarget        Int?  @map("sla_target") // Response SLA in minutes
  escalationPolicy Json? @map("escalation_policy") // { escalateOnBreach, escalateTo, maxWaitMinutes }

  // Automation settings
  autoGreetingEnabled  Boolean @default(false) @map("auto_greeting_enabled")
  autoGreetingMessage  String? @map("auto_greeting_message")
  autoCloseMinutes     Int?    @map("auto_close_minutes") // Auto-close after X inactivity minutes
  escalateOnSlaBreach  Boolean @default(false) @map("escalate_on_sla_breach")
  aiSuggestionsEnabled Boolean @default(true) @map("ai_suggestions_enabled")
  autoRepliesEnabled   Boolean @default(false) @map("auto_replies_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent               Department?           @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children             Department[]          @relation("DepartmentHierarchy")
  members              DepartmentMember[]
  conversations        Conversation[]
  agentToolPermissions AgentToolPermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([parentId])
  @@map("departments")
}

model DepartmentMember {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  userId         String         @unique @map("user_id")
  departmentId   String         @map("department_id")
  departmentRole DepartmentRole @default(AGENT) @map("department_role")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@index([tenantId])
  @@map("department_members")
}

// ─── Business Profile (Onboarding Step A) ───────────────────

model BusinessProfile {
  id                          String           @id @default(cuid())
  tenantId                    String           @unique @map("tenant_id")
  organizationName            String           @map("organization_name")
  industry                    String
  businessDescription         String           @map("business_description")
  businessPriority            BusinessPriority @map("business_priority")
  estimatedDailyConversations Int              @map("estimated_daily_conversations")
  numberOfAgents              Int              @map("number_of_agents")
  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

// ─── Tenant Onboarding Tracker ──────────────────────────────

model TenantOnboarding {
  id          String         @id @default(cuid())
  tenantId    String         @unique @map("tenant_id")
  currentStep OnboardingStep @default(BUSINESS_PROFILE) @map("current_step")
  completedAt DateTime?      @map("completed_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_onboardings")
}

// ─── Knowledge Base (RAG) ───────────────────────────────────

model KnowledgeBase {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Scoping: who can use this knowledge base
  scope             String  @default("all") // "all" | "agent" | "department"
  scopeAgentId      String? @map("scope_agent_id")
  scopeDepartmentId String? @map("scope_department_id")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents             KnowledgeDocument[]
  integrations          KnowledgeIntegration[]
  aiAgentKnowledgeBases AIAgentKnowledge[]

  @@index([tenantId])
  @@index([tenantId, scope])
  @@map("knowledge_bases")
}

model KnowledgeIntegration {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  knowledgeBaseId String   @map("knowledge_base_id")
  provider        String // "confluence" | "google_drive"
  credentials     Json // encrypted { accessToken, refreshToken, cloudId, ... }
  displayName     String   @map("display_name")
  config          Json? // { spaceKeys: [], lastSyncAt, ... }
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([knowledgeBaseId])
  @@map("knowledge_integrations")
}

model KnowledgeDocument {
  id              String   @id @default(cuid())
  knowledgeBaseId String   @map("knowledge_base_id")
  tenantId        String   @map("tenant_id")
  title           String
  content         String
  sourceType      String   @default("text") @map("source_type")
  sourceUrl       String?  @map("source_url")
  chunkCount      Int      @default(0) @map("chunk_count")
  status          String   @default("pending")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        KnowledgeChunk[]

  @@index([knowledgeBaseId])
  @@index([tenantId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  tenantId   String   @map("tenant_id")
  content    String
  chunkIndex Int      @map("chunk_index")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("knowledge_chunks")
}

// ─── Token Usage Logs ────────────────────────────────────────

model TokenLog {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  type             String // "chat" | "embedding" | "suggestion" | "summary" | "classification"
  model            String // "gpt-4o-mini", "text-embedding-3-small", etc.
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  totalTokens      Int      @map("total_tokens")
  conversationId   String?  @map("conversation_id")
  documentId       String?  @map("document_id")
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([conversationId])
  @@map("token_logs")
}

// ─── Magic Links (passwordless onboarding) ──────────────────

model MagicLink {
  id        String    @id @default(cuid())
  token     String    @unique
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([token])
  @@index([tenantId])
  @@map("magic_links")
}

// ─── Lead Status ────────────────────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  APPROVED
  REJECTED
}

// ─── Waitlist / Whitelist Leads ─────────────────────────────

model WaitlistEntry {
  id          String     @id @default(cuid())
  firstName   String     @map("first_name")
  email       String     @unique
  phone       String?
  company     String?
  role        String
  companySize String     @map("company_size")
  frustration String?
  source      String     @default("early-access-form")
  status      LeadStatus @default(NEW)
  leadScore   Int        @default(0) @map("lead_score")
  notes       String?
  convertedAt DateTime?  @map("converted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([status])
  @@index([email])
  @@map("waitlist_entries")
}

// ─── Refresh Tokens ─────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Integration Catalog (system-wide, not per-tenant) ──────

enum IntegrationCategory {
  ECOMMERCE
  CRM
  PAYMENTS
  HELPDESK
  COMMUNICATION
  ANALYTICS
  SHIPPING
  PROJECT_MANAGEMENT
  CALENDAR
  DATABASE
  CUSTOM
}

enum AuthType {
  API_KEY
  OAUTH2
  BASIC_AUTH
  WEBHOOK
  CUSTOM
}

model IntegrationCatalog {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  description     String
  longDescription String?             @map("long_description")
  category        IntegrationCategory
  logoUrl         String?             @map("logo_url")
  website         String?
  docsUrl         String?             @map("docs_url")
  authType        AuthType            @default(API_KEY) @map("auth_type")
  authSchema      Json                @default("{}") @map("auth_schema")
  configSchema    Json                @default("{}") @map("config_schema")
  isPublished     Boolean             @default(true) @map("is_published")
  sortOrder       Int                 @default(0) @map("sort_order")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  catalogTools      CatalogTool[]
  tenantConnections TenantIntegration[]

  @@index([category])
  @@index([isPublished, sortOrder])
  @@map("integration_catalog")
}

// ─── Catalog Tools (what tools an integration offers) ───────

enum ToolCategory {
  READ
  WRITE
  DELETE
  ACTION
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model CatalogTool {
  id            String       @id @default(cuid())
  integrationId String       @map("integration_id")
  slug          String
  name          String
  description   String
  category      ToolCategory @default(READ)
  inputSchema   Json         @default("{}") @map("input_schema")
  outputSchema  Json         @default("{}") @map("output_schema")
  endpoint      String?
  method        String       @default("GET")
  isDefault     Boolean      @default(true) @map("is_default")
  riskLevel     RiskLevel    @default(LOW) @map("risk_level")
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now()) @map("created_at")

  integration IntegrationCatalog @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tenantTools TenantTool[]

  @@unique([integrationId, slug])
  @@index([integrationId])
  @@map("catalog_tools")
}

// ─── Tenant Integration Connections ─────────────────────────

enum ConnectionStatus {
  PENDING
  TESTING
  CONNECTED
  ERROR
  DISCONNECTED
}

model TenantIntegration {
  id             String           @id @default(cuid())
  tenantId       String           @map("tenant_id")
  integrationId  String           @map("integration_id")
  status         ConnectionStatus @default(PENDING)
  credentials    Json             @default("{}")
  config         Json             @default("{}")
  connectedBy    String?          @map("connected_by")
  connectedAt    DateTime?        @map("connected_at")
  lastTestedAt   DateTime?        @map("last_tested_at")
  lastTestResult Boolean?         @map("last_test_result")
  lastError      String?          @map("last_error")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  integration IntegrationCatalog @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tenantTools TenantTool[]

  @@unique([tenantId, integrationId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_integrations")
}

// ─── Tenant Tool Activation ─────────────────────────────────

model TenantTool {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  tenantIntegrationId String   @map("tenant_integration_id")
  catalogToolId       String   @map("catalog_tool_id")
  isEnabled           Boolean  @default(true) @map("is_enabled")
  configOverrides     Json     @default("{}") @map("config_overrides")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenantIntegration TenantIntegration     @relation(fields: [tenantIntegrationId], references: [id], onDelete: Cascade)
  catalogTool       CatalogTool           @relation(fields: [catalogToolId], references: [id], onDelete: Cascade)
  agentPermissions  AgentToolPermission[]
  executions        ToolExecution[]

  @@unique([tenantIntegrationId, catalogToolId])
  @@index([tenantId])
  @@index([tenantId, isEnabled])
  @@map("tenant_tools")
}

// ─── Agent Tool Permissions ─────────────────────────────────

model AgentToolPermission {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  departmentId    String?  @map("department_id")
  agentId         String?  @map("agent_id") // human agent (User) ID
  aiAgentId       String?  @map("ai_agent_id") // AI agent ID
  tenantToolId    String   @map("tenant_tool_id")
  isAllowed       Boolean  @default(true) @map("is_allowed")
  requireApproval Boolean  @default(false) @map("require_approval")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenantTool TenantTool  @relation(fields: [tenantToolId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([tenantToolId, departmentId, agentId])
  @@index([tenantId])
  @@index([departmentId])
  @@index([agentId])
  @@index([aiAgentId])
  @@map("agent_tool_permissions")
}

// ─── Tool Executions (Audit Log) ────────────────────────────

model ToolExecution {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  tenantToolId   String   @map("tenant_tool_id")
  input          Json     @default("{}")
  output         Json     @default("{}")
  success        Boolean  @default(true)
  durationMs     Int?     @map("duration_ms")
  triggeredBy    String   @default("ai") @map("triggered_by")
  approvedBy     String?  @map("approved_by")
  createdAt      DateTime @default(now()) @map("created_at")

  tenantTool TenantTool @relation(fields: [tenantToolId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
  @@index([tenantToolId])
  @@index([tenantId, createdAt])
  @@map("tool_executions")
}

// ─── Conversation Intelligence ──────────────────────────────

model ConversationIntelligence {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  conversationId    String   @unique @map("conversation_id")
  summary           String?
  detectedIntent    String?  @map("detected_intent")
  intentConfidence  Float?   @map("intent_confidence")
  sentiment         String? // "positive" | "negative" | "neutral"
  sentimentScore    Float?   @map("sentiment_score") // -1.0 to 1.0
  topics            Json     @default("[]") // ["billing", "refund", ...]
  toolsUsed         Json     @default("[]") @map("tools_used") // [{ toolId, toolName, success }]
  resolutionOutcome String?  @map("resolution_outcome") // "resolved" | "escalated" | "abandoned"
  customerEffort    Int?     @map("customer_effort") // 1-5 score
  aiConfidence      Float?   @map("ai_confidence") // overall AI confidence in handling
  metadata          Json?
  analyzedAt        DateTime @default(now()) @map("analyzed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, detectedIntent])
  @@index([tenantId, sentiment])
  @@index([tenantId, analyzedAt])
  @@map("conversation_intelligence")
}

// ─── Agent Scoring (Post-Conversation Review) ──────────────

model AgentScore {
  id             String @id @default(cuid())
  tenantId       String @map("tenant_id")
  conversationId String @map("conversation_id")
  agentId        String @map("agent_id")

  // Scores (1-5 scale)
  responseQuality   Int?   @map("response_quality") // Quality of agent responses
  responseSpeed     Int?   @map("response_speed") // How fast they responded
  resolutionScore   Int?   @map("resolution_score") // Did they resolve the issue?
  protocolAdherence Int?   @map("protocol_adherence") // Followed rules/escalation procedures?
  customerHandling  Int?   @map("customer_handling") // Empathy, professionalism
  overallScore      Float? @map("overall_score") // Weighted average (0-100)

  // AI analysis
  strengths    Json    @default("[]") // ["Quick response", "Used KB effectively"]
  improvements Json    @default("[]") // ["Could have escalated sooner"]
  summary      String? // AI-generated performance summary

  // Metadata
  copilotUsageRate Float? @map("copilot_usage_rate") // % of AI suggestions used
  toolsUsedCount   Int    @default(0) @map("tools_used_count")
  messageCount     Int    @default(0) @map("message_count")

  analyzedAt DateTime @default(now()) @map("analyzed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([conversationId, agentId])
  @@index([tenantId])
  @@index([agentId])
  @@index([tenantId, agentId])
  @@index([tenantId, analyzedAt])
  @@map("agent_scores")
}

// ─── Notification Log ───────────────────────────────────────

model NotificationLog {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  channel   String // email, slack, webhook, internal
  type      String // onboarding_email, activation_confirmation, etc.
  recipient String // email address or channel ID
  subject   String?
  body      String?
  status    String    @default("pending") // pending, sent, failed
  error     String?
  metadata  Json?
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([type, status])
  @@map("notification_logs")
}

// ─── Contacts (Customer Directory) ─────────────────────────

model Contact {
  id                String      @id @default(cuid())
  tenantId          String      @map("tenant_id")
  externalId        String      @map("external_id") // phone, email, PSID, etc.
  channel           ChannelType
  displayName       String?     @map("display_name")
  email             String?
  phone             String?
  avatarUrl         String?     @map("avatar_url")
  metadata          Json? // custom fields
  tags              Json        @default("[]") // string[] for segmentation
  lastSeenAt        DateTime?   @map("last_seen_at")
  lastInteractionAt DateTime?   @map("last_interaction_at")
  source            String? // campaign/channel source
  optOutChannels    Json        @default("[]") @map("opt_out_channels") // string[] of opted-out channel types
  optedOutAt        DateTime?   @map("opted_out_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  broadcastRecipients BroadcastRecipient[]

  @@unique([tenantId, channel, externalId])
  @@index([tenantId])
  @@index([tenantId, displayName])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, lastInteractionAt])
  @@map("contacts")
}

// ─── Message Templates ─────────────────────────────────────

enum TemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model MessageTemplate {
  id               String         @id @default(cuid())
  tenantId         String         @map("tenant_id")
  name             String
  category         String         @default("general") // marketing, utility, authentication, general
  language         String         @default("en")
  channel          ChannelType? // null = all channels
  channelAccountId String?        @map("channel_account_id") // bind template to a specific connected account (e.g. specific WABA)
  headerType       String?        @map("header_type") // text, image, video, document
  headerContent    String?        @map("header_content")
  body             String // template body with {{1}} placeholders
  footer           String?
  buttons          Json           @default("[]") // [{ type: "QUICK_REPLY"|"URL"|"PHONE", text, url?, phoneNumber? }]
  variables        Json           @default("[]") // [{ key: "1", sample: "John" }]
  externalId       String?        @map("external_id") // WhatsApp template ID after sync
  metaTemplateId   String?        @map("meta_template_id") // Meta's internal template ID
  rejectionReason  String?        @map("rejection_reason") // reason if rejected by Meta
  status           TemplateStatus @default(DRAFT)
  version          Int            @default(1)
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  broadcasts     Broadcast[]

  @@unique([tenantId, name, language, channel])
  @@index([tenantId])
  @@index([tenantId, channel, status])
  @@index([tenantId, channelAccountId])
  @@map("message_templates")
}

// ─── Broadcasts ────────────────────────────────────────────

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Broadcast {
  id               String          @id @default(cuid())
  tenantId         String          @map("tenant_id")
  name             String
  channel          ChannelType
  channelAccountId String          @map("channel_account_id")
  templateId       String?         @map("template_id")
  body             String? // for non-template messages
  variables        Json            @default("{}") // template variable values
  flowId           String?         @map("flow_id") // trigger flow for each recipient
  status           BroadcastStatus @default(DRAFT)
  scheduledAt      DateTime?       @map("scheduled_at")
  startedAt        DateTime?       @map("started_at")
  completedAt      DateTime?       @map("completed_at")
  createdBy        String          @map("created_by")

  // Analytics counters
  totalRecipients Int @default(0) @map("total_recipients")
  sentCount       Int @default(0) @map("sent_count")
  deliveredCount  Int @default(0) @map("delivered_count")
  readCount       Int @default(0) @map("read_count")
  repliedCount    Int @default(0) @map("replied_count")
  failedCount     Int @default(0) @map("failed_count")

  // Last error message when broadcast halted (channel API failure, billing issue, etc.)
  lastError String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   MessageTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients BroadcastRecipient[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([scheduledAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String    @map("broadcast_id")
  contactId   String?   @map("contact_id")
  externalId  String    @map("external_id") // phone/PSID/email
  messageId   String?   @map("message_id") // outgoing message ID after send
  status      String    @default("pending") // pending, sent, delivered, read, replied, failed
  error       String?
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  repliedAt   DateTime? @map("replied_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([broadcastId])
  @@index([broadcastId, status])
  @@index([contactId])
  @@map("broadcast_recipients")
}

// ─── Scheduled Messages ────────────────────────────────────

enum ScheduledMessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model ScheduledMessage {
  id                  String                 @id @default(cuid())
  tenantId            String                 @map("tenant_id")
  conversationId      String?                @map("conversation_id")
  channel             ChannelType
  channelAccountId    String                 @map("channel_account_id")
  recipientExternalId String                 @map("recipient_external_id")
  body                String
  messageType         String                 @default("text") @map("message_type")
  mediaUrl            String?                @map("media_url")
  templateId          String?                @map("template_id")
  variables           Json                   @default("{}")
  sendType            String                 @default("regular") @map("send_type") // regular, conversation, flow
  departmentId        String?                @map("department_id")
  flowId              String?                @map("flow_id")
  scheduledAt         DateTime               @map("scheduled_at")
  status              ScheduledMessageStatus @default(PENDING)
  sentAt              DateTime?              @map("sent_at")
  error               String?
  createdBy           String                 @map("created_by")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status, scheduledAt])
  @@index([tenantId, status])
  @@map("scheduled_messages")
}

// ─── Usage Logs (Centralized Usage Tracking) ───────────────

model UsageLog {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  type             String // "ai_tokens" | "message_sent" | "tool_call" | "automation_run"
  quantity         Int
  tokensEquivalent Int      @map("tokens_equivalent")
  metadata         Json? // { model, channel, tool, conversationId, messageId }
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@map("usage_logs")
}

// ─── Credit Transactions (Usage → Credits) ─────────────────

model CreditTransaction {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  amount      Int // credits consumed (positive = consumed, negative = added)
  source      String // usage type that generated this: "ai_tokens", "message_sent", etc.
  referenceId String?  @map("reference_id") // optional link to usage_log or other entity
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, source])
  @@index([tenantId, createdAt])
  @@map("credit_transactions")
}

// ─── Audit Logs (Full System Audit Trail) ──────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  actorType  String   @map("actor_type") // "user" | "ai" | "system"
  actorId    String?  @map("actor_id") // userId or aiAgentId or null for system
  action     String // "message.sent", "ai.responded", "tool.executed", "conversation.updated", etc.
  targetType String?  @map("target_type") // "conversation", "message", "tool", "user", etc.
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, action])
  @@index([tenantId, actorType])
  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─── Flow Canvas (Visual Routing) ──────────────────────────

model FlowCanvas {
  id        String   @id @default(cuid())
  tenantId  String   @unique @map("tenant_id")
  nodes     Json     @default("[]") // [{ id, type: "channel"|"rule"|"flow"|"agent"|"department", position, data }]
  edges     Json     @default("[]") // [{ id, source, target, data }]
  viewport  Json? // { x, y, zoom }
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("flow_canvas")
}
