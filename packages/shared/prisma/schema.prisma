generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Channel Types ───────────────────────────────────────────

enum ChannelType {
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

enum ChannelConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

enum BotFlowMode {
  UNIFIED
  PER_CHANNEL
}

// ─── Tenant Status & AI Mode ────────────────────────────────

enum TenantStatus {
  PENDING_ADMIN_SETUP
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
}

enum BotType {
  CHATBOT_FLOW
  AUTONOMOUS_AI
}

enum BusinessPriority {
  MAXIMIZE_SALES
  FAST_RESPONSE
  PREMIUM_EXPERIENCE
  REDUCE_WORKLOAD
}

enum OnboardingStep {
  BUSINESS_PROFILE
  DEPARTMENTS
  AI_CONFIG
  COMPLETED
}

// ─── Multi-Tenant ────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(PENDING_ADMIN_SETUP)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  // Feature flags (set by SYSTEM_ADMIN)
  botEnabled           Boolean  @default(false) @map("bot_enabled")
  botType              BotType? @map("bot_type")
  firstTakeCareEnabled Boolean  @default(false) @map("first_take_care_enabled")

  users              User[]
  conversations      Conversation[]
  messages           Message[]
  chatbotFlows       ChatbotFlow[]
  copilotConfig      CopilotConfig?
  firstTakeCareConfig FirstTakeCareConfig?
  channelAccounts    ChannelAccount[]
  channelConfig      TenantChannelConfig?
  departments        Department[]
  departmentMembers  DepartmentMember[]
  departmentCopilotConfigs DepartmentCopilotConfig[]
  businessProfile    BusinessProfile?
  onboarding         TenantOnboarding?
  knowledgeBases     KnowledgeBase[]

  @@index([status])
  @@map("tenants")
}

// ─── Channel Accounts ────────────────────────────────────────

model ChannelAccount {
  id              String      @id @default(cuid())
  tenantId        String      @map("tenant_id")
  channel         ChannelType
  externalId      String      @map("external_id")    // WA phone_number_id, FB page_id, or IG business_id
  displayName     String      @map("display_name")
  credentials     Json        @default("{}")          // { accessToken, appSecret, ... }
  isActive        Boolean     @default(true) @map("is_active")

  // Connection lifecycle
  connectionStatus ChannelConnectionStatus @default(CONNECTED) @map("connection_status")
  connectedAt      DateTime?              @map("connected_at")
  connectedBy      String?                @map("connected_by")   // userId who connected
  tokenExpiresAt   DateTime?              @map("token_expires_at")
  platformMeta     Json?                  @map("platform_meta")  // platform-specific metadata
  lastError        String?                @map("last_error")
  lastHealthCheck  DateTime?              @map("last_health_check")

  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([channel, externalId])
  @@index([tenantId])
  @@index([connectionStatus])
  @@index([tokenExpiresAt])
  @@map("channel_accounts")
}

// ─── Tenant Channel Config ───────────────────────────────────

model TenantChannelConfig {
  id           String      @id @default(cuid())
  tenantId     String      @unique @map("tenant_id")
  botFlowMode  BotFlowMode @default(UNIFIED) @map("bot_flow_mode")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_channel_configs")
}

// ─── Department Enums ────────────────────────────────────────

enum DepartmentRole {
  AGENT
  MANAGER
}

enum DepartmentQueueMode {
  CLAIM
  ROUND_ROBIN
}

enum CopilotMode {
  READY_MESSAGE
  CONTEXT_ONLY
}

// ─── Auth & RBAC ─────────────────────────────────────────────

enum Role {
  SYSTEM_ADMIN
  ADMIN
  AGENT
}

model User {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  email     String
  password  String
  name      String
  role      Role     @default(AGENT)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations    Conversation[]      @relation("AssignedAgent")
  departmentMember DepartmentMember?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ─── Conversations ───────────────────────────────────────────

enum ConversationStatus {
  OPEN
  WAITING
  CLOSED
}

model Conversation {
  id                 String             @id @default(cuid())
  tenantId           String             @map("tenant_id")
  channel            ChannelType        @default(WHATSAPP)
  channelAccountId   String?            @map("channel_account_id")
  customerExternalId String             @map("customer_external_id") // Phone (WA) or PSID (Messenger)
  customerName       String?            @map("customer_name")
  assignedAgentId    String?            @map("assigned_agent_id")
  departmentId       String?            @map("department_id")
  status             ConversationStatus @default(OPEN)
  // Chatbot state tracking
  chatbotFlowId      String?            @map("chatbot_flow_id")
  chatbotNodeId      String?            @map("chatbot_node_id")
  isHandedOver       Boolean            @default(false) @map("is_handed_over")
  lastMessageAt      DateTime?          @map("last_message_at")
  reminderSentAt     DateTime?          @map("reminder_sent_at")
  closedAt           DateTime?          @map("closed_at")
  aiSummary          String?            @map("ai_summary")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  assignedAgent  User?           @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  chatbotFlow    ChatbotFlow?    @relation(fields: [chatbotFlowId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@index([tenantId, status])
  @@index([tenantId, assignedAgentId])
  @@index([tenantId, departmentId])
  @@index([tenantId, channel, customerExternalId])
  @@map("conversations")
}

// ─── Messages ────────────────────────────────────────────────

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id                String           @id @default(cuid())
  tenantId          String           @map("tenant_id")
  conversationId    String           @map("conversation_id")
  channel           ChannelType?
  externalMessageId String?          @map("external_message_id") // WA msg ID or Messenger mid
  direction         MessageDirection
  body              String
  messageType       String           @default("text") @map("message_type")
  status            MessageStatus    @default(PENDING)
  senderName        String?          @map("sender_name")
  metadata          Json?
  createdAt         DateTime         @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([externalMessageId])
  @@index([tenantId])
  @@map("messages")
}

// ─── Co-Pilot Configuration (per-tenant AI agent) ───────────

model CopilotConfig {
  id           String      @id @default(cuid())
  tenantId     String      @unique @map("tenant_id")
  copilotMode  CopilotMode @default(READY_MESSAGE) @map("copilot_mode")
  systemPrompt String      @default("") @map("system_prompt")
  rules        Json        @default("[]")
  tools        Json        @default("[]")
  model        String      @default("gpt-4o-mini")
  provider     String      @default("openai")
  temperature  Float       @default(0.7)
  maxTokens    Int         @default(1024) @map("max_tokens")
  isActive     Boolean     @default(true) @map("is_active")

  // Structured AI personality blocks (tenant-level defaults)
  identity     Json?       // { role, responsibility, representationGuidelines[] }
  goals        Json?       // { focus, slaAwareness, conversionObjective, qualityExpectations[] }
  tone         Json?       // { formalityLevel, empathyLevel, assertiveness, brandAlignment }
  behavioral   Json?       // { escalationTriggers[], noAutoReplyConditions[], forbiddenActions[], safetyBoundaries[], confidenceHandling }

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("copilot_configs")
}

// ─── Chatbot Flow Builder ────────────────────────────────────

model ChatbotFlow {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  name        String
  description String?
  isActive    Boolean      @default(false) @map("is_active")
  channel     ChannelType?                                     // null = ALL channels
  // JSON definition of the flow graph
  nodes       Json         @default("[]")
  edges       Json         @default("[]")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([tenantId, isActive])
  @@index([tenantId, channel, isActive])
  @@map("chatbot_flows")
}

// ─── Departments ────────────────────────────────────────────

model Department {
  id          String              @id @default(cuid())
  tenantId    String              @map("tenant_id")
  name        String
  description String?
  queueMode   DepartmentQueueMode @default(CLAIM) @map("queue_mode")
  isActive    Boolean             @default(true) @map("is_active")

  // Working hours & SLA
  workingHours   Json?   @map("working_hours")    // { timezone, schedule: { monday: { enabled, open, close }, ... } }
  slaTarget      Int?    @map("sla_target")        // Response SLA in minutes
  escalationPolicy Json? @map("escalation_policy") // { escalateOnBreach, escalateTo, maxWaitMinutes }

  // Automation settings
  autoGreetingEnabled Boolean @default(false) @map("auto_greeting_enabled")
  autoGreetingMessage String? @map("auto_greeting_message")
  autoCloseMinutes    Int?    @map("auto_close_minutes")     // Auto-close after X inactivity minutes
  escalateOnSlaBreach Boolean @default(false) @map("escalate_on_sla_breach")
  aiSuggestionsEnabled Boolean @default(true) @map("ai_suggestions_enabled")
  autoRepliesEnabled  Boolean @default(false) @map("auto_replies_enabled")

  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members       DepartmentMember[]
  conversations Conversation[]
  copilotConfig DepartmentCopilotConfig?

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

model DepartmentMember {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  userId         String         @unique @map("user_id")
  departmentId   String         @map("department_id")
  departmentRole DepartmentRole @default(AGENT) @map("department_role")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@index([tenantId])
  @@map("department_members")
}

model DepartmentCopilotConfig {
  id           String      @id @default(cuid())
  tenantId     String      @map("tenant_id")
  departmentId String      @unique @map("department_id")
  copilotMode  CopilotMode @default(READY_MESSAGE) @map("copilot_mode")
  systemPrompt String      @default("") @map("system_prompt")
  rules        Json        @default("[]")
  tools        Json        @default("[]")
  model        String      @default("gpt-4o-mini")
  provider     String      @default("openai")
  temperature  Float       @default(0.7)
  maxTokens    Int         @default(1024) @map("max_tokens")
  isActive     Boolean     @default(true) @map("is_active")

  // Structured AI personality blocks (per-department overrides)
  identity     Json?       // { role, responsibility, representationGuidelines[] }
  goals        Json?       // { focus, slaAwareness, conversionObjective, qualityExpectations[] }
  tone         Json?       // { formalityLevel, empathyLevel, assertiveness, brandAlignment }
  behavioral   Json?       // { escalationTriggers[], noAutoReplyConditions[], forbiddenActions[], safetyBoundaries[], confidenceHandling }

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("department_copilot_configs")
}

// ─── Business Profile (Onboarding Step A) ───────────────────

model BusinessProfile {
  id                     String           @id @default(cuid())
  tenantId               String           @unique @map("tenant_id")
  organizationName       String           @map("organization_name")
  industry               String
  businessDescription    String           @map("business_description")
  businessPriority       BusinessPriority @map("business_priority")
  estimatedDailyConversations Int         @map("estimated_daily_conversations")
  numberOfAgents         Int              @map("number_of_agents")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_profiles")
}

// ─── Tenant Onboarding Tracker ──────────────────────────────

model TenantOnboarding {
  id            String         @id @default(cuid())
  tenantId      String         @unique @map("tenant_id")
  currentStep   OnboardingStep @default(BUSINESS_PROFILE) @map("current_step")
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_onboardings")
}

// ─── First-Take-Care AI Agent Config (tenant-level, premium) ─

model FirstTakeCareConfig {
  id           String  @id @default(cuid())
  tenantId     String  @unique @map("tenant_id")
  isActive     Boolean @default(true) @map("is_active")

  // LLM settings
  systemPrompt String  @default("") @map("system_prompt")
  rules        Json    @default("[]")
  tools        Json    @default("[]")
  model        String  @default("gpt-4o-mini")
  provider     String  @default("openai")
  temperature  Float   @default(0.7)
  maxTokens    Int     @default(1024) @map("max_tokens")

  // Structured AI personality blocks
  identity     Json?   // { role, responsibility, representationGuidelines[] }
  goals        Json?   // { focus, slaAwareness, conversionObjective, qualityExpectations[] }
  tone         Json?   // { formalityLevel, empathyLevel, assertiveness, brandAlignment }
  behavioral   Json?   // { escalationTriggers[], noAutoReplyConditions[], forbiddenActions[], safetyBoundaries[], confidenceHandling }

  // Autonomous behavior settings
  maxAutonomousMessages Int @default(10) @map("max_autonomous_messages")  // Max AI messages before force-escalation
  maxAutonomousMinutes  Int @default(15) @map("max_autonomous_minutes")   // Max minutes before force-escalation
  confidenceThreshold   Float @default(0.6) @map("confidence_threshold")  // Below this, escalate to human
  escalationMessage     String @default("Let me connect you with a team member who can help further.") @map("escalation_message")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("first_take_care_configs")
}

// ─── Knowledge Base (RAG) ───────────────────────────────────

model KnowledgeBase {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents    KnowledgeDocument[]
  integrations KnowledgeIntegration[]

  @@index([tenantId])
  @@map("knowledge_bases")
}

model KnowledgeIntegration {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  knowledgeBaseId String   @map("knowledge_base_id")
  provider        String   // "confluence" | "google_drive"
  credentials     Json     // encrypted { accessToken, refreshToken, cloudId, ... }
  displayName     String   @map("display_name")
  config          Json?    // { spaceKeys: [], lastSyncAt, ... }
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([knowledgeBaseId])
  @@map("knowledge_integrations")
}

model KnowledgeDocument {
  id              String   @id @default(cuid())
  knowledgeBaseId String   @map("knowledge_base_id")
  tenantId        String   @map("tenant_id")
  title           String
  content         String
  sourceType      String   @default("text") @map("source_type")
  sourceUrl       String?  @map("source_url")
  chunkCount      Int      @default(0) @map("chunk_count")
  status          String   @default("pending")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  knowledgeBase KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        KnowledgeChunk[]

  @@index([knowledgeBaseId])
  @@index([tenantId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  documentId String   @map("document_id")
  tenantId   String   @map("tenant_id")
  content    String
  chunkIndex Int      @map("chunk_index")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("knowledge_chunks")
}

// ─── Magic Links (passwordless onboarding) ──────────────────

model MagicLink {
  id        String   @id @default(cuid())
  token     String   @unique
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([tenantId])
  @@map("magic_links")
}

// ─── Refresh Tokens ─────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

// ─── Notification Log ───────────────────────────────────────

model NotificationLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  channel    String   // email, slack, webhook, internal
  type       String   // onboarding_email, activation_confirmation, etc.
  recipient  String   // email address or channel ID
  subject    String?
  body       String?
  status     String   @default("pending") // pending, sent, failed
  error      String?
  metadata   Json?
  sentAt     DateTime? @map("sent_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([type, status])
  @@map("notification_logs")
}
