// ─── Integration Catalog (system-wide, not per-tenant) ──────

enum IntegrationCategory {
  ECOMMERCE
  CRM
  PAYMENTS
  HELPDESK
  COMMUNICATION
  ANALYTICS
  SHIPPING
  PROJECT_MANAGEMENT
  CALENDAR
  DATABASE
  CUSTOM
}

enum AuthType {
  API_KEY
  OAUTH2
  BASIC_AUTH
  WEBHOOK
  CUSTOM
}

model IntegrationCatalog {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            String
  description     String
  longDescription String?             @map("long_description")
  category        IntegrationCategory
  logoUrl         String?             @map("logo_url")
  website         String?
  docsUrl         String?             @map("docs_url")
  authType        AuthType            @default(API_KEY) @map("auth_type")
  authSchema      Json                @default("{}") @map("auth_schema")
  configSchema    Json                @default("{}") @map("config_schema")
  isPublished     Boolean             @default(true) @map("is_published")
  sortOrder       Int                 @default(0) @map("sort_order")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  catalogTools      CatalogTool[]
  tenantConnections TenantIntegration[]

  @@index([category])
  @@index([isPublished, sortOrder])
  @@map("integration_catalog")
}

// ─── Catalog Tools (what tools an integration offers) ───────

enum ToolCategory {
  READ
  WRITE
  DELETE
  ACTION
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model CatalogTool {
  id            String       @id @default(cuid())
  integrationId String       @map("integration_id")
  slug          String
  name          String
  description   String

  // NEW — complete tool contract for the LLM tool-surface.
  // `whenToUse` is human-written guidance that the prompt renders alongside
  // `description`. `exampleUsage` gives the LLM a worked example so it can
  // infer call shapes without relying only on description heuristics.
  whenToUse     String?      @map("when_to_use") @db.Text
  exampleUsage  Json?        @map("example_usage") // [{ input, output, note }]

  // Which execution modes this tool is valid in. Filtered at buildToolSurface time.
  // Default: both. Examples of AUTO-only: send_message, close_conversation.
  allowedModes  Json         @default("[\"AUTO\",\"ASSIST\"]") @map("allowed_modes")

  // HITL policy — this is the SEED for new tenants. The tenant override
  // (TenantTool.configOverrides.hitlPolicy or TenantToolPermission row) is
  // AUTHORITATIVE: it can both tighten and loosen this default. Per-agent
  // permissions only govern access (isAllowed), not HITL. Shape:
  //   { mode: "never" | "always" | "on_condition",
  //     condition?: string,       // CEL-lite predicate over args
  //     approverRole?: string,
  //     notifyChannels?: string[] }
  hitlPolicy    Json         @default("{\"mode\":\"never\"}") @map("hitl_policy")

  // Runtime limits honored by the tool executor.
  timeoutMs                Int  @default(10000) @map("timeout_ms")
  maxRetries               Int  @default(0)     @map("max_retries")
  retryBackoffMs           Int  @default(1000)  @map("retry_backoff_ms")
  circuitBreakerThreshold  Int? @map("circuit_breaker_threshold")

  // Schema version for the inputSchema — bumped when args shape changes;
  // forces prompt regeneration on agents referencing this tool.
  schemaVersion Int          @default(1) @map("schema_version")

  category      ToolCategory @default(READ)
  inputSchema   Json         @default("{}") @map("input_schema")
  outputSchema  Json         @default("{}") @map("output_schema")
  endpoint      String?
  method        String       @default("GET")
  isDefault     Boolean      @default(true) @map("is_default")
  riskLevel     RiskLevel    @default(LOW) @map("risk_level")
  sortOrder     Int          @default(0) @map("sort_order")
  createdAt     DateTime     @default(now()) @map("created_at")

  integration IntegrationCatalog @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tenantTools TenantTool[]

  @@unique([integrationId, slug])
  @@index([integrationId])
  @@map("catalog_tools")
}

// ─── Tenant Integration Connections ─────────────────────────

enum ConnectionStatus {
  PENDING
  TESTING
  CONNECTED
  ERROR
  DISCONNECTED
}

model TenantIntegration {
  id             String           @id @default(cuid())
  tenantId       String           @map("tenant_id")
  integrationId  String           @map("integration_id")
  status         ConnectionStatus @default(PENDING)
  credentials    Json             @default("{}")
  config         Json             @default("{}")
  connectedBy    String?          @map("connected_by")
  connectedAt    DateTime?        @map("connected_at")
  lastTestedAt   DateTime?        @map("last_tested_at")
  lastTestResult Boolean?         @map("last_test_result")
  lastError      String?          @map("last_error")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  integration IntegrationCatalog @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  tenantTools TenantTool[]

  @@unique([tenantId, integrationId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_integrations")
}

// ─── Tenant Tool Activation ─────────────────────────────────

model TenantTool {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  tenantIntegrationId String   @map("tenant_integration_id")
  catalogToolId       String   @map("catalog_tool_id")
  isEnabled           Boolean  @default(true) @map("is_enabled")
  configOverrides     Json     @default("{}") @map("config_overrides")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenantIntegration TenantIntegration     @relation(fields: [tenantIntegrationId], references: [id], onDelete: Cascade)
  catalogTool       CatalogTool           @relation(fields: [catalogToolId], references: [id], onDelete: Cascade)
  agentPermissions  AgentToolPermission[]
  executions        ToolExecution[]

  @@unique([tenantIntegrationId, catalogToolId])
  @@index([tenantId])
  @@index([tenantId, isEnabled])
  @@map("tenant_tools")
}

// ─── Tenant Tool Permission (iOS-style privacy toggle + HITL) ───
// Cross-cuts INTERNAL tools (static TOOL_REGISTRY entries) AND EXTERNAL
// integration tools (catalog). A single row per (tenantId, toolName)
// lets tenants:
//   - Disable individual tools entirely (enabled=false)
//   - Force HITL approval per tool (requiresApproval=true) — even when
//     the tool is normally low-risk
//   - Configure approver role + notification channels + expiry
//   - Allow the approver to modify params before running
// Used by the unified evaluatePolicies() entry point called from
// both the bot engine (autonomous actions) and action-executor
// (Command Center plans). Replaces the hardcoded HIGH_RISK_TOOLS list.
model TenantToolPermission {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  toolName          String   @map("tool_name") // "send_message" | "integration.hubspot.create_deal" | ...
  enabled           Boolean  @default(true)
  // HITL config — when true, actions using this tool pause and create
  // an ApprovalRequest; the bot conversation is held until a human
  // decides. See memory/bug_f4_approval_wrong_surface.md.
  requiresApproval  Boolean  @default(false) @map("requires_approval")
  approverRole      String?  @map("approver_role") // "supervisor" | "finance" | "admin" | null
  notifyChannels    Json     @default("[\"in_app\"]") @map("notify_channels") // ["in_app","email","slack"]
  expiresAfterMin   Int      @default(30) @map("expires_after_min")
  allowModification Boolean  @default(false) @map("allow_modification") // approver can edit params
  updatedBy         String?  @map("updated_by")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, toolName])
  @@index([tenantId])
  @@index([tenantId, enabled])
  @@map("tenant_tool_permissions")
}

// ─── Approval Requests (bot-initiated actions pending human OK) ─
// Created when an autonomous bot/flow hits a tool marked
// TenantToolPermission.requiresApproval=true (or flagged by a
// PolicyRule). The conversation is paused until a human resolves it.
//
// Key architectural note: this is NOT for Command Center approvals.
// Command Center actions are human-initiated by construction — the
// guardrails there are dry-run preview + confirmation modal, not a
// separate queue. ApprovalRequest is exclusively for the bot path.
//
// See memory/bug_f4_approval_wrong_surface.md for the full design.
model ApprovalRequest {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  // Nullable: System Copilot plans aren't conversation-scoped (e.g.
  // "build a workflow that fires after 2 days"). Customer-facing approvals
  // continue to fill this in.
  conversationId String?        @map("conversation_id")
  messageId      String?        @map("message_id") // the inbound that triggered the action
  contactId      String?        @map("contact_id")
  tool           String // "cancel_order" | "issue_refund" | "integration.hubspot.create_deal"
  params         Json // the full PlannedAction.params the bot wanted to run
  summary        String // one-sentence human-facing: "Cancel order #12345 and refund $89.50"
  reason         String // bot's own reasoning: "Customer requested cancellation within 24h window"
  policyRuleId   String?        @map("policy_rule_id") // which rule fired (nullable — could be simple HITL flag)
  policyRuleName String?        @map("policy_rule_name") // denormalized for display even if rule deleted
  riskLevel      String         @default("medium") @map("risk_level") // low | medium | high
  riskTags       Json           @default("[]") @map("risk_tags") // ["HIGH","IRREVERSIBLE","FINANCIAL"]
  status         ApprovalStatus @default(PENDING)
  requestedBy    String         @map("requested_by") // "bot" | "flow:<id>" | "ai-agent:<id>"
  decidedBy      String?        @map("decided_by")
  decidedAt      DateTime?      @map("decided_at")
  decisionReason String?        @map("decision_reason")
  modifiedParams Json?          @map("modified_params") // if approver edited before running
  expiresAt      DateTime       @map("expires_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@index([tenantId, conversationId])
  @@index([tenantId, contactId])
  @@index([expiresAt])
  @@map("approval_requests")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

// ─── Agent Tool Permissions ─────────────────────────────────

model AgentToolPermission {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  departmentId    String?  @map("department_id")
  agentId         String?  @map("agent_id") // human agent (User) ID
  aiAgentId       String?  @map("ai_agent_id") // AI agent ID
  tenantToolId    String   @map("tenant_tool_id")
  isAllowed       Boolean  @default(true) @map("is_allowed")
  requireApproval Boolean  @default(false) @map("require_approval")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenantTool TenantTool  @relation(fields: [tenantToolId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([tenantToolId, departmentId, agentId])
  @@index([tenantId])
  @@index([departmentId])
  @@index([agentId])
  @@index([aiAgentId])
  @@map("agent_tool_permissions")
}

// ─── Tool Executions (Audit Log) ────────────────────────────

model ToolExecution {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  tenantToolId   String   @map("tenant_tool_id")
  input          Json     @default("{}")
  output         Json     @default("{}")
  success        Boolean  @default(true)
  durationMs     Int?     @map("duration_ms")
  triggeredBy    String   @default("ai") @map("triggered_by")
  approvedBy     String?  @map("approved_by")
  createdAt      DateTime @default(now()) @map("created_at")

  tenantTool TenantTool @relation(fields: [tenantToolId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([conversationId])
  @@index([tenantToolId])
  @@index([tenantId, createdAt])
  @@map("tool_executions")
}

// ─── Conversation Intelligence ──────────────────────────────

model ConversationIntelligence {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  conversationId    String   @unique @map("conversation_id")
  summary           String?
  detectedIntent    String?  @map("detected_intent")
  intentConfidence  Float?   @map("intent_confidence")
  sentiment         String? // "positive" | "negative" | "neutral"
  sentimentScore    Float?   @map("sentiment_score") // -1.0 to 1.0
  topics            Json     @default("[]") // ["billing", "refund", ...]
  toolsUsed         Json     @default("[]") @map("tools_used") // [{ toolId, toolName, success }]
  resolutionOutcome String?  @map("resolution_outcome") // "resolved" | "escalated" | "abandoned"
  customerEffort    Int?     @map("customer_effort") // 1-5 score
  aiConfidence      Float?   @map("ai_confidence") // overall AI confidence in handling
  metadata          Json?
  analyzedAt        DateTime @default(now()) @map("analyzed_at")
  createdAt         DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, detectedIntent])
  @@index([tenantId, sentiment])
  @@index([tenantId, analyzedAt])
  @@map("conversation_intelligence")
}

// ─── Agent Scoring (Post-Conversation Review) ──────────────

model AgentScore {
  id             String @id @default(cuid())
  tenantId       String @map("tenant_id")
  conversationId String @map("conversation_id")
  agentId        String @map("agent_id")

  // Scores (1-5 scale)
  responseQuality   Int?   @map("response_quality") // Quality of agent responses
  responseSpeed     Int?   @map("response_speed") // How fast they responded
  resolutionScore   Int?   @map("resolution_score") // Did they resolve the issue?
  protocolAdherence Int?   @map("protocol_adherence") // Followed rules/escalation procedures?
  customerHandling  Int?   @map("customer_handling") // Empathy, professionalism
  overallScore      Float? @map("overall_score") // Weighted average (0-100)

  // AI analysis
  strengths    Json    @default("[]") // ["Quick response", "Used KB effectively"]
  improvements Json    @default("[]") // ["Could have escalated sooner"]
  summary      String? // AI-generated performance summary

  // Metadata
  copilotUsageRate Float? @map("copilot_usage_rate") // % of AI suggestions used
  toolsUsedCount   Int    @default(0) @map("tools_used_count")
  messageCount     Int    @default(0) @map("message_count")

  analyzedAt DateTime @default(now()) @map("analyzed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([conversationId, agentId])
  @@index([tenantId])
  @@index([agentId])
  @@index([tenantId, agentId])
  @@index([tenantId, analyzedAt])
  @@map("agent_scores")
}

// ─── Notification Log ───────────────────────────────────────

model NotificationLog {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  channel   String // email, slack, webhook, internal
  type      String // onboarding_email, activation_confirmation, etc.
  recipient String // email address or channel ID
  subject   String?
  body      String?
  status    String    @default("pending") // pending, sent, failed
  error     String?
  metadata  Json?
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([type, status])
  @@map("notification_logs")
}

// ─── Event-driven Notification System ───────────────────────
//
// NotificationPreference defines per-tenant (and optionally per-department)
// rules for which SystemEvents trigger notifications, who receives them,
// and through which channels. Postgres NULLS-DISTINCT semantics on the
// (tenantId, departmentId, eventType) tuple are enforced via two partial
// indexes — one for the NULL departmentId case (tenant default) and one
// for explicit department scope. Mirrors the trick used in the
// `tenant_funnels` table (see 20260507200000_funnel_per_department).

model NotificationPreference {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  /// NULL = tenant-default rule (applies when no department-scoped row exists).
  departmentId String?  @map("department_id")
  eventType    String   @map("event_type")
  enabled      Boolean  @default(true)
  /// CEL-lite — array of { field, op, value } objects.
  conditions   Json?
  /// { type: "tenant_owner" | "department_manager" | "users", userIds?: string[] }
  recipients   Json
  /// string[] — ["email", "in_app", ...]. Adding new channels (slack, sms) is purely
  /// a dispatcher switch; no schema migration needed.
  channels     Json     @default("[\"email\",\"in_app\"]")
  /// CRITICAL | HIGH | MEDIUM | LOW
  priority     String   @default("MEDIUM")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  // NOTE: The (tenantId, departmentId, eventType) uniqueness — including the
  // NULL-departmentId case — is enforced via two partial unique indexes
  // declared in the migration SQL (Postgres-14 safe). Prisma's schema-level
  // @@unique can't express the partial-index condition, so it's omitted here
  // intentionally — the DB still rejects duplicates at write-time.
  @@index([tenantId, eventType])
  @@map("notification_preferences")
}

// In-app notification record. One row per user-bound notification surfaced
// in the dashboard's bell/inbox. Created by the dispatcher when "in_app"
// is on the preference's channels. Real-time delivery happens via the
// shared event-bus (publishEvent → frontend SSE/poll). The frontend can
// also fall back to polling the GET /notifications endpoint.
model InAppNotification {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  eventType String   @map("event_type")
  priority  String   @default("MEDIUM")
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([tenantId, createdAt])
  @@map("in_app_notifications")
}

// ─── Contacts (Customer Directory) ─────────────────────────

model Contact {
  id                String      @id @default(cuid())
  tenantId          String      @map("tenant_id")
  externalId        String      @map("external_id") // phone, email, PSID, etc.
  channel           ChannelType
  displayName       String?     @map("display_name")
  email             String?
  emailVerified     Boolean     @default(false) @map("email_verified")
  phone             String?
  phoneVerified     Boolean     @default(false) @map("phone_verified")
  avatarUrl         String?     @map("avatar_url")
  metadata          Json? // custom fields
  tags              Json        @default("[]") // string[] for segmentation
  lastSeenAt        DateTime?   @map("last_seen_at")
  lastInteractionAt DateTime?   @map("last_interaction_at")
  source            String? // campaign/channel source
  optOutChannels    Json        @default("[]") @map("opt_out_channels") // string[] of opted-out channel types
  optedOutAt        DateTime?   @map("opted_out_at")
  // Cross-channel identity: multiple contact rows sharing the same personId
  // represent one real human across WA/IG/Gmail/Messenger/etc. Assigned by
  // the unifier when a shared identifier is discovered (email/phone match
  // or explicit capture via /api/identity/capture).
  personId          String?     @map("person_id")
  // Soft-merge pointer: when set, this row has been merged into mergedIntoId.
  // The row is kept (not deleted) so incoming webhook lookups by
  // (tenantId, channel, externalId) still resolve — `resolveContactByChannelId`
  // follows the pointer to the surviving target. Replaces the old
  // hard-delete path that created "ghost" contacts after merges.
  mergedIntoId      String?     @map("merged_into_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  broadcastRecipients BroadcastRecipient[]

  @@unique([tenantId, channel, externalId])
  @@index([tenantId])
  @@index([tenantId, displayName])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, lastInteractionAt])
  @@index([tenantId, personId])
  @@index([mergedIntoId])
  @@map("contacts")
}

// ─── Identity Link Suggestions ─────────────────────────────
// AI-proposed or system-proposed links between contacts. A suggestion is
// created when an identifier (email/phone) extracted from one contact is
// already attached to a different contact in the same tenant. Merging is
// a separate, explicit, approval-gated operation — this table is the
// pending queue feeding that decision. Never auto-merged on insert.

enum IdentityLinkStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

enum IdentityLinkIdentifierType {
  EMAIL
  PHONE
}

model IdentityLinkSuggestion {
  id              String                     @id @default(cuid())
  tenantId        String                     @map("tenant_id")
  sourceContactId String                     @map("source_contact_id")
  targetContactId String                     @map("target_contact_id")
  identifierType  IdentityLinkIdentifierType @map("identifier_type")
  identifierValue String                     @map("identifier_value")
  confidence      Float                      @default(0)
  status          IdentityLinkStatus         @default(PENDING)
  reason          String?
  messageId       String?                    @map("message_id")
  createdAt       DateTime                   @default(now()) @map("created_at")
  decidedAt       DateTime?                  @map("decided_at")
  decidedBy       String?                    @map("decided_by")

  @@unique([tenantId, sourceContactId, targetContactId, identifierType, identifierValue], map: "identity_link_unique")
  @@index([tenantId, status])
  @@index([tenantId, targetContactId])
  @@map("identity_link_suggestions")
}

// ─── Message Templates ─────────────────────────────────────

enum TemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model MessageTemplate {
  id               String         @id @default(cuid())
  tenantId         String         @map("tenant_id")
  name             String
  category         String         @default("general") // marketing, utility, authentication, general
  language         String         @default("en")
  channel          ChannelType? // null = all channels
  channelAccountId String?        @map("channel_account_id") // bind template to a specific connected account (e.g. specific WABA)
  headerType       String?        @map("header_type") // text, image, video, document
  headerContent    String?        @map("header_content")
  body             String // template body with {{1}} placeholders
  footer           String?
  buttons          Json           @default("[]") // [{ type: "QUICK_REPLY"|"URL"|"PHONE", text, url?, phoneNumber? }]
  variables        Json           @default("[]") // [{ key: "1", sample: "John" }]
  externalId       String?        @map("external_id") // WhatsApp template ID after sync
  metaTemplateId   String?        @map("meta_template_id") // Meta's internal template ID
  rejectionReason  String?        @map("rejection_reason") // reason if rejected by Meta
  status           TemplateStatus @default(DRAFT)
  version          Int            @default(1)
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  broadcasts     Broadcast[]

  @@unique([tenantId, name, language, channel])
  @@index([tenantId])
  @@index([tenantId, channel, status])
  @@index([tenantId, channelAccountId])
  @@map("message_templates")
}

// ─── Broadcasts ────────────────────────────────────────────

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Broadcast {
  id               String          @id @default(cuid())
  tenantId         String          @map("tenant_id")
  name             String
  channel          ChannelType
  channelAccountId String          @map("channel_account_id")
  templateId       String?         @map("template_id")
  body             String? // for non-template messages
  variables        Json            @default("{}") // template variable values
  flowId           String?         @map("flow_id") // trigger flow for each recipient
  status           BroadcastStatus @default(DRAFT)
  scheduledAt      DateTime?       @map("scheduled_at")
  startedAt        DateTime?       @map("started_at")
  completedAt      DateTime?       @map("completed_at")
  createdBy        String          @map("created_by")

  // Analytics counters
  totalRecipients Int @default(0) @map("total_recipients")
  sentCount       Int @default(0) @map("sent_count")
  deliveredCount  Int @default(0) @map("delivered_count")
  readCount       Int @default(0) @map("read_count")
  repliedCount    Int @default(0) @map("replied_count")
  failedCount     Int @default(0) @map("failed_count")

  // Last error message when broadcast halted (channel API failure, billing issue, etc.)
  lastError String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   MessageTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients BroadcastRecipient[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([scheduledAt])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String    @map("broadcast_id")
  contactId   String?   @map("contact_id")
  externalId  String    @map("external_id") // phone/PSID/email
  messageId   String?   @map("message_id") // outgoing message ID after send
  status      String    @default("pending") // pending, sent, delivered, read, replied, failed
  error       String?
  sentAt      DateTime? @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")
  repliedAt   DateTime? @map("replied_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([broadcastId])
  @@index([broadcastId, status])
  @@index([contactId])
  @@map("broadcast_recipients")
}

// ─── Scheduled Messages ────────────────────────────────────

enum ScheduledMessageStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model ScheduledMessage {
  id                  String                 @id @default(cuid())
  tenantId            String                 @map("tenant_id")
  conversationId      String?                @map("conversation_id")
  channel             ChannelType
  channelAccountId    String                 @map("channel_account_id")
  recipientExternalId String                 @map("recipient_external_id")
  body                String
  messageType         String                 @default("text") @map("message_type")
  mediaUrl            String?                @map("media_url")
  templateId          String?                @map("template_id")
  variables           Json                   @default("{}")
  sendType            String                 @default("regular") @map("send_type") // regular, conversation, flow
  departmentId        String?                @map("department_id")
  flowId              String?                @map("flow_id")
  scheduledAt         DateTime               @map("scheduled_at")
  status              ScheduledMessageStatus @default(PENDING)
  sentAt              DateTime?              @map("sent_at")
  error               String?
  createdBy           String                 @map("created_by")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status, scheduledAt])
  @@index([tenantId, status])
  @@map("scheduled_messages")
}

// ─── Usage Logs (Centralized Usage Tracking) ───────────────

model UsageLog {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  type             String // "ai_tokens" | "message_sent" | "tool_call" | "automation_run"
  quantity         Int
  tokensEquivalent Int      @map("tokens_equivalent")
  // AI-specific denormalized columns — populated when type="ai_tokens" so the
  // Platform Usage admin view can aggregate by model/feature and price the
  // prompt/completion split accurately without hitting the metadata JSON.
  feature          String? // "chat" | "suggestion" | "summary" | "classification" | "embedding" | "action_plan" | "intent_classify" | "onboarding" | "followup" | "ai_bot" | "knowledge_retrieval"
  model            String?
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  costUsd          Decimal? @map("cost_usd") @db.Decimal(12, 6)
  metadata         Json? // { channel, tool, conversationId, messageId, ... }
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([tenantId, feature])
  @@index([tenantId, model])
  @@map("usage_logs")
}

// ─── Credit Transactions (Usage → Credits) ─────────────────

model CreditTransaction {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  amount      Int // credits consumed (positive = consumed, negative = added)
  source      String // usage type that generated this: "ai_tokens", "message_sent", etc.
  referenceId String?  @map("reference_id") // optional link to usage_log or other entity
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, source])
  @@index([tenantId, createdAt])
  @@map("credit_transactions")
}

// ─── Audit Logs (Full System Audit Trail) ──────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  actorType  String   @map("actor_type") // "user" | "ai" | "system"
  actorId    String?  @map("actor_id") // userId or aiAgentId or null for system
  action     String // "message.sent", "ai.responded", "tool.executed", "conversation.updated", etc.
  targetType String?  @map("target_type") // "conversation", "message", "tool", "user", etc.
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, action])
  @@index([tenantId, actorType])
  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ─── Flow Canvas (Visual Routing) ──────────────────────────

model FlowCanvas {
  id        String   @id @default(cuid())
  tenantId  String   @unique @map("tenant_id")
  nodes     Json     @default("[]") // [{ id, type: "channel"|"rule"|"flow"|"agent"|"department", position, data }]
  edges     Json     @default("[]") // [{ id, source, target, data }]
  viewport  Json? // { x, y, zoom }
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("flow_canvas")
}

// ─── Business Policy (Per-tenant AI execution policy) ─────
// Persistent source of truth for the AI service's policy engine. Read
// by services/ai/src/services/policy.service.ts on every executeAction.
// Written via the same service's setPolicy(). In-process caching may
// wrap reads but MUST NOT override the DB value.
model BusinessPolicy {
  tenantId  String   @id @map("tenant_id")
  data      Json     @default("{}") // BusinessPolicy shape (maxDiscountPercent, refundRequiresApproval, escalationKeywords, blockedTopics, outboundQuietHours)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("business_policies")
}

// ─── System Agent Memory ────────────────────────────────────
// Per-user, per-tenant rolling history for the System Copilot (Command
// Center). Isolated from customer Conversation/Message tables so operator
// threads don't leak into customer-facing queries, audit, or realtime
// publishers. Trimmed to a rolling window by agent-runtime.service.
model SystemAgentMessage {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  sessionId   String   @map("session_id")
  role        String   // "user" | "assistant" | "tool"
  content     String   @db.Text
  toolCalls   Json?    @map("tool_calls")
  toolCallId  String?  @map("tool_call_id")
  toolName    String?  @map("tool_name")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt])
  @@map("system_agent_messages")
}

// ─── Calendar Accounts (Task 3 — schedule_meeting) ───────────
//
// One row per (tenant × AI agent × calendar provider) connection. Stores
// OAuth credentials encrypted at rest using `encryptCredentials` from
// @chatcenter/shared. Token refresh on 401 is the adapter's responsibility;
// when refresh fails permanently, status flips to BROKEN and the schedule
// tool surface drops `schedule_meeting` until a human reconnects.
//
// Provider semantics:
//   - "google_calendar": full OAuth, freebusy + events.insert
//   - "calendly":         OAuth or PAT; can return scheduling links OR
//                         use the Calendly API for slot listings
enum CalendarProvider {
  GOOGLE_CALENDAR
  CALENDLY
}

enum CalendarAccountStatus {
  CONNECTED
  BROKEN
  DISCONNECTED
}

model CalendarAccount {
  id                  String                @id @default(cuid())
  tenantId            String                @map("tenant_id")
  /// The AIAgent that owns this calendar binding.
  aiAgentId           String                @map("ai_agent_id")
  provider            CalendarProvider
  /// Encrypted JSON: { accessToken, refreshToken, scope, idToken? }
  credentials         String                @db.Text
  /// Provider's primary calendar id (Google) or user URI (Calendly).
  externalAccountId   String                @map("external_account_id")
  /// Optional explicit calendar to write to (Google secondary calendars).
  defaultCalendarId   String?               @map("default_calendar_id")
  /// Provider account email — for display + audit.
  accountEmail        String?               @map("account_email")
  /// When access token expires; adapter refreshes 60s before.
  tokenExpiresAt      DateTime?             @map("token_expires_at")
  status              CalendarAccountStatus @default(CONNECTED)
  lastError           String?               @map("last_error")
  lastSyncedAt        DateTime?             @map("last_synced_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@unique([aiAgentId, provider])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("calendar_accounts")
}

// ─── Meeting Types (Task 3 — scheduling policy per meeting kind) ─
//
// One row per tenant-defined meeting kind ("discovery_call", "demo",
// "consultation", ...). Hydrates `SchedulingPolicy` for the constraints
// resolver. Working-hours / windows are stored as JSON arrays of
// `{ weekday, start, end }` matching the resolver's `DayWindow` shape.
model MeetingType {
  id                       String   @id @default(cuid())
  tenantId                 String   @map("tenant_id")
  /// Used by the schedule_meeting tool's meeting_type arg. Unique per tenant.
  slug                     String
  name                     String
  description              String?
  durationMinutes          Int      @map("duration_minutes")
  /// IANA timezone for working hours (e.g. "Asia/Jerusalem").
  agentTimezone            String   @map("agent_timezone")
  /// [{ weekday: 0..6, start: "HH:MM", end: "HH:MM" }]
  workingHours             Json     @map("working_hours")
  /// Optional stricter window override for this meeting type. Same shape.
  meetingTypeWindows       Json?    @map("meeting_type_windows")
  bufferBeforeMinutes      Int      @default(15) @map("buffer_before_minutes")
  bufferAfterMinutes       Int      @default(15) @map("buffer_after_minutes")
  minNoticeHours           Int      @default(4)  @map("min_notice_hours")
  maxHorizonDays           Int      @default(30) @map("max_horizon_days")
  slotResolutionMinutes    Int      @default(30) @map("slot_resolution_minutes")
  /// Emails that should ALWAYS be added as attendees (account manager, SE,
  /// internal ops). Merged with the customer's email + additional_guests
  /// the bot collected. Stored as a JSON array of strings.
  autoGuests               Json     @default("[]") @map("auto_guests")
  /// When false, schedule_meeting will reject this slug.
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("meeting_types")
}

// ─── Tenant Funnel (Task 2 — configurable funnel + playbooks) ─
//
// Tenant-shaped overlay on top of the platform's closed BEL primitives.
// One row per (tenantId × departmentId × funnelId). NULL departmentId means
// "tenant default" — applies to all departments that have no explicit funnel.
// The BEL loads ONE active funnel per (tenantId × departmentId), preferring
// a department-scoped row and falling back to the tenant-default (NULL) row.
model TenantFunnel {
  id                 String      @id @default(cuid())
  tenantId           String      @map("tenant_id")
  funnelId           String      @map("funnel_id")
  /// NULL = tenant default (applies when no department-specific funnel exists).
  departmentId       String?     @map("department_id")
  isActive           Boolean     @default(true) @map("is_active")
  /// FunnelStage[] — see funnel-config.service.ts.
  stages             Json
  /// FunnelTransition[]
  transitions        Json        @default("[]")
  /// StrategyOverride[] — optional.
  strategyOverrides  Json?       @map("strategy_overrides")
  /// PlaybookOverride[] — optional.
  playbookOverrides  Json?       @map("playbook_overrides")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  department         Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, departmentId, funnelId])
  @@index([tenantId, departmentId, isActive])
  @@map("tenant_funnels")
}

// ─── Action Contracts (deterministic tool-chain enforcement) ───
//
// Tenant-defined business rules of the form: "when trigger X fires, call
// these tools — no skipping, optionally in this order, optionally blocking
// the entire conversation until completion."
//
// Enforcement happens at the BEL: matching contracts inject their tool
// requirements into BehaviorState.requiredActions and (when blocking=true)
// strip everything else from allowedActions. The dispatcher tracks
// completion across turns so partial progress survives multi-turn flows.
//
// executionMode:
//   "ALL_REQUIRED" — all tools must execute this conversation, any order
//   "SEQUENCE"     — tools must execute in the listed order; out-of-order
//                    calls fail validation
//   "AT_LEAST_ONE" — any single tool from requiredTools satisfies the contract
model ActionContract {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  /// Business trigger label — matched against deriveTriggeredActions()
  /// output. Standard values: "refund", "booking", "close_conversation",
  /// "follow_up". Custom strings allowed for tenant-specific events.
  trigger       String
  /// JSON array of { name: string } — the tool function names that must
  /// execute. The dispatcher matches by name against the actual tool calls.
  requiredTools Json     @map("required_tools")
  /// "ALL_REQUIRED" | "SEQUENCE" | "AT_LEAST_ONE"
  executionMode String   @map("execution_mode")
  /// Optional ordered tool-name array used when executionMode = SEQUENCE.
  /// When omitted, falls back to the order of `requiredTools`.
  order         Json?
  /// When true, the bot CANNOT reply until the contract is fulfilled.
  /// allowedActions is restricted to only the contract's tools.
  blocking      Boolean  @default(true)
  /// When false, the contract is dormant — kept for audit but not enforced.
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, trigger])
  @@index([tenantId, isActive])
  @@map("action_contracts")
}

// ─── Action Contract Progress (partial completion across turns) ────
//
// One row per (conversationId × contractId). Tracks which required tools
// have already been called so the contract can complete across multiple
// turns. Cleared when the contract is fully satisfied (or the conversation
// is closed without completion — either way, audit trail lives in
// ai.bot_turn logs).
model ActionContractProgress {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  conversationId  String    @map("conversation_id")
  contractId      String    @map("contract_id")
  /// JSON array of tool names already executed (in execution order).
  completedTools  Json      @default("[]") @map("completed_tools")
  /// Index of the next required tool when executionMode = SEQUENCE.
  nextStepIndex   Int       @default(0) @map("next_step_index")
  /// Set when a tool returned awaiting_approval — contract is paused.
  pausedReason    String?   @map("paused_reason")
  /// Set on completion. When non-null, the row is essentially historical.
  fulfilledAt     DateTime? @map("fulfilled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([conversationId, contractId])
  @@index([tenantId, conversationId])
  @@map("action_contract_progress")
}

// ─── Custom API Tools (tenant-defined HTTP calls as bot tools) ───
//
// The escape hatch: anything we don't ship a first-class adapter for, the
// tenant can wire as a tool by defining a single HTTP request. The
// dispatcher renders the request, calls fetch, parses the response, and
// returns a result the LLM can read.
//
// Auth modes (auth.kind):
//   "none"
//   "bearer"   — Authorization: Bearer <token>   (token in encrypted creds)
//   "api_key"  — header or query param with the configured key name
//   "basic"    — Basic auth user:pass
//
// `parameters` is the OpenAI function-calling schema the LLM sees.
// `urlTemplate` and `bodyTemplate` may contain `{{name}}` placeholders
// resolved from args + a small helper namespace (e.g. {{tenantId}}).
//
// Domain whitelist enforcement happens at dispatch time — the request URL
// must resolve to a host in `allowedHosts` for the tool to fire. This is
// the OWASP-style guardrail against SSRF + accidental exfiltration.
model CustomApiTool {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  /// Tool slug surfaced as `custom.<slug>`. Unique per tenant.
  slug                String
  name                String
  description         String
  /// "Use this tool when …"
  whenToUse           String   @map("when_to_use")
  /// "Do NOT call this tool when …"
  whenNotToUse        String?  @map("when_not_to_use")
  /// "GET" | "POST" | "PUT" | "PATCH" | "DELETE"
  method              String
  /// e.g. "https://api.example.com/v1/orders/{{order_id}}"
  urlTemplate         String   @map("url_template")
  /// Static headers (in addition to auth).
  headers             Json     @default("{}")
  /// Auth descriptor (encrypted via the integration credential helper).
  /// Shape:
  ///   { kind: "none" } |
  ///   { kind: "bearer", tokenEnv?: string }   ← token stored in `secrets.bearer`
  ///   { kind: "api_key", in: "header"|"query", name: "X-API-Key" } ← key in `secrets.apiKey`
  ///   { kind: "basic" } ← user/pass in secrets.basicUser/basicPass
  auth                Json     @default("{\"kind\":\"none\"}")
  /// Encrypted credential blob (bearer token, api key, basic user/pass).
  secrets             String?  @db.Text
  /// Parameter schema in OpenAI function-calling shape.
  /// { type:"object", properties:{...}, required:[...] }
  parameters          Json     @default("{\"type\":\"object\",\"properties\":{},\"required\":[]}")
  /// Body template — string with {{placeholders}} or null for no body.
  bodyTemplate        String?  @map("body_template") @db.Text
  /// Optional response mapping — JSONPath-like dotted paths summarized for the LLM.
  /// e.g. ["data.id", "data.amount"] — adapter returns just these fields when set.
  responseFields      Json?    @map("response_fields")
  /// Domain whitelist — exact host match enforced at dispatch.
  allowedHosts        Json     @default("[]") @map("allowed_hosts")
  /// "READ" | "WRITE" | "DELETE" | "ACTION" — drives permission filtering.
  category            String   @default("READ")
  /// "LOW" | "MEDIUM" | "HIGH" — HIGH-risk auto-requires approval.
  riskLevel           String   @default("MEDIUM") @map("risk_level")
  /// Soft-disable without deleting.
  isActive            Boolean  @default(true) @map("is_active")
  /// Timeout in ms (default 10s).
  timeoutMs           Int      @default(10000) @map("timeout_ms")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("custom_api_tools")
}

// ─── Custom DB Query Tools ──────────────────────────────────
//
// Per-tenant pre-canned SQL/Mongo queries the AI can call as
// `custom_db.<slug>`. Safer than generic `postgres.query_table` because the
// admin defines the exact shape — the AI only fills in named params that match
// `parameterSchema`. No raw SQL is ever assembled at runtime: the template is
// passed verbatim to the driver with `$1, $2…` (Postgres) / positional `?`
// (MySQL) / typed Mongo filter (MongoDB).
model CustomDbQueryTool {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  /// One of: "postgresql" | "aws_rds" | "mongodb" — must match a CONNECTED
  /// integration on this tenant.
  providerSlug    String   @map("provider_slug")
  /// Tool slug surfaced as `custom_db.<slug>`. Unique per tenant.
  slug            String
  name            String
  description     String
  whenToUse       String   @map("when_to_use")
  whenNotToUse    String?  @map("when_not_to_use") @db.Text
  /// The query body. For Postgres/MySQL: SQL with `$1, $2…` (or `?` MySQL)
  /// placeholders. For MongoDB: a JSON object — `collection`, `op`
  /// ("find"|"findOne"|"insertOne"|"updateOne"|"deleteOne"), `filter`,
  /// `update`, `doc` — fields can be `{{paramName}}` for substitution.
  queryTemplate   String   @map("query_template") @db.Text
  /// Parameter schema in OpenAI function-calling shape — describes the
  /// args the AI must fill. Order matters for SQL `$1, $2…`.
  parameterSchema Json     @default("{\"type\":\"object\",\"properties\":{},\"required\":[]}") @map("parameter_schema")
  /// Param order — array of property names matching the SQL placeholders'
  /// numeric order. e.g. ["customer_email", "since"] → $1=email, $2=since.
  parameterOrder  Json     @default("[]") @map("parameter_order")
  /// "READ" | "WRITE" | "DELETE" | "ACTION".
  category        String   @default("READ")
  riskLevel       String   @default("LOW") @map("risk_level")
  isActive        Boolean  @default(true) @map("is_active")
  /// Hard cap on rows returned (Postgres/RDS) or docs returned (Mongo).
  maxRows         Int      @default(100) @map("max_rows")
  /// Statement timeout in ms (default 5s).
  timeoutMs       Int      @default(5000) @map("timeout_ms")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@index([tenantId, providerSlug])
  @@map("custom_db_query_tools")
}
