# Dev image for the marketing site. Mirrors frontend/Dockerfile.dev: source is
# bind-mounted and `next dev` reads NEXT_PUBLIC_* at runtime, so changing a
# domain does not need a rebuild.
FROM node:20-alpine

WORKDIR /app

# Only the manifests first, so a source edit does not reinstall dependencies.
COPY package.json package-lock.json* ./
RUN npm install

COPY . .

EXPOSE 3100
CMD ["npm", "run", "dev"]
